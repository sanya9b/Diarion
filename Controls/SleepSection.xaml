<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vms="clr-namespace:Diarion.ViewModels;assembly=Diarion.Core"
             xmlns:localization="clr-namespace:Diarion.Resources.Localization;assembly=Diarion.Core"
             xmlns:controls="clr-namespace:Diarion.Controls"
             x:Class="Diarion.Controls.SleepSection"
             x:DataType="vms:DiaryEntryViewModel">
    
    <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="10">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="{x:Static localization:AppResources.SleepLabel}" Style="{StaticResource SectionHeader}" VerticalOptions="Center" />
                
                <HorizontalStackLayout Grid.Column="1" Spacing="12">
                    <Label Text="{Binding SleepDurationText}" FontAttributes="Bold" FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
            
            <Grid ColumnDefinitions="Auto, *, Auto, *" ColumnSpacing="8" VerticalOptions="Center">
                <Label Grid.Column="0" Text="{x:Static localization:AppResources.SleepStartLabel}" FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" VerticalOptions="Center" />
                
                <Grid Grid.Column="1" HeightRequest="28" VerticalOptions="Center">
                    <Border Style="{StaticResource Field}" Padding="8,0">
                        <Grid ColumnDefinitions="Auto, *">
                            <Path Grid.Column="0" Data="M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 1 0 12 2 M 12 6 V 12 L 16 16" Stroke="{DynamicResource Theme_Ocean_Dust}" StrokeThickness="1.5" StrokeLineCap="Round" StrokeLineJoin="Round" WidthRequest="14" HeightRequest="14" Aspect="Uniform" VerticalOptions="Center" Margin="0,0,6,0" />
                            <Grid Grid.Column="1">
                                <Label Text="{Binding SleepStart, StringFormat='{0:hh\\:mm}'}" 
                                       IsVisible="{Binding HasSleepStart}"
                                       TextColor="{DynamicResource Theme_Midnight_Snow}" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Label Text="--:--" 
                                       IsVisible="{Binding IsSleepStartEmpty}"
                                       TextColor="{DynamicResource Theme_Ocean_Dust}" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                    <TimePicker Time="{Binding SleepStartTime}" Format="HH:mm" TextColor="Transparent" BackgroundColor="Transparent" />
                </Grid>
                
                <Label Grid.Column="2" Text="{x:Static localization:AppResources.SleepEndLabel}" FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" VerticalOptions="Center" Margin="4,0,0,0" />
                
                <Grid Grid.Column="3" HeightRequest="28" VerticalOptions="Center">
                    <Border Style="{StaticResource Field}" Padding="8,0">
                        <Grid ColumnDefinitions="Auto, *">
                            <Path Grid.Column="0" Data="M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 1 0 12 2 M 12 6 V 12 L 16 16" Stroke="{DynamicResource Theme_Ocean_Dust}" StrokeThickness="1.5" StrokeLineCap="Round" StrokeLineJoin="Round" WidthRequest="14" HeightRequest="14" Aspect="Uniform" VerticalOptions="Center" Margin="0,0,6,0" />
                            <Grid Grid.Column="1">
                                <Label Text="{Binding SleepEnd, StringFormat='{0:hh\\:mm}'}" 
                                       IsVisible="{Binding HasSleepEnd}"
                                       TextColor="{DynamicResource Theme_Midnight_Snow}" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Label Text="--:--" 
                                       IsVisible="{Binding IsSleepEndEmpty}"
                                       TextColor="{DynamicResource Theme_Ocean_Dust}" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                    <TimePicker Time="{Binding SleepEndTime}" Format="HH:mm" TextColor="Transparent" BackgroundColor="Transparent" />
                </Grid>
            </Grid>

            <Grid ColumnDefinitions="100, *" ColumnSpacing="12">
                <Label Grid.Column="0" Text="{x:Static localization:AppResources.SleepQualityLabel}" VerticalOptions="Center" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                <controls:RatingView Grid.Column="1" Value="{Binding SleepQuality}" MaxValue="5" VerticalOptions="Center" HorizontalOptions="Start" />
            </Grid>

            <!-- Text Field for Notes -->
            <Border Style="{StaticResource Field}" MinimumHeightRequest="36" Padding="12,4" Margin="0,2,0,0">
                <Editor Text="{Binding SleepNotes}" Placeholder="{x:Static localization:AppResources.NotePlaceholder}" BackgroundColor="Transparent" TextColor="{DynamicResource Theme_Midnight_Snow}" PlaceholderColor="{DynamicResource Theme_Ocean_Dust}" FontSize="12" VerticalOptions="Center" AutoSize="TextChanges" MinimumHeightRequest="0" />
            </Border>
        </VerticalStackLayout>
    </Border>
</ContentView>