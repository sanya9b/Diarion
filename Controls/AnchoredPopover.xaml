<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Diarion.Controls.AnchoredPopover"
             IsVisible="False">

    <ContentView.Resources>
        <!-- The tail: a filled triangle laid over the bubble's edge, stroked on its two free sides only. -->
        <Style x:Key="TailFill" TargetType="Path">
            <Setter Property="Fill" Value="{DynamicResource Theme_Snow_Black}" />
        </Style>
        <Style x:Key="TailEdge" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource Theme_Dust_Ocean}" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
    </ContentView.Resources>

    <!-- This layer spans the page. The scrim is see-through and only exists to catch the tap that puts
         the bubble away; the bubble itself is placed from code-behind under (or above) the anchor. -->
    <Grid>
        <Grid x:Name="Scrim" BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnScrimTapped" />
            </Grid.GestureRecognizers>
        </Grid>

        <Grid x:Name="Bubble" RowDefinitions="Auto,Auto,Auto" HorizontalOptions="Fill" VerticalOptions="Start"
              Margin="24,0" AnchorY="0">
            <!-- Tail above the bubble (bubble below the anchor). -->
            <Grid x:Name="TailTopRow" Grid.Row="0" HeightRequest="10" ZIndex="1">
                <Grid x:Name="TailTop" HorizontalOptions="Start" VerticalOptions="End" WidthRequest="18" HeightRequest="11" TranslationY="2">
                    <Path Style="{StaticResource TailFill}" Data="M0,11 L9,1 L18,11 Z" />
                    <Path Style="{StaticResource TailEdge}" Data="M0,11 L9,1 L18,11" />
                </Grid>
            </Grid>

            <Border x:Name="Card" Grid.Row="1" StrokeShape="RoundRectangle 16" StrokeThickness="1"
                    Stroke="{DynamicResource Theme_Dust_Ocean}"
                    BackgroundColor="{DynamicResource Theme_Snow_Black}"
                    Padding="12">
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="14" Opacity="0.18" />
                </Border.Shadow>
            </Border>

            <!-- Tail below the bubble (bubble above the anchor, when there is no room below). -->
            <Grid x:Name="TailBottomRow" Grid.Row="2" HeightRequest="10" ZIndex="1" IsVisible="False">
                <Grid x:Name="TailBottom" HorizontalOptions="Start" VerticalOptions="Start" WidthRequest="18" HeightRequest="11" TranslationY="-2">
                    <Path Style="{StaticResource TailFill}" Data="M0,0 L9,10 L18,0 Z" />
                    <Path Style="{StaticResource TailEdge}" Data="M0,0 L9,10 L18,0" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentView>
