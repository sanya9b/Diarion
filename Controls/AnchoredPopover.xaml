<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Diarion.Controls"
             x:Class="Diarion.Controls.AnchoredPopover"
             IsVisible="False"
             InputTransparent="True"
             CascadeInputTransparent="False">

    <!-- This layer spans the page. The scrim is see-through and only exists to catch the tap that folds
         the panel back. The panel is one shape with the button (BubbleSurface): a bump around the button
         flowing into the body through smooth fillets, the body growing out of the bump. A copy of the
         button (HeaderSlot) sits exactly over the real one, so the button never moves. Everything is
         placed from code-behind in this layer's coordinates. The layer itself takes no taps: a layout
         catches every tap inside its bounds unless it is input-transparent, and this one spans the
         page — it would swallow the hole below. Only the pieces inside answer. -->
    <Grid InputTransparent="True" CascadeInputTransparent="False">
        <!-- The scrim in four pieces around an optional hole (PassThroughResolver): the mood row stays
             live under it, so another face can be chosen while the panel is out, in one tap. -->
        <Grid x:Name="ScrimTop" BackgroundColor="Transparent" HorizontalOptions="Start" VerticalOptions="Start">
            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnScrimTapped" /></Grid.GestureRecognizers>
        </Grid>
        <Grid x:Name="ScrimBottom" BackgroundColor="Transparent" HorizontalOptions="Start" VerticalOptions="Start">
            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnScrimTapped" /></Grid.GestureRecognizers>
        </Grid>
        <Grid x:Name="ScrimLeft" BackgroundColor="Transparent" HorizontalOptions="Start" VerticalOptions="Start">
            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnScrimTapped" /></Grid.GestureRecognizers>
        </Grid>
        <Grid x:Name="ScrimRight" BackgroundColor="Transparent" HorizontalOptions="Start" VerticalOptions="Start">
            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnScrimTapped" /></Grid.GestureRecognizers>
        </Grid>

        <controls:BubbleSurface x:Name="Surface" Opacity="0"
                                SurfaceColor="{DynamicResource Theme_Snow_Black}"
                                StrokeColor="{DynamicResource Theme_Dust_Ocean}"
                                ShadowColor="{DynamicResource Theme_Shadow}" />

        <!-- Keeps a tap on the body's own padding from falling through to the scrim and folding it. -->
        <BoxView x:Name="BodyHit" Color="Transparent" HorizontalOptions="Start" VerticalOptions="Start">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- The copy of the button, over the button. Tapping it folds the panel back, like tapping the
             button again. -->
        <ContentView x:Name="HeaderSlot" HorizontalOptions="Start" VerticalOptions="Start">
            <ContentView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnHeaderTapped" />
            </ContentView.GestureRecognizers>
        </ContentView>

        <!-- At its final place from the first frame; fades in once the body has grown round it. -->
        <ContentView x:Name="Body" HorizontalOptions="Start" VerticalOptions="Start" Opacity="0" />
    </Grid>
</ContentView>
