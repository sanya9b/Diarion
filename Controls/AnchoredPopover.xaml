<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Diarion.Controls.AnchoredPopover"
             IsVisible="False">

    <!-- This layer spans the page. The scrim is see-through and only exists to catch the tap that puts
         the bubble away; the bubble itself is placed and grown from code-behind. No tail: the bubble
         comes out of the control it belongs to, so where it came from is shown by the motion itself. -->
    <Grid>
        <Grid x:Name="Scrim" BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnScrimTapped" />
            </Grid.GestureRecognizers>
        </Grid>

        <!-- Scales from its top-left corner (AnchorX/Y 0): the morph maps that corner and the size onto
             the control's rectangle, so the card can start exactly where the control is. -->
        <Border x:Name="Bubble" HorizontalOptions="Fill" VerticalOptions="Start" Margin="24,0"
                AnchorX="0" AnchorY="0"
                StrokeShape="RoundRectangle 18" StrokeThickness="1"
                Stroke="{DynamicResource Theme_Dust_Ocean}"
                BackgroundColor="{DynamicResource Theme_Snow_Black}"
                Padding="14">
            <Border.Shadow>
                <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="16" Opacity="0.2" />
            </Border.Shadow>

            <!-- The content fades on its own clock: while the card is still the size of the control,
                 squeezed text would read as a glitch, so it arrives once the card has room for it. -->
            <ContentView x:Name="Body" />
        </Border>
    </Grid>
</ContentView>
