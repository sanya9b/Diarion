<?xml version="1.0" encoding="utf-8" ?>
<!--
  The one tick box. The native CheckBox is a square on Android and a circle on iOS, and it was in use
  beside this control on the same screens, so a list was ticked with squares on one page and circles on
  the next. This one is drawn: 20 by 20 with a 6 radius, grey while empty, filled with its Color when
  ticked, the same in every theme because every colour here is a token.

  Two borders rather than a trigger: a DataTrigger that swaps the stroke writes the resolved colour back
  on exit and the DynamicResource underneath stops following the theme. The empty box keeps its own
  DynamicResource stroke; the filled one is simply shown over it.

  Give it a Command and it stops toggling itself: the command owns the state and writes IsChecked back.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Diarion.Controls.RoundedCheckBox"
             x:Name="RootView"
             MinimumWidthRequest="32"
             MinimumHeightRequest="32"
             BackgroundColor="Transparent">

    <Grid>
        <Border StrokeThickness="1.5"
                Stroke="{DynamicResource Theme_Ocean_Dust}"
                BackgroundColor="Transparent"
                WidthRequest="20"
                HeightRequest="20"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                InputTransparent="True">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="{Binding CornerRadius, Source={x:Reference RootView}}" />
            </Border.StrokeShape>
        </Border>

        <Border StrokeThickness="1.5"
                Stroke="{Binding ActiveColor, Source={x:Reference RootView}}"
                BackgroundColor="{Binding ActiveColor, Source={x:Reference RootView}}"
                WidthRequest="20"
                HeightRequest="20"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="3"
                InputTransparent="True"
                IsVisible="{Binding IsChecked, Source={x:Reference RootView}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="{Binding CornerRadius, Source={x:Reference RootView}}" />
            </Border.StrokeShape>
            <Path Data="M 4 11 L 9 16 L 19 6"
                  Stroke="{DynamicResource Theme_OnAccent}"
                  StrokeThickness="2.5"
                  StrokeLineCap="Round"
                  StrokeLineJoin="Round"
                  Aspect="Uniform"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill" />
        </Border>

        <!-- Invisible Button to natively capture clicks across all platforms without GestureRecognizers -->
        <Button BackgroundColor="Transparent"
                BorderColor="Transparent"
                BorderWidth="0"
                Clicked="OnButtonClicked"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                ZIndex="10" />
    </Grid>
</ContentView>
