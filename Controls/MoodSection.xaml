<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Diarion.ViewModels;assembly=Diarion.Core"
             xmlns:localization="clr-namespace:Diarion.Resources.Localization;assembly=Diarion.Core"
             xmlns:behaviors="clr-namespace:Diarion.Behaviors"
             xmlns:icons="clr-namespace:Diarion.Resources.Icons;assembly=Diarion.Core"
             xmlns:controls="clr-namespace:Diarion.Controls"
             x:Class="Diarion.Controls.MoodSection"
             x:DataType="viewmodels:DiaryEntryViewModel">

    <ContentView.Resources>
        <!-- A face's tap target: the whole cell, transparent. Press feedback lives here and scales this
             element, which is why the chosen-state emphasis lives one level down. -->
        <Style x:Key="MoodFaceCell" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HeightRequest" Value="60" />
            <Setter Property="behaviors:PressFeedback.IsEnabled" Value="True" />
        </Style>

        <!-- The disc behind an emoji: a quiet surface until chosen, then the quadrant's hue on the
             inner fill layer. The fill is a plain binding, not a trigger: a DataTrigger on a Border with
             press feedback did not give the colour back on un-apply. -->
        <Style x:Key="MoodFaceDisc" TargetType="Border">
            <Setter Property="StrokeShape" Value="Ellipse" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Earth_Midnight}" />
            <Setter Property="WidthRequest" Value="48" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="InputTransparent" Value="True" />
        </Style>

        <!-- The fill layer inside a disc: transparent until its face is chosen. -->
        <Style x:Key="MoodFill" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="InputTransparent" Value="True" />
        </Style>

    </ContentView.Resources>

    <Border Style="{StaticResource Card}">

        <VerticalStackLayout Spacing="12">
            <!-- Header: the caption and, at the right, the hours chip. The row below speaks for the
                 day until an hour is chosen in the chip's bubble; then the chip reads the hour and the
                 ✕ beside it returns the row to the day, so the switch is never silent. -->
            <!-- Two columns, the chips in one row: a third column for the ✕ kept its spacing while the ✕ was
                 hidden, and the clock sat 6 points left of the health block's drop (owner, 2026-10-23). -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <Label Grid.Column="0" Text="{x:Static localization:AppResources.EmotionLabel}"
                       Style="{StaticResource SectionHeader}" VerticalOptions="Center" />

                <!-- The clock stays where it is, at the card's right edge over the health block's drop: the ✕
                     appears to its left and the chosen hour grows leftwards inside the chip. With the ✕ on
                     the right and the hour after the icon, choosing an hour threw the clock a whole button's
                     width to the left (owner, build 17, 2026-10-23). -->
                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center" HorizontalOptions="End">
                <Border Style="{StaticResource HeaderChip}" WidthRequest="32" IsVisible="{Binding IsHourSelected}"
                        SemanticProperties.Description="{x:Static localization:AppResources.MoodHourExit}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ExitHourModeCommand}" />
                    </Border.GestureRecognizers>
                    <Border Style="{StaticResource HeaderChipSurface}" Padding="0">
                        <Path Data="M 7 7 L 17 17 M 17 7 L 7 17" Style="{StaticResource HeaderChipIcon}"
                              WidthRequest="12" HeightRequest="12" Stroke="{DynamicResource Theme_Midnight_Snow}" />
                    </Border>
                </Border>

                <Border x:Name="HourChip" Style="{StaticResource HeaderChip}"
                        SemanticProperties.Description="{Binding HourChipText}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenHourPickerCommand}" />
                    </Border.GestureRecognizers>
                    <!-- A clock, and to its left only state: the chosen hour, or how many hours carry a mood. No
                         caption — the spoken label is the chip's description. Round while it is just the clock. -->
                    <Border Style="{StaticResource HeaderChipSurface}"
                            behaviors:ThemeColor.BackgroundKey="{Binding HourChipFillColorKey}"
                            behaviors:ThemeColor.BackgroundFallbackKey="Theme_Snow_Black">
                        <HorizontalStackLayout Spacing="5" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{Binding HourChipBadge}" IsVisible="{Binding HasHourChipBadge}"
                                   FontSize="12" FontAttributes="Bold" VerticalOptions="Center"
                                   TextColor="{DynamicResource Theme_Midnight_Snow}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsHourChipFilled}" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource Theme_OnAccent}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Path Data="{x:Static icons:AppIcons.Clock}" Style="{StaticResource HeaderChipIcon}"
                                  Stroke="{DynamicResource Theme_Midnight_Snow}">
                                <Path.Triggers>
                                    <DataTrigger TargetType="Path" Binding="{Binding IsHourChipFilled}" Value="True">
                                        <Setter Property="Stroke" Value="{DynamicResource Theme_OnAccent}" />
                                    </DataTrigger>
                                </Path.Triggers>
                            </Path>
                        </HorizontalStackLayout>
                    </Border>
                </Border>
                </HorizontalStackLayout>
            </Grid>

            <!-- The row: five faces from unpleasant to pleasant, no words until one is chosen. A tap
                 records the face's representative emotion and opens the bubble of precise states over
                 the page; the chosen face fills with its hue and the precise state is named under it. -->
            <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                <Grid x:Name="FacesRow" Grid.Row="0" ColumnDefinitions="*,*,*,*,*" BindableLayout.ItemsSource="{Binding Quadrants}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:MoodQuadrantViewModel">
                            <Border Style="{StaticResource MoodFaceCell}" Grid.Column="{Binding Column}"
                                    SemanticProperties.Description="{Binding Name}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DiaryEntryViewModel}}, Path=SelectQuadrantCommand}"
                                                          CommandParameter="{Binding Quadrant}" />
                                </Border.GestureRecognizers>
                                <Border Style="{StaticResource MoodFaceDisc}" behaviors:SelectionEmphasis.IsActive="{Binding IsSelected}">
                                    <Border Style="{StaticResource MoodFill}" StrokeShape="Ellipse" behaviors:ThemeColor.BackgroundKey="{Binding FillColorKey}">
                                        <!-- The face in the set chosen in settings: the phone's emoji, weather or a
                                             plant (MoodGlyph; a drawn one moves for a few breaths when chosen).
                                             Dimmed at rest, full and lifting for a moment when chosen
                                             (MoodIconMotion). It starts dimmed here: a face that is not chosen
                                             binds false, the default, and a binding that changes nothing raises
                                             nothing. -->
                                        <controls:MoodGlyph Quadrant="{Binding Quadrant}" IconSet="{Binding IconSet}"
                                                            IsActive="{Binding IsSelected}"
                                                            WidthRequest="38" HeightRequest="38"
                                                            HorizontalOptions="Center" VerticalOptions="Center"
                                                            Opacity="{x:Static behaviors:MoodIconMotion.RestOpacity}"
                                                            behaviors:MoodIconMotion.IsActive="{Binding IsSelected}" />
                                    </Border>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </Grid>

                <!-- The one word on the row: the chosen state, under its face, in its hue. It spans the
                     row and is slid under the face from code-behind, so a long name is never cut to the
                     width of one cell. -->
                <Grid Grid.Row="1" HeightRequest="18">
                    <Label x:Name="Caption"
                           Text="{Binding CurrentMoodName}" IsVisible="{Binding HasCurrentMood}"
                           behaviors:ThemeColor.TextKey="{Binding CurrentColorKey}" FontSize="11" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center" LineBreakMode="NoWrap" />
                </Grid>
            </Grid>

            <!-- The bubble of precise states is a page-level AnchoredPopover holding MoodRefineContent;
                 it asks this control where the chosen face is when it opens (MoodSection.xaml.cs). -->

            <!-- The hours live in a bubble off the chip above (HourPickerContent in an AnchoredPopover
                 on the page); with an hour chosen, this same row writes that hour. -->
        </VerticalStackLayout>
    </Border>
</ContentView>
