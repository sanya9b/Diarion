<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Diarion.ViewModels;assembly=Diarion.Core"
             xmlns:models="clr-namespace:Diarion.Models;assembly=Diarion.Core"
             xmlns:localization="clr-namespace:Diarion.Resources.Localization;assembly=Diarion.Core"
             x:Class="Diarion.Controls.MoodSection"
             x:DataType="viewmodels:DiaryEntryViewModel">

    <ContentView.Resources>
        <Style x:Key="MoodDot" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{DynamicResource Theme_Dust_Ocean}" />
            <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Snow_Midnight}" />
            <Setter Property="HeightRequest" Value="50" />
            <Setter Property="HorizontalOptions" Value="Fill" />
        </Style>
    </ContentView.Resources>

    <Border Padding="16"
            StrokeThickness="1"
            Stroke="{DynamicResource Theme_Dust_Ocean}"
            BackgroundColor="{DynamicResource Theme_Snow_Black}"
            StrokeShape="RoundRectangle 20">
        <Border.Shadow>
            <Shadow Brush="{DynamicResource Theme_Midnight}" Offset="0,6" Radius="12" Opacity="0.2" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="12">
            <Label Text="{x:Static localization:AppResources.EmotionLabel}"
                   FontAttributes="Bold" FontSize="10" CharacterSpacing="1.5"
                   TextColor="{DynamicResource Theme_Coral}" />

            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">

                <!-- Happy -->
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Border Style="{StaticResource MoodDot}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectEmotionCommand}" CommandParameter="{x:Static models:Emotion.Happy}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding CurrentMood}" Value="{x:Static models:Emotion.Happy}">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Coral}" />
                                <Setter Property="Stroke" Value="{DynamicResource Theme_Coral}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="😊" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" SemanticProperties.Description="{x:Static localization:AppResources.EmotionHappy}" />
                    </Border>
                    <Label Text="{x:Static localization:AppResources.EmotionHappy}" FontSize="10" HorizontalTextAlignment="Center" HorizontalOptions="Center" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                </VerticalStackLayout>

                <!-- Calm -->
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Border Style="{StaticResource MoodDot}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectEmotionCommand}" CommandParameter="{x:Static models:Emotion.Calm}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding CurrentMood}" Value="{x:Static models:Emotion.Calm}">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Coral}" />
                                <Setter Property="Stroke" Value="{DynamicResource Theme_Coral}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="😌" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" SemanticProperties.Description="{x:Static localization:AppResources.EmotionCalm}" />
                    </Border>
                    <Label Text="{x:Static localization:AppResources.EmotionCalm}" FontSize="10" HorizontalTextAlignment="Center" HorizontalOptions="Center" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                </VerticalStackLayout>

                <!-- Anxious -->
                <VerticalStackLayout Grid.Column="2" Spacing="4">
                    <Border Style="{StaticResource MoodDot}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectEmotionCommand}" CommandParameter="{x:Static models:Emotion.Anxious}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding CurrentMood}" Value="{x:Static models:Emotion.Anxious}">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Coral}" />
                                <Setter Property="Stroke" Value="{DynamicResource Theme_Coral}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="😰" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" SemanticProperties.Description="{x:Static localization:AppResources.EmotionAnxious}" />
                    </Border>
                    <Label Text="{x:Static localization:AppResources.EmotionAnxious}" FontSize="10" HorizontalTextAlignment="Center" HorizontalOptions="Center" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                </VerticalStackLayout>

                <!-- Sad -->
                <VerticalStackLayout Grid.Column="3" Spacing="4">
                    <Border Style="{StaticResource MoodDot}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectEmotionCommand}" CommandParameter="{x:Static models:Emotion.Sad}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding CurrentMood}" Value="{x:Static models:Emotion.Sad}">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Coral}" />
                                <Setter Property="Stroke" Value="{DynamicResource Theme_Coral}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="😢" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" SemanticProperties.Description="{x:Static localization:AppResources.EmotionSad}" />
                    </Border>
                    <Label Text="{x:Static localization:AppResources.EmotionSad}" FontSize="10" HorizontalTextAlignment="Center" HorizontalOptions="Center" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                </VerticalStackLayout>

                <!-- Angry -->
                <VerticalStackLayout Grid.Column="4" Spacing="4">
                    <Border Style="{StaticResource MoodDot}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectEmotionCommand}" CommandParameter="{x:Static models:Emotion.Angry}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding CurrentMood}" Value="{x:Static models:Emotion.Angry}">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Coral}" />
                                <Setter Property="Stroke" Value="{DynamicResource Theme_Coral}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="😠" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" SemanticProperties.Description="{x:Static localization:AppResources.EmotionAngry}" />
                    </Border>
                    <Label Text="{x:Static localization:AppResources.EmotionAngry}" FontSize="10" HorizontalTextAlignment="Center" HorizontalOptions="Center" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                </VerticalStackLayout>
            </Grid>

            <!-- Настрій по годинах (згорнуто за замовчуванням) -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleHourlyCommand}" />
                </Grid.GestureRecognizers>
                <Label Grid.Column="0"
                       Text="{localization:Translate Key=MoodHourlyLabel}"
                       FontAttributes="Bold" FontSize="10" CharacterSpacing="1.5" TextTransform="Uppercase"
                       TextColor="{DynamicResource Theme_Ocean_Dust}" VerticalOptions="Center" />
                <Label Grid.Column="1" FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" VerticalOptions="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsHourlyExpanded}" Value="True">
                            <Setter Property="Text" Value="⌃" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding IsHourlyExpanded}" Value="False">
                            <Setter Property="Text" Value="⌄" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Grid>

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsHourlyExpanded}">
                <Label FontSize="11" TextColor="{DynamicResource Theme_Ocean_Dust}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsHourSelected}" Value="True">
                            <Setter Property="Text" Value="{localization:Translate Key=MoodHourlyHint}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding IsHourSelected}" Value="False">
                            <Setter Property="Text" Value="{localization:Translate Key=MoodHourlyDayHint}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center"
                            BindableLayout.ItemsSource="{Binding HourlyMood}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:HourMoodViewModel">
                            <Border WidthRequest="42" HeightRequest="34" Margin="0,0,6,6"
                                    StrokeShape="RoundRectangle 10" StrokeThickness="1"
                                    Stroke="{DynamicResource Theme_Dust_Ocean}"
                                    BackgroundColor="{Binding ColorHex}"
                                    SemanticProperties.Description="{Binding AccessibilityText}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DiaryEntryViewModel}}, Path=SelectHourCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Stroke" Value="{DynamicResource Theme_Midnight_Snow}" />
                                        <Setter Property="StrokeThickness" Value="3" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding HourLabel}" FontSize="12" InputTransparent="True"
                                       HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasMood}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource Theme_Snow}" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasMood}" Value="False">
                                            <Setter Property="TextColor" Value="{DynamicResource Theme_Ocean_Dust}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
