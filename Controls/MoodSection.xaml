<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Diarion.ViewModels;assembly=Diarion.Core"
             xmlns:localization="clr-namespace:Diarion.Resources.Localization;assembly=Diarion.Core"
             xmlns:behaviors="clr-namespace:Diarion.Behaviors"
             x:Class="Diarion.Controls.MoodSection"
             x:DataType="viewmodels:DiaryEntryViewModel">

    <ContentView.Resources>
        <!-- A face's tap target: the whole cell, transparent. Press feedback lives here and scales this
             element, which is why the chosen-state emphasis lives one level down. -->
        <Style x:Key="MoodFaceCell" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HeightRequest" Value="60" />
            <Setter Property="behaviors:PressFeedback.IsEnabled" Value="True" />
        </Style>

        <!-- The disc behind an emoji: a quiet surface until chosen, then the quadrant's hue on the
             inner fill layer. The fill is a plain binding, not a trigger: a DataTrigger on a Border with
             press feedback did not give the colour back on un-apply. -->
        <Style x:Key="MoodFaceDisc" TargetType="Border">
            <Setter Property="StrokeShape" Value="Ellipse" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Earth_Midnight}" />
            <Setter Property="WidthRequest" Value="48" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="InputTransparent" Value="True" />
        </Style>

        <!-- The fill layer inside a disc: transparent until its face is chosen. -->
        <Style x:Key="MoodFill" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="InputTransparent" Value="True" />
        </Style>
    </ContentView.Resources>

    <Border Padding="16"
            StrokeThickness="1"
            Stroke="{DynamicResource Theme_Dust_Ocean}"
            BackgroundColor="{DynamicResource Theme_Snow_Black}"
            StrokeShape="RoundRectangle 20">
        <Border.Shadow>
            <Shadow Brush="{DynamicResource Theme_Midnight}" Offset="0,6" Radius="12" Opacity="0.2" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="12">
            <Label Text="{x:Static localization:AppResources.EmotionLabel}"
                   FontAttributes="Bold" FontSize="10" CharacterSpacing="1.5"
                   TextColor="{DynamicResource Theme_Coral}" />

            <!-- The row: five faces from unpleasant to pleasant, no words until one is chosen. A tap
                 records the face's representative emotion and opens the bubble of precise states over
                 the page; the chosen face fills with its hue and the precise state is named under it. -->
            <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                <Grid x:Name="FacesRow" Grid.Row="0" ColumnDefinitions="*,*,*,*,*" BindableLayout.ItemsSource="{Binding Quadrants}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:MoodQuadrantViewModel">
                            <Border Style="{StaticResource MoodFaceCell}" Grid.Column="{Binding Column}"
                                    SemanticProperties.Description="{Binding Name}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DiaryEntryViewModel}}, Path=SelectQuadrantCommand}"
                                                          CommandParameter="{Binding Quadrant}" />
                                </Border.GestureRecognizers>
                                <Border Style="{StaticResource MoodFaceDisc}" behaviors:SelectionEmphasis.IsActive="{Binding IsSelected}">
                                    <Border Style="{StaticResource MoodFill}" StrokeShape="Ellipse" BackgroundColor="{Binding FillColor}">
                                        <Label Text="{Binding Emoji}" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </Grid>

                <!-- The one word on the row: the chosen state, under its face, in its hue. It spans the
                     row and is slid under the face from code-behind, so a long name is never cut to the
                     width of one cell. -->
                <Grid Grid.Row="1" HeightRequest="18">
                    <Label x:Name="Caption"
                           Text="{Binding CurrentMoodName}" IsVisible="{Binding HasCurrentMood}"
                           TextColor="{Binding CurrentColor}" FontSize="11" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center" LineBreakMode="NoWrap" />
                </Grid>
            </Grid>

            <!-- The bubble of precise states is a page-level layer (MoodRefinePopover), placed under
                 the chosen face from the anchor this control publishes; see MoodSection.xaml.cs. -->

            <!-- Настрій по годинах (згорнуто за замовчуванням) -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleHourlyCommand}" />
                </Grid.GestureRecognizers>
                <Label Grid.Column="0"
                       Text="{localization:Translate Key=MoodHourlyLabel}"
                       FontAttributes="Bold" FontSize="10" CharacterSpacing="1.5" TextTransform="Uppercase"
                       TextColor="{DynamicResource Theme_Ocean_Dust}" VerticalOptions="Center" />
                <Label Grid.Column="1" FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" VerticalOptions="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsHourlyExpanded}" Value="True">
                            <Setter Property="Text" Value="⌃" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding IsHourlyExpanded}" Value="False">
                            <Setter Property="Text" Value="⌄" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Grid>

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsHourlyExpanded}">
                <Label FontSize="11" TextColor="{DynamicResource Theme_Ocean_Dust}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsHourSelected}" Value="True">
                            <Setter Property="Text" Value="{localization:Translate Key=MoodHourlyHint}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding IsHourSelected}" Value="False">
                            <Setter Property="Text" Value="{localization:Translate Key=MoodHourlyDayHint}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center"
                            BindableLayout.ItemsSource="{Binding HourlyMood}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:HourMoodViewModel">
                            <Border WidthRequest="42" HeightRequest="34" Margin="0,0,6,6"
                                    StrokeShape="RoundRectangle 10" StrokeThickness="1"
                                    Stroke="{DynamicResource Theme_Dust_Ocean}"
                                    BackgroundColor="{Binding ColorHex}"
                                    SemanticProperties.Description="{Binding AccessibilityText}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DiaryEntryViewModel}}, Path=SelectHourCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Stroke" Value="{DynamicResource Theme_Midnight_Snow}" />
                                        <Setter Property="StrokeThickness" Value="3" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding HourLabel}" FontSize="12" InputTransparent="True"
                                       HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasMood}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource Theme_Snow}" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasMood}" Value="False">
                                            <Setter Property="TextColor" Value="{DynamicResource Theme_Ocean_Dust}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
