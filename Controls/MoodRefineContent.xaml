<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Diarion.ViewModels;assembly=Diarion.Core"
             xmlns:localization="clr-namespace:Diarion.Resources.Localization;assembly=Diarion.Core"
             xmlns:behaviors="clr-namespace:Diarion.Behaviors"
             x:Class="Diarion.Controls.MoodRefineContent"
             x:DataType="viewmodels:DiaryEntryViewModel">

    <ContentView.Resources>
        <!-- A precise state, and the clear action: the chip grammar of the mood row. -->
        <Style x:Key="MoodChip" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{DynamicResource Theme_Dust_Ocean}" />
            <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Snow_Black}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="behaviors:PressFeedback.IsEnabled" Value="True" />
        </Style>

        <!-- The fill layer inside a chip: transparent until chosen (a binding, not a trigger — see MoodSection). -->
        <Style x:Key="MoodFill" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 15" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="InputTransparent" Value="True" />
        </Style>
    </ContentView.Resources>

    <!-- The chosen quadrant's precise states, representative first; a chip sets and closes the bubble. -->
    <VerticalStackLayout Spacing="0" Margin="0,0,-8,-8">
        <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center"
                    BindableLayout.ItemsSource="{Binding Refinements}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:MoodChipViewModel">
                    <Border Style="{StaticResource MoodChip}" SemanticProperties.Description="{Binding Name}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DiaryEntryViewModel}}, Path=SelectEmotionCommand}"
                                                  CommandParameter="{Binding Emotion}" />
                        </Border.GestureRecognizers>
                        <Border Style="{StaticResource MoodFill}" Padding="12,7" behaviors:ThemeColor.BackgroundKey="{Binding FillColorKey}">
                            <Label Text="{Binding Name}" FontSize="13"
                                   TextColor="{DynamicResource Theme_Midnight_Snow}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource Theme_OnAccent}" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>

        <!-- Un-logging lives here, behind a deliberate tap, never on a face. -->
        <Border Style="{StaticResource MoodChip}" HorizontalOptions="End" Margin="0,2,8,8"
                SemanticProperties.Description="{x:Static localization:AppResources.MoodClear}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ClearMoodCommand}" />
            </Border.GestureRecognizers>
            <Border Style="{StaticResource MoodFill}" Padding="12,7">
                <Label Text="{x:Static localization:AppResources.MoodClear}" FontSize="12"
                       TextColor="{DynamicResource Theme_Ocean_Dust}" />
            </Border>
        </Border>
    </VerticalStackLayout>
</ContentView>
