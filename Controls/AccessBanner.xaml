<?xml version="1.0" encoding="utf-8" ?>
<!--
  At most one of two things at the top of the home screen (spec 15, R2.4, R5.1): the read-only
  banner with its single "Renew" button, or — once, after the update — the card that tells a 1.0
  user the app stays free for them. Monochrome, like every panel; neither is an alert.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Diarion.ViewModels;assembly=Diarion.Core"
             xmlns:localization="clr-namespace:Diarion.Resources.Localization;assembly=Diarion.Core"
             x:Class="Diarion.Controls.AccessBanner"
             x:DataType="viewmodels:AccessBannerViewModel">

    <VerticalStackLayout Spacing="0">

        <Border IsVisible="{Binding IsReadOnly}"
                StrokeShape="RoundRectangle 16" StrokeThickness="1"
                Stroke="{DynamicResource Theme_Dust_Ocean}"
                BackgroundColor="{DynamicResource Theme_Snow_Black}"
                Padding="14,10" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                <Label Text="{x:Static localization:AppResources.ReadOnlyBannerText}"
                       FontSize="13" VerticalOptions="Center"
                       TextColor="{DynamicResource Theme_Midnight_Snow}" />
                <Button Grid.Column="1" Text="{x:Static localization:AppResources.ReadOnlyBannerButton}"
                        Command="{Binding RenewCommand}"
                        BackgroundColor="{DynamicResource Theme_Midnight_Snow}"
                        TextColor="{DynamicResource Theme_Snow_Black}"
                        FontAttributes="Bold" CornerRadius="12"
                        HeightRequest="36" Padding="16,0" VerticalOptions="Center" />
            </Grid>
        </Border>

        <Border IsVisible="{Binding ShowLegacyCard}"
                StrokeShape="RoundRectangle 20" StrokeThickness="1"
                Stroke="{DynamicResource Theme_Dust_Ocean}"
                BackgroundColor="{DynamicResource Theme_Snow_Black}"
                Padding="16,14" Margin="0,0,0,12">
            <VerticalStackLayout Spacing="8">
                <Label Text="{x:Static localization:AppResources.LegacyWelcomeTitle}"
                       FontSize="15" FontAttributes="Bold"
                       TextColor="{DynamicResource Theme_Midnight_Snow}" />
                <Label Text="{x:Static localization:AppResources.LegacyWelcomeText}"
                       FontSize="13" LineHeight="1.15"
                       TextColor="{DynamicResource Theme_Ocean_Dust}" />
                <Button Text="{x:Static localization:AppResources.LegacyWelcomeDismiss}"
                        Command="{Binding DismissLegacyCardCommand}"
                        HorizontalOptions="End"
                        BackgroundColor="Transparent"
                        BorderColor="{DynamicResource Theme_Ocean_Ocean}" BorderWidth="1"
                        TextColor="{DynamicResource Theme_Midnight_Snow}"
                        CornerRadius="12" HeightRequest="36" Padding="16,0" />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
