<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:Diarion.Resources.Localization;assembly=Diarion.Core"
             x:Class="Diarion.Controls.ReflectionSection">
             
    <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="16">
            
            <!-- Triggers -->
            <VerticalStackLayout Spacing="6">
                <Label Text="{x:Static localization:AppResources.TriggersLabel}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Field}" Padding="12,8">
                    <Editor Text="{Binding Triggers}" Placeholder="{x:Static localization:AppResources.TriggersPlaceholder}" PlaceholderColor="{DynamicResource Theme_Ocean_Dust}" BackgroundColor="Transparent" TextColor="{DynamicResource Theme_Midnight_Snow}" FontSize="13" MinimumHeightRequest="40" AutoSize="TextChanges" />
                </Border>
            </VerticalStackLayout>
            
            <!-- Gratitude -->
            <VerticalStackLayout Spacing="6">
                <Label Text="{x:Static localization:AppResources.GratitudeLabel}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Field}" Padding="12,8">
                    <Editor Text="{Binding Gratitude}" Placeholder="{x:Static localization:AppResources.GratitudePlaceholder}" PlaceholderColor="{DynamicResource Theme_Ocean_Dust}" BackgroundColor="Transparent" TextColor="{DynamicResource Theme_Midnight_Snow}" FontSize="13" MinimumHeightRequest="40" AutoSize="TextChanges" />
                </Border>
            </VerticalStackLayout>

            <!-- Soul Food -->
            <VerticalStackLayout Spacing="6">
                <Label Text="{x:Static localization:AppResources.SoulFoodLabel}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Field}" Padding="12,8">
                    <Editor Text="{Binding SoulFood}" Placeholder="{x:Static localization:AppResources.SoulFoodPlaceholder}" PlaceholderColor="{DynamicResource Theme_Ocean_Dust}" BackgroundColor="Transparent" TextColor="{DynamicResource Theme_Midnight_Snow}" FontSize="13" MinimumHeightRequest="40" AutoSize="TextChanges" />
                </Border>
            </VerticalStackLayout>

            <!-- Support for others. The model, export, search and the period snapshot had the field all
                 along; only the screen was missing it. -->
            <VerticalStackLayout Spacing="6">
                <Label Text="{x:Static localization:AppResources.SupportForOthersLabel}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Field}" Padding="12,8">
                    <Editor Text="{Binding SupportForOthers}" Placeholder="{x:Static localization:AppResources.SupportForOthersPlaceholder}" PlaceholderColor="{DynamicResource Theme_Ocean_Dust}" BackgroundColor="Transparent" TextColor="{DynamicResource Theme_Midnight_Snow}" FontSize="13" MinimumHeightRequest="40" AutoSize="TextChanges" />
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </Border>

</ContentView>