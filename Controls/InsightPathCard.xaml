<?xml version="1.0" encoding="utf-8" ?>
<!--
  The path to the first hypothesis as one quiet row under the date (spec 17, R2, trimmed on
  2026-10-15 at the owner's request): fourteen notches, the Coral bookmark over the last one that
  counted, and «9 з 14». No frame, no title, no buttons — the daily surface stays silent. The whole
  row opens the statistics screen on the same window. The only words ever shown here are the first
  hypothesis, once, on the day it holds.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Diarion.Controls"
             xmlns:behaviors="clr-namespace:Diarion.Behaviors"
             xmlns:viewmodels="clr-namespace:Diarion.ViewModels;assembly=Diarion.Core"
             x:Class="Diarion.Controls.InsightPathCard"
             x:DataType="viewmodels:InsightPathViewModel">

    <VerticalStackLayout IsVisible="{Binding IsVisible}" Spacing="4" Margin="0,0,0,14"
                         behaviors:PressFeedback.IsEnabled="True"
                         SemanticProperties.Description="{Binding AccessibleSummary}">
        <VerticalStackLayout.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenCommand}" />
        </VerticalStackLayout.GestureRecognizers>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <controls:InsightPathStrip Filled="{Binding PairedDays}" Total="{Binding RequiredDays}"
                                       VerticalOptions="Center"
                                       TrackColor="{DynamicResource Theme_GridLine}"
                                       InkColor="{DynamicResource Theme_Midnight_Snow}"
                                       AccentColor="{DynamicResource Theme_Coral}" />
            <Label Grid.Column="1" Text="{Binding ProgressText}" FontSize="12" FontAttributes="Bold"
                   VerticalOptions="End"
                   TextColor="{DynamicResource Theme_Midnight_Snow}" />
        </Grid>

        <Label IsVisible="{Binding HasHypothesis}" Text="{Binding HypothesisText}"
               FontSize="12" LineBreakMode="TailTruncation"
               TextColor="{DynamicResource Theme_Ocean_Dust}" />
    </VerticalStackLayout>
</ContentView>
