<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vms="clr-namespace:Diarion.ViewModels;assembly=Diarion.Core"
             xmlns:localization="clr-namespace:Diarion.Resources.Localization;assembly=Diarion.Core"
             xmlns:controls="clr-namespace:Diarion.Controls"
             x:Class="Diarion.Controls.HealthSection"
             x:DataType="vms:DiaryEntryViewModel">
    
    <Border StrokeShape="RoundRectangle 16"
            StrokeThickness="1"
            Stroke="{DynamicResource Theme_Dust_Ocean}"
            BackgroundColor="{DynamicResource Theme_Snow_Black}"
            Padding="16">
        <VerticalStackLayout Spacing="10">
            <Label Text="{x:Static localization:AppResources.HealthLabel}" FontAttributes="Bold" FontSize="11" CharacterSpacing="1.5" TextTransform="Uppercase" TextColor="{DynamicResource Theme_Midnight_Snow}" Margin="0,0,0,4" />
            
            <VerticalStackLayout Spacing="6" IsVisible="{Binding BindingContext.CycleStatusSection.IsVisible, Source={RelativeSource AncestorType={x:Type ContentPage}}}">

                <!-- One-way checkbox plus an explicit command: a two-way binding would re-enter the
                     async write when the reload below pushes the new state back. -->
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BindingContext.CycleStatusSection.TogglePeriodDayCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" />
                    </Grid.GestureRecognizers>
                    <controls:RoundedCheckBox Grid.Column="0" IsChecked="{Binding BindingContext.CycleStatusSection.IsPeriodToday, Source={RelativeSource AncestorType={x:Type ContentPage}}, Mode=OneWay}" InputTransparent="True" VerticalOptions="Center" Color="{DynamicResource Theme_Berry}" />
                    <Label Grid.Column="1" Text="{x:Static localization:AppResources.PeriodTodayLabel}" InputTransparent="True" VerticalOptions="Center" FontSize="13" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                </Grid>

                <Label Text="{x:Static localization:AppResources.CycleNoDataHint}"
                       IsVisible="{Binding BindingContext.CycleStatusSection.HasNoData, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                       FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                <VerticalStackLayout Spacing="2" IsVisible="{Binding BindingContext.CycleStatusSection.HasData, Source={RelativeSource AncestorType={x:Type ContentPage}}}">
                    <Label Text="{Binding BindingContext.CycleStatusSection.CycleDayText, Source={RelativeSource AncestorType={x:Type ContentPage}}}" FontAttributes="Bold" FontSize="13" TextColor="{DynamicResource Theme_Midnight_Snow}" />

                    <Label Text="{x:Static localization:AppResources.CycleFertileWindowLabel}"
                           IsVisible="{Binding BindingContext.CycleStatusSection.IsFertileWindowEstimate, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                           FontSize="12" TextColor="{DynamicResource Theme_Sage}" />

                    <Label Text="{Binding BindingContext.CycleStatusSection.NextPeriodText, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                           IsVisible="{Binding BindingContext.CycleStatusSection.HasForecast, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                           FontSize="12" TextColor="{DynamicResource Theme_Midnight_Snow}" />

                    <Label Text="{Binding BindingContext.CycleStatusSection.BasisText, Source={RelativeSource AncestorType={x:Type ContentPage}}}" FontSize="11" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                    <Label Text="{Binding BindingContext.CycleStatusSection.VariabilityNote, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                           IsVisible="{Binding BindingContext.CycleStatusSection.HasVariabilityNote, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                           FontSize="11" TextColor="{DynamicResource Theme_Amber}" />
                </VerticalStackLayout>

                <Label Text="{x:Static localization:AppResources.CycleDisclaimer}" FontSize="10" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                <BoxView HeightRequest="1" Color="{DynamicResource Theme_Dust_Ocean}" Opacity="0.5" Margin="0,4" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="100, *" ColumnSpacing="12">
                <Label Grid.Column="0" Text="{x:Static localization:AppResources.HealthStatusLabel}" VerticalOptions="Center" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                <controls:RatingView Grid.Column="1" Value="{Binding HealthStatus}" MaxValue="5" VerticalOptions="Center" HorizontalOptions="Start" />
            </Grid>

            <Grid ColumnDefinitions="Auto, 100, *" ColumnSpacing="12">
                <controls:RoundedCheckBox Grid.Column="0" IsChecked="{Binding IsIntimateLifeDone}" VerticalOptions="Center" Color="{DynamicResource Theme_Coral}" />
                <Label Grid.Column="1" Text="{x:Static localization:AppResources.IntimateLifeLabel}" VerticalOptions="Center" FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                <Border Grid.Column="2" StrokeThickness="1" Stroke="{DynamicResource Theme_Dust_Ocean}" BackgroundColor="Transparent" StrokeShape="RoundRectangle 12" HeightRequest="36" Padding="12,0">
                    <Entry Text="{Binding IntimateLife}" BackgroundColor="Transparent" TextColor="{DynamicResource Theme_Midnight_Snow}" FontSize="13" VerticalOptions="Center" />
                </Border>
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>