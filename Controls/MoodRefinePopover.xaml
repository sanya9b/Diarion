<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Diarion.ViewModels;assembly=Diarion.Core"
             xmlns:localization="clr-namespace:Diarion.Resources.Localization;assembly=Diarion.Core"
             xmlns:behaviors="clr-namespace:Diarion.Behaviors"
             x:Class="Diarion.Controls.MoodRefinePopover"
             x:DataType="viewmodels:DiaryEntryViewModel"
             IsVisible="False">

    <ContentView.Resources>
        <!-- A precise state, and the clear action: the chip grammar of the mood row. -->
        <Style x:Key="MoodChip" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{DynamicResource Theme_Dust_Ocean}" />
            <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Snow_Black}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="behaviors:PressFeedback.IsEnabled" Value="True" />
        </Style>

        <!-- The fill layer inside a chip: transparent until chosen (a binding, not a trigger — see MoodSection). -->
        <Style x:Key="MoodFill" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 15" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="InputTransparent" Value="True" />
        </Style>

        <!-- The tail: a filled triangle laid over the bubble's edge, stroked on its two free sides only. -->
        <Style x:Key="TailFill" TargetType="Path">
            <Setter Property="Fill" Value="{DynamicResource Theme_Snow_Midnight}" />
        </Style>
        <Style x:Key="TailEdge" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource Theme_Dust_Ocean}" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
    </ContentView.Resources>

    <!-- This layer spans the page. The scrim is see-through and only exists to catch the tap that puts
         the bubble away; the bubble itself is placed from code-behind under (or above) the chosen face. -->
    <Grid x:Name="Layer">
        <Grid x:Name="Scrim" BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseRefinementCommand}" />
            </Grid.GestureRecognizers>
        </Grid>

        <Grid x:Name="Bubble" RowDefinitions="Auto,Auto,Auto" HorizontalOptions="Fill" VerticalOptions="Start"
              Margin="24,0" AnchorY="0">
            <!-- Tail above the bubble (bubble below the face). -->
            <Grid x:Name="TailTopRow" Grid.Row="0" HeightRequest="10" ZIndex="1">
                <Grid x:Name="TailTop" HorizontalOptions="Start" VerticalOptions="End" WidthRequest="18" HeightRequest="11" TranslationY="2">
                    <Path Style="{StaticResource TailFill}" Data="M0,11 L9,1 L18,11 Z" />
                    <Path Style="{StaticResource TailEdge}" Data="M0,11 L9,1 L18,11" />
                </Grid>
            </Grid>

            <Border Grid.Row="1" StrokeShape="RoundRectangle 16" StrokeThickness="1"
                    Stroke="{DynamicResource Theme_Dust_Ocean}"
                    BackgroundColor="{DynamicResource Theme_Snow_Midnight}"
                    Padding="12,12,4,4">
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource Theme_Midnight}" Offset="0,6" Radius="14" Opacity="0.18" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="0">
                    <FlexLayout x:Name="Chips" Wrap="Wrap" JustifyContent="Start" AlignItems="Center"
                                BindableLayout.ItemsSource="{Binding Refinements}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:MoodChipViewModel">
                                <Border Style="{StaticResource MoodChip}" SemanticProperties.Description="{Binding Name}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DiaryEntryViewModel}}, Path=SelectEmotionCommand}"
                                                              CommandParameter="{Binding Emotion}" />
                                    </Border.GestureRecognizers>
                                    <Border Style="{StaticResource MoodFill}" Padding="12,7" BackgroundColor="{Binding FillColor}">
                                        <Label Text="{Binding Name}" FontSize="13"
                                               TextColor="{DynamicResource Theme_Midnight_Snow}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource Theme_Snow}" />
                                                    <Setter Property="FontAttributes" Value="Bold" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- Un-logging lives here, behind a deliberate tap, never on a face. -->
                    <Border Style="{StaticResource MoodChip}" HorizontalOptions="End" Margin="0,2,8,8"
                            SemanticProperties.Description="{x:Static localization:AppResources.MoodClear}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ClearMoodCommand}" />
                        </Border.GestureRecognizers>
                        <Border Style="{StaticResource MoodFill}" Padding="12,7">
                            <Label Text="{x:Static localization:AppResources.MoodClear}" FontSize="12"
                                   TextColor="{DynamicResource Theme_Ocean_Dust}" />
                        </Border>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Tail below the bubble (bubble above the face, when there is no room below). -->
            <Grid x:Name="TailBottomRow" Grid.Row="2" HeightRequest="10" ZIndex="1" IsVisible="False">
                <Grid x:Name="TailBottom" HorizontalOptions="Start" VerticalOptions="Start" WidthRequest="18" HeightRequest="11" TranslationY="-2">
                    <Path Style="{StaticResource TailFill}" Data="M0,0 L9,10 L18,0 Z" />
                    <Path Style="{StaticResource TailEdge}" Data="M0,0 L9,10 L18,0" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentView>
