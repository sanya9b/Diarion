<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Diarion.ViewModels;assembly=Diarion.Core"
             x:Class="Diarion.Views.HappyMomentsItem"
             x:DataType="viewModels:HappyMomentSlotItemViewModel">

    <Grid WidthRequest="120" HeightRequest="160">
        <!-- === Об'ємний 3D Вектор (Щасливі миті) === -->
        
        <!-- Мотузка -->
        <Path Stroke="#7A3249" StrokeThickness="2" Data="M 0,15 Q 60,25 120,15" />
        
        <!-- Тінь від прищіпки -->
        <Path Fill="#000000" Opacity="0.15" Data="M 53,15 L 67,15 L 65,38 L 51,38 Z" />

        <!-- Тінь від фоторамки Polaroid -->
        <Path Fill="#000000" Opacity="0.1" Data="M 23,33 L 103,33 L 103,133 L 23,133 Z" />

        <!-- 3D фаски фоторамки (Зверху та Справа) -->
        <Path Fill="#F3E5EB" Data="M 20,30 L 25,25 L 105,25 L 100,30 Z" />
        <Path Fill="#E2C1CE" Data="M 100,30 L 105,25 L 105,125 L 100,130 Z" />

        <!-- Основна лицьова сторона картки (Біла рамка) -->
        <Path Fill="White" Data="M 20,30 L 100,30 L 100,130 L 20,130 Z" />

        <!-- Контейнер для фотографії -->
        <Path Fill="#FFF0F5" Data="M 28,38 L 92,38 L 92,98 L 28,98 Z" />
        
        <!-- Небо фотографії -->
        <Path Fill="#F8B3C3" Data="M 28,38 L 92,38 L 92,80 L 28,80 Z" />
        
        <!-- Гори на задньому плані -->
        <Path Fill="#D589A6" Data="M 28,80 L 45,70 L 65,85 L 92,68 L 92,98 L 28,98 Z" />
        <Path Fill="#C27290" Data="M 45,70 L 60,60 L 75,75 L 92,58 L 92,68 L 45,70 Z" />
        
        <!-- Повітряна куля у формі серця -->
        <Path Fill="#F57291" Data="M 60,55 C 60,55 52,48 52,41 C 52,37 55,34 58.5,34 C 60.5,34 61.5,35 62,36 C 62.5,35 63.5,34 65.5,34 C 69,34 72,37 72,41 C 72,48 64,55 60,55 Z" />
        <Path Stroke="#7A3249" StrokeThickness="1" Data="M 60,55 L 60,59" />
        <Path Fill="#E6A822" Data="M 58.5,59 L 61.5,59 L 61.5,62 L 58.5,62 Z" />

        <!-- Внутрішнє затінення фотографії для глибини -->
        <Path Stroke="#E2C1CE" StrokeThickness="1.5" Data="M 28,38 H 92 V 98 H 28 Z" />

        <!-- Зірочки та блискітки навколо кулі -->
        <Ellipse Fill="White" Margin="82,44,0,0" WidthRequest="5" HeightRequest="5" HorizontalOptions="Start" VerticalOptions="Start" />
        <Path Fill="#E6A822" Data="M 38,48 L 40,45 L 42,48 L 45,50 L 42,52 L 40,55 L 38,52 L 35,50 Z" />

        <!-- Дерев'яна прищіпка -->
        <Path Fill="#D97706" Data="M 56,10 L 64,10 L 64,33 L 56,33 Z" />
        <Path Fill="#B45309" Data="M 64,11.5 L 67,8.5 L 67,28.5 L 64,31.5 Z" />
        <Path Fill="#FBBF24" Data="M 56,11.5 L 59,8.5 L 67,8.5 L 64,11.5 Z" />
        <Path Fill="#9CA3AF" Data="M 55.5,20 L 64.5,20 L 64.5,22 L 55.5,22 Z" />
        <Path Fill="#4B5563" Data="M 64.5,20 L 67.5,17 L 67.5,19 L 64.5,22 Z" />

        <!-- === Текст поверх рамки Polaroid (у білому полі) === -->
        <Label Text="{Binding MomentTitle}"
               TextColor="{DynamicResource Theme_Midnight_Snow}"
               FontSize="9"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"
               LineBreakMode="TailTruncation"
               MaxLines="2"
               Margin="22, 100, 22, 5" />
    </Grid>
</ContentView>
