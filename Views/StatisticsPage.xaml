<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:Diarion.Behaviors"
             xmlns:icons="clr-namespace:Diarion.Resources.Icons;assembly=Diarion.Core"
             xmlns:viewmodels="clr-namespace:Diarion.ViewModels;assembly=Diarion.Core"
             xmlns:localization="clr-namespace:Diarion.Resources.Localization;assembly=Diarion.Core"
             xmlns:controls="clr-namespace:Diarion.Controls"
             xmlns:models="clr-namespace:Diarion.Models;assembly=Diarion.Core"
             xmlns:stats="clr-namespace:Diarion.ViewModels.Statistics;assembly=Diarion.Core"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Diarion.Views.StatisticsPage"
             x:DataType="viewmodels:StatisticsViewModel"
             Title="{Binding Title}"
             BackgroundColor="{DynamicResource Theme_Earth_Midnight}">

    <!-- The grid exists for the guide layer alone: it has to sit over the scroller, not inside it,
         or it would scroll away with the content it is explaining. -->
    <Grid>
    <ScrollView x:Name="PageScroll">
        <VerticalStackLayout Padding="24,18,24,32" Spacing="20">

            <!-- Header: title + streak pill -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4" VerticalOptions="Center">
                <Label Grid.Column="0" Text="{Binding Title}" FontSize="26" FontAttributes="Bold"
                       VerticalOptions="Center" TextColor="{DynamicResource Theme_Midnight_Snow}" />

                <Border Grid.Column="1" IsVisible="{Binding IsStreakVisible}" VerticalOptions="Center"
                        StrokeThickness="1.5" Stroke="{DynamicResource Theme_Coral}"
                        BackgroundColor="Transparent" StrokeShape="RoundRectangle 18" Padding="12,6">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center"
                                           SemanticProperties.Description="{x:Static localization:AppResources.StreakHeldByGraceHint}">
                        <Path Data="{x:Static icons:AppIcons.Flame}" WidthRequest="16" HeightRequest="16" Stroke="{DynamicResource Theme_Coral}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform" InputTransparent="True" VerticalOptions="Center" />
                        <Label Text="{Binding CurrentStreak}" FontSize="15" FontAttributes="Bold"
                               TextColor="{DynamicResource Theme_Midnight_Snow}" VerticalOptions="Center" />
                        <!-- A caveat mark, not a colour: the palette is not distinguishable by hue alone,
                             and an unmarked number would imply an unbroken run. -->
                        <Label Text="*" FontSize="15" FontAttributes="Bold" VerticalOptions="Start" Margin="-3,0,0,0"
                               IsVisible="{Binding IsStreakHeldByGrace}"
                               TextColor="{DynamicResource Theme_Amber}" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Tab selector: segmented pill-bar with icons inside a track -->
            <!-- x:Name here and on three cards below marks them as guide anchors; StatisticsPage.xaml.cs
                 maps a TourStepId onto each one and measures it. -->
            <Border x:Name="TabsAnchor"
                    StrokeShape="RoundRectangle 22" StrokeThickness="1"
                    Stroke="{DynamicResource Theme_Dust_Ocean}"
                    BackgroundColor="{DynamicResource Theme_Snow_Black}"
                    Padding="4" Margin="0,4,0,0" HorizontalOptions="Fill">
                <CollectionView ItemsSource="{Binding Tabs}" BackgroundColor="Transparent" ItemsLayout="HorizontalList" HeightRequest="38" HorizontalScrollBarVisibility="Never">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:StatisticsTabItem">
                            <Border Padding="14,0" Margin="1,0" HeightRequest="38" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 19" BackgroundColor="Transparent">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Coral}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:StatisticsViewModel}}, Path=SelectTabCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                                    <Path Data="{Binding IconGeometry}" WidthRequest="16" HeightRequest="16" Aspect="Uniform"
                                          StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round"
                                          VerticalOptions="Center" InputTransparent="True">
                                        <Path.Triggers>
                                            <DataTrigger TargetType="Path" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource Theme_Snow}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Path" Binding="{Binding IsSelected}" Value="False">
                                                <Setter Property="Stroke" Value="{DynamicResource Theme_Ocean_Dust}" />
                                            </DataTrigger>
                                        </Path.Triggers>
                                    </Path>
                                    <Label Text="{Binding DisplayName}" VerticalOptions="Center" FontSize="14" FontAttributes="Bold">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource Theme_Snow}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                <Setter Property="TextColor" Value="{DynamicResource Theme_Ocean_Dust}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <!-- Period: the two dates come first and are the actual filter; the chips after them are
                 shortcuts that write into those same two dates. The old "PERIOD" caption is gone —
                 the row reads as a period without being told, and the space buys the date pair. -->
            <ScrollView x:Name="PeriodAnchor"
                        Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,4,0,0"
                        SemanticProperties.Description="{x:Static localization:AppResources.StatsPeriod}">
                <HorizontalStackLayout Spacing="0" VerticalOptions="Center">

                    <Border Padding="10,0" Margin="0,0,6,0" HeightRequest="32" StrokeThickness="1"
                            StrokeShape="RoundRectangle 16" Stroke="{DynamicResource Theme_Dust_Ocean}"
                            BackgroundColor="Transparent">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsCustomRangeSelected}" Value="True">
                                <Setter Property="Stroke" Value="{DynamicResource Theme_Coral}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Path Data="{x:Static icons:AppIcons.Calendar}" WidthRequest="13" HeightRequest="13" Stroke="{DynamicResource Theme_Ocean_Dust}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform" InputTransparent="True" VerticalOptions="Center" />
                            <DatePicker Date="{Binding RangeStart}"
                                        MinimumDate="{Binding MinSelectableDate}"
                                        MaximumDate="{Binding MaxSelectableDate}"
                                        Format="dd.MM.yy" FontSize="13" FontAttributes="Bold"
                                        VerticalOptions="Center" BackgroundColor="Transparent"
                                        TextColor="{DynamicResource Theme_Midnight_Snow}"
                                        SemanticProperties.Description="{x:Static localization:AppResources.StatsRangeStartHint}" />
                            <Label Text="–" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"
                                   InputTransparent="True" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                            <DatePicker Date="{Binding RangeEnd}"
                                        MinimumDate="{Binding MinSelectableDate}"
                                        MaximumDate="{Binding MaxSelectableDate}"
                                        Format="dd.MM.yy" FontSize="13" FontAttributes="Bold"
                                        VerticalOptions="Center" BackgroundColor="Transparent"
                                        TextColor="{DynamicResource Theme_Midnight_Snow}"
                                        SemanticProperties.Description="{x:Static localization:AppResources.StatsRangeEndHint}" />
                        </HorizontalStackLayout>
                    </Border>

                    <HorizontalStackLayout Spacing="0" VerticalOptions="Center"
                                           BindableLayout.ItemsSource="{Binding TimeRanges}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:TimeRangeItem">
                                <ContentView behaviors:PressFeedback.IsEnabled="True">
                                    <ContentView.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:StatisticsViewModel}}, Path=SelectTimeRangeCommand}" CommandParameter="{Binding .}" />
                                    </ContentView.GestureRecognizers>
                                    <Border Padding="12,0" Margin="0,0,6,0" HeightRequest="32" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 16" Stroke="{DynamicResource Theme_Dust_Ocean}"
                                            BackgroundColor="Transparent">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Coral}" />
                                                <Setter Property="Stroke" Value="{DynamicResource Theme_Coral}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding DisplayName}" VerticalOptions="Center" HorizontalOptions="Center" FontSize="13" FontAttributes="Bold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource Theme_Snow}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                    <Setter Property="TextColor" Value="{DynamicResource Theme_Ocean_Dust}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </ContentView>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>

                </HorizontalStackLayout>
            </ScrollView>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource Theme_Ocean_Dust}" />

            <!-- ================= GENERAL TAB (Mood) ================= -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsGeneralTabVisible}">

                <!-- Recurring themes. Labels are the user's own leading sentences, so this needs
                     only the encoder; day counts, not passage counts, because one long evening
                     about a subject is one day of it. -->
                <Border x:Name="ThemesAnchor"
                        IsVisible="{Binding HasThemes}"
                        StrokeShape="RoundRectangle 20" StrokeThickness="1"
                        Stroke="{DynamicResource Theme_Dust_Ocean}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{x:Static localization:AppResources.StatsThemesHeader}"
                               FontSize="12" FontAttributes="Bold" CharacterSpacing="1.5"
                               TextColor="{DynamicResource Theme_Ocean_Dust}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Themes}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:ThemeItem">
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                        <Label Grid.Column="0" Text="{Binding Label}" FontSize="14"
                                               TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                        <Label Grid.Column="1" Text="{Binding DaysLabel}" FontSize="12"
                                               VerticalOptions="Center"
                                               TextColor="{DynamicResource Theme_Sage}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Digest. Extractive by design: these are the user's own sentences, chosen by
                     closeness to the period's centroid, so the card works with no generative model
                     and cannot misrepresent what was written. -->
                <Border IsVisible="{Binding HasDigest}"
                        StrokeShape="RoundRectangle 20" StrokeThickness="1"
                        Stroke="{DynamicResource Theme_Dust_Ocean}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{x:Static localization:AppResources.StatsDigestHeader}"
                               FontSize="12" FontAttributes="Bold" CharacterSpacing="1.5"
                               TextColor="{DynamicResource Theme_Ocean_Dust}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding DigestExcerpts}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:DigestExcerptItem">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding DateLabel}" FontSize="11"
                                               TextColor="{DynamicResource Theme_Coral}" />
                                        <Label Text="{Binding Text}" FontSize="14"
                                               TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="{x:Static localization:AppResources.StatsDigestHint}"
                               FontSize="11" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                    </VerticalStackLayout>
                </Border>

                <controls:EmptyStateView IsVisible="{Binding MoodStats.IsEmpty}" Scene="Mood"
                                         Title="{x:Static localization:AppResources.EmptyStateMoodTitle}"
                                         Hint="{x:Static localization:AppResources.EmptyStateMoodHint}" />

                <!-- KPI row -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding MoodStats.IsNotEmpty}">
                    <controls:StatTile Grid.Column="0"
                                       Label="{x:Static localization:AppResources.StatsKpiTopMood}"
                                       Value="{Binding MoodStats.TopEmotionText}"
                                       Caption="{Binding MoodStats.TopEmotionShareText}"
                                       Sparkline="{Binding MoodStats.MoodSparkline}"
                                       AccentColor="{DynamicResource Theme_Coral}" />
                    <controls:StatTile Grid.Column="1"
                                       Label="{x:Static localization:AppResources.StatsKpiEntries}"
                                       Value="{Binding MoodStats.EntriesCountText}"
                                       AccentColor="{DynamicResource Theme_Coral}" />
                </Grid>

                <!-- Mood trend over time -->
                <Border Style="{StaticResource StatCard}" IsVisible="{Binding MoodStats.HasMoodTrend}">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{x:Static localization:AppResources.StatsMoodTrend}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Coral}" />
                        <controls:LineChart HeightRequest="140"
                                            Items="{Binding MoodStats.MoodTrend}"
                                            MinValue="-2" MaxValue="2"
                                            LineColor="{DynamicResource Theme_Coral}"
                                            SurfaceColor="{DynamicResource Theme_Snow_Black}"
                                            TextColor="{DynamicResource Theme_Midnight_Snow}"
                                            MutedColor="{DynamicResource Theme_Ocean_Dust}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Mood by hour of day -->
                <Border Style="{StaticResource StatCard}" IsVisible="{Binding MoodStats.HasHourlyMood}">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{x:Static localization:AppResources.StatsMoodByHour}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Coral}" />
                        <Label Text="{x:Static localization:AppResources.StatsMoodByHourSubtitle}" FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                        <!-- Fixed-height parent: see the note on the donut below. -->
                        <Grid HeightRequest="170">
                            <controls:MoodHourBarChart Items="{Binding MoodStats.HourlyMoodProfile}"
                                                       PositiveColor="{DynamicResource Theme_Sage}"
                                                       NegativeColor="{DynamicResource Theme_Coral}"
                                                       SurfaceColor="{DynamicResource Theme_Snow_Black}"
                                                       TextColor="{DynamicResource Theme_Midnight_Snow}"
                                                       MutedColor="{DynamicResource Theme_Ocean_Dust}" />
                        </Grid>

                        <!-- The palette alone cannot carry this chart, so the legend is not optional. -->
                        <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center">
                            <HorizontalStackLayout Spacing="6" Margin="0,0,16,4">
                                <Border BackgroundColor="{DynamicResource Theme_Sage}" StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                                <Label Text="{x:Static localization:AppResources.StatsMoodByHourPositive}" FontSize="12" TextColor="{DynamicResource Theme_Midnight_Snow}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6" Margin="0,0,16,4">
                                <Border BackgroundColor="{DynamicResource Theme_Coral}" StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                                <Label Text="{x:Static localization:AppResources.StatsMoodByHourNegative}" FontSize="12" TextColor="{DynamicResource Theme_Midnight_Snow}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6" Margin="0,0,16,4">
                                <Border BackgroundColor="{DynamicResource Theme_Ocean_Dust}" StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                                <Label Text="{x:Static localization:AppResources.StatsMoodByHourNeutral}" FontSize="12" TextColor="{DynamicResource Theme_Midnight_Snow}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6" Margin="0,0,16,4">
                                <Border BackgroundColor="{DynamicResource Theme_Sage}" Opacity="0.35" StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                                <Label Text="{x:Static localization:AppResources.StatsMoodByHourSparse}" FontSize="12" TextColor="{DynamicResource Theme_Midnight_Snow}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Energy by hour of day: the second axis of the circumplex (spec 18), the same control
                     reading the same hours. Warm for energetic, cool for calm; neither side is "good". -->
                <Border Style="{StaticResource StatCard}" IsVisible="{Binding MoodStats.HasHourlyMood}">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{x:Static localization:AppResources.StatsEnergyByHour}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Coral}" />
                        <Label Text="{x:Static localization:AppResources.StatsEnergyByHourSubtitle}" FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                        <Grid HeightRequest="170">
                            <controls:MoodHourBarChart Items="{Binding MoodStats.HourlyMoodProfile}"
                                                       Axis="Energy"
                                                       PositiveColor="{DynamicResource Theme_Amber}"
                                                       NegativeColor="{DynamicResource Theme_Ocean_Ocean}"
                                                       SurfaceColor="{DynamicResource Theme_Snow_Black}"
                                                       TextColor="{DynamicResource Theme_Midnight_Snow}"
                                                       MutedColor="{DynamicResource Theme_Ocean_Dust}" />
                        </Grid>

                        <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center">
                            <HorizontalStackLayout Spacing="6" Margin="0,0,16,4">
                                <Border BackgroundColor="{DynamicResource Theme_Amber}" StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                                <Label Text="{x:Static localization:AppResources.StatsEnergyByHourHigh}" FontSize="12" TextColor="{DynamicResource Theme_Midnight_Snow}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6" Margin="0,0,16,4">
                                <Border BackgroundColor="{DynamicResource Theme_Ocean_Ocean}" StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                                <Label Text="{x:Static localization:AppResources.StatsEnergyByHourLow}" FontSize="12" TextColor="{DynamicResource Theme_Midnight_Snow}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6" Margin="0,0,16,4">
                                <Border BackgroundColor="{DynamicResource Theme_Ocean_Dust}" StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                                <Label Text="{x:Static localization:AppResources.StatsEnergyByHourBalanced}" FontSize="12" TextColor="{DynamicResource Theme_Midnight_Snow}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6" Margin="0,0,16,4">
                                <Border BackgroundColor="{DynamicResource Theme_Amber}" Opacity="0.35" StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                                <Label Text="{x:Static localization:AppResources.StatsMoodByHourSparse}" FontSize="12" TextColor="{DynamicResource Theme_Midnight_Snow}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Mood logged, but only ever day-level: point at the hourly grid instead of an empty chart. -->
                <Border Style="{StaticResource StatCard}" IsVisible="{Binding MoodStats.ShowHourlyMoodHint}">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{x:Static localization:AppResources.StatsMoodByHour}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Coral}" />
                        <Label Text="{x:Static localization:AppResources.StatsMoodByHourNoHourlyData}" FontSize="13" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Mood distribution card -->
                <Border Style="{StaticResource StatCard}" IsVisible="{Binding MoodStats.IsNotEmpty}">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <Label Text="{x:Static localization:AppResources.EmotionLabel}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Coral}" />

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="24">
                            <VerticalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center" BindableLayout.ItemsSource="{Binding MoodStats.EmotionChartData}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:EmotionChartItem">
                                        <Grid ColumnDefinitions="16, *, Auto" ColumnSpacing="8">
                                            <Border Grid.Column="0" BackgroundColor="{Binding Color}" StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" HorizontalOptions="Start" />
                                            <Label Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalOptions="Center" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                            <Label Grid.Column="2" Text="{Binding Percentage, StringFormat='{0:P0}'}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Fixed-size parent: a GraphicsView that self-sizes + centers can collapse to
                                 zero width on Android and render blank; letting it Fill a sized cell fixes it. -->
                            <Grid Grid.Column="1" WidthRequest="110" HeightRequest="110" VerticalOptions="Center" HorizontalOptions="Center">
                                <controls:EmotionDonutChart Items="{Binding MoodStats.EmotionChartData}"
                                                            CenterText="{Binding MoodStats.TopEmotionShareText}"
                                                            CenterCaption="{Binding MoodStats.TopEmotionText}"
                                                            SurfaceColor="{DynamicResource Theme_Snow_Black}"
                                                            TextColor="{DynamicResource Theme_Midnight_Snow}"
                                                            MutedColor="{DynamicResource Theme_Ocean_Dust}" />
                            </Grid>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Year in Pixels (mood heatmap) -->
                <Border Style="{StaticResource StatCard}" IsVisible="{Binding MoodStats.HasMoodCalendar}">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{x:Static localization:AppResources.StatsYearInPixels}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Coral}" />
                        <controls:YearInPixelsView HeightRequest="300"
                                                   Items="{Binding MoodStats.MoodCalendar}"
                                                   MutedColor="{DynamicResource Theme_Ocean_Dust}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Guesses about your mood, checked on the device. The card is a test report: how many
                     factors were compared, how many came through, and how many days each survivor rests
                     on. Not a list of what the diary "found". -->
                <Border x:Name="InfluencesAnchor" Style="{StaticResource StatCard}" IsVisible="{Binding MoodStats.HasCorrelations}">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{x:Static localization:AppResources.StatsMoodInfluencesTitle}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Coral}" />
                        <Label Text="{Binding MoodStats.CorrelationSummaryText}" FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding MoodStats.Correlations}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:MoodCorrelationItem">
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Description}" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                            <Label Text="{Binding Evidence}" FontSize="11" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding Dots}" FontSize="12" CharacterSpacing="1" VerticalOptions="Center" TextColor="{DynamicResource Theme_Coral}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="{x:Static localization:AppResources.StatsCorrelationDisclaimer}" FontSize="11" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Takes the place of the card above whenever the list is empty, and says which kind of
                     empty it is: too little to compare yet, or compared and nothing held. The headline
                     and the line under it are both bound, because those two states want opposite things
                     said — one promises links later, the other must not. -->
                <Border x:Name="InsightProgressAnchor" Style="{StaticResource StatCard}" IsVisible="{Binding MoodStats.HasInsightProgress}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static localization:AppResources.StatsMoodInfluencesTitle}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                        <Label Text="{Binding MoodStats.InsightProgressText}" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                        <Label Text="{Binding MoodStats.InsightProgressHint}" FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ================= SLEEP TAB ================= -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsSleepTabVisible}">

                <controls:EmptyStateView IsVisible="{Binding SleepStats.IsEmpty}" Scene="Sleep"
                                         Title="{x:Static localization:AppResources.EmptyStateSleepTitle}"
                                         Hint="{x:Static localization:AppResources.EmptyStateSleepHint}" />

                <!-- KPI row -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding SleepStats.IsNotEmpty}">
                    <controls:StatTile Grid.Column="0"
                                       Label="{x:Static localization:AppResources.StatsKpiDuration}"
                                       Value="{Binding SleepStats.AverageSleepDurationText}"
                                       Sparkline="{Binding SleepStats.DurationSparkline}"
                                       AccentColor="{DynamicResource Theme_Amber}" />
                    <controls:StatTile Grid.Column="1"
                                       Label="{x:Static localization:AppResources.StatsKpiQuality}"
                                       Value="{Binding SleepStats.AverageSleepQualityText}"
                                       Sparkline="{Binding SleepStats.QualitySparkline}"
                                       AccentColor="{DynamicResource Theme_Amber}" />
                </Grid>

                <!-- Sleep chart card -->
                <Border Style="{StaticResource StatCard}" IsVisible="{Binding SleepStats.IsNotEmpty}">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{x:Static localization:AppResources.SleepLabel}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Amber}" />
                        <controls:SleepBarChart HeightRequest="150"
                                                Items="{Binding SleepStats.SleepChartData}"
                                                MaxValue="12"
                                                BarColor="{DynamicResource Theme_Amber}"
                                                TextColor="{DynamicResource Theme_Midnight_Snow}"
                                                MutedColor="{DynamicResource Theme_Ocean_Dust}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ================= PRODUCTIVITY TAB ================= -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsProductivityTabVisible}">

                <controls:EmptyStateView IsVisible="{Binding ProductivityStats.IsEmpty}" Scene="Productivity"
                                         Title="{x:Static localization:AppResources.EmptyStateProductivityTitle}"
                                         Hint="{x:Static localization:AppResources.EmptyStateProductivityHint}" />

                <!-- KPI row -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding ProductivityStats.IsNotEmpty}">
                    <controls:StatTile Grid.Column="0"
                                       Label="{x:Static localization:AppResources.StatsKpiTasks}"
                                       Value="{Binding ProductivityStats.TaskStatsText}"
                                       AccentColor="{DynamicResource Theme_Sage}" />
                    <controls:StatTile Grid.Column="1"
                                       Label="{x:Static localization:AppResources.StatsKpiCompletion}"
                                       Value="{Binding ProductivityStats.TaskCompletionText}"
                                       AccentColor="{DynamicResource Theme_Sage}" />
                </Grid>

                <!-- Productivity chart card -->
                <Border Style="{StaticResource StatCard}" IsVisible="{Binding ProductivityStats.IsNotEmpty}">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <Label Text="{x:Static localization:AppResources.StatsProductivity}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Sage}" />
                        <Grid HeightRequest="140" WidthRequest="140" HorizontalOptions="Center" VerticalOptions="Center">
                            <controls:ProgressDonutChart Progress="{Binding ProductivityStats.TaskCompletionPercentage}"
                                                         ProgressColor="{DynamicResource Theme_Sage}"
                                                         CenterText="{Binding ProductivityStats.TaskCompletionText}"
                                                         SurfaceColor="{DynamicResource Theme_Snow_Black}"
                                                         TextColor="{DynamicResource Theme_Midnight_Snow}"
                                                         MutedColor="{DynamicResource Theme_Ocean_Dust}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ================= FINANCE TAB ================= -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsFinanceTabVisible}">

                <VerticalStackLayout IsVisible="{Binding FinanceStats.IsEmpty}" Spacing="12" HorizontalOptions="Center" Margin="0,40,0,0">
                    <Path Data="{x:Static icons:AppIcons.Banknote}" WidthRequest="40" HeightRequest="40" Stroke="{DynamicResource Theme_Ocean_Dust}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform" InputTransparent="True" HorizontalOptions="Center" />
                    <Label Text="{x:Static localization:AppResources.EmptyDataMessage}" FontSize="16" TextColor="{DynamicResource Theme_Ocean_Dust}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Account scope. Inside the finance stack, not next to the period chips: those are
                     shared by every tab and an account means nothing to sleep or habits. -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" BackgroundColor="Transparent" IsVisible="{Binding HasStatsAccounts}">
                    <HorizontalStackLayout Spacing="8">
                        <ContentView behaviors:PressFeedback.IsEnabled="True">
                            <ContentView.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectAllStatsAccountsCommand}" />
                            </ContentView.GestureRecognizers>
                            <Border StrokeShape="RoundRectangle 17" StrokeThickness="1" Stroke="{DynamicResource Theme_Dust_Ocean}" Padding="14,6" HeightRequest="34">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsAllStatsAccountsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Coral}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{x:Static localization:AppResources.AllAccounts}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            </Border>
                        </ContentView>

                        <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding StatsAccounts}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:AccountItemViewModel">
                                    <ContentView behaviors:PressFeedback.IsEnabled="True">
                                        <ContentView.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:StatisticsViewModel}}, Path=SelectStatsAccountCommand}" CommandParameter="{Binding .}" />
                                        </ContentView.GestureRecognizers>
                                        <Border StrokeShape="RoundRectangle 17" StrokeThickness="1" Stroke="{DynamicResource Theme_Dust_Ocean}" Padding="14,6" HeightRequest="34">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Coral}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                <Label Text="{Binding Icon}" FontSize="13" VerticalOptions="Center" />
                                                <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </ContentView>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- KPI row -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" IsVisible="{Binding FinanceStats.IsNotEmpty}">
                    <controls:StatTile Grid.Column="0"
                                       Label="{x:Static localization:AppResources.IncomeLabel}"
                                       Value="{Binding FinanceStats.TotalIncome, StringFormat='{0:N2}'}"
                                       AccentColor="{DynamicResource Theme_Sage}" />
                    <controls:StatTile Grid.Column="1"
                                       Label="{x:Static localization:AppResources.ExpenseLabel}"
                                       Value="{Binding FinanceStats.TotalExpense, StringFormat='{0:N2}'}"
                                       AccentColor="{DynamicResource Theme_Coral}" />
                    <controls:StatTile Grid.Column="2"
                                       Label="{x:Static localization:AppResources.StatsKpiBalance}"
                                       Value="{Binding FinanceStats.NetBalanceText}"
                                       AccentColor="{DynamicResource Theme_Amber}" />
                </Grid>

                <!-- Expenses breakdown card -->
                <Border Style="{StaticResource StatCard}" IsVisible="{Binding FinanceStats.IsNotEmpty}">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <Label Text="{x:Static localization:AppResources.ExpenseLabel}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Coral}" />

                        <!-- The list is the legend, so it reads left to right in the order it is asked
                             for: category, what it cost, what share of the month that was. The amount
                             column is Auto and the star column ahead of it takes the slack, which is
                             what lines the figures up on their right edge; the percentage is a fixed
                             width for the same reason, since each row is a Grid of its own and Auto
                             would size every one of them differently. -->
                        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding FinanceStats.ExpenseByCategory}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:CategoryStatItem">
                                    <Grid ColumnDefinitions="12, *, Auto, 44" ColumnSpacing="8">
                                        <Border Grid.Column="0" BackgroundColor="{Binding ColorHex}" StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" HorizontalOptions="Start" />
                                        <Label Grid.Column="1" Text="{Binding Category}" FontSize="13" VerticalOptions="Center" TextColor="{DynamicResource Theme_Midnight_Snow}" LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="2" Text="{Binding Amount, StringFormat='{0:N2}'}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                        <Label Grid.Column="3" Text="{Binding Percentage, StringFormat='{0:P0}'}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="End" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Under the list and across the card, where it is as wide as the phone allows
                             instead of the 120px it had beside the list. The donut draws itself round
                             inside whatever rectangle it is given, so the height is what sets its size —
                             and it has to be stated: a self-sizing GraphicsView collapses to nothing on
                             Android. -->
                        <Grid HeightRequest="240">
                            <controls:CategoryDonutChart Items="{Binding FinanceStats.ExpenseByCategory}"
                                                         SurfaceColor="{DynamicResource Theme_Snow_Black}"
                                                         TextColor="{DynamicResource Theme_Midnight_Snow}"
                                                         MutedColor="{DynamicResource Theme_Ocean_Dust}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Trend: income above the line, expense below -->
                <Border Style="{StaticResource StatCard}" IsVisible="{Binding FinanceStats.HasTrend}">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding FinanceStats.TrendTitle}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextTransform="Uppercase" TextColor="{DynamicResource Theme_Amber}" />

                        <!-- Legend with text labels: the palette is not distinguishable by hue alone. -->
                        <HorizontalStackLayout Spacing="16">
                            <HorizontalStackLayout Spacing="6">
                                <Border BackgroundColor="{DynamicResource Theme_Sage}" StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                                <Label Text="{x:Static localization:AppResources.IncomeLabel}" FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6">
                                <Border BackgroundColor="{DynamicResource Theme_Coral}" StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                                <Label Text="{x:Static localization:AppResources.ExpenseLabel}" FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Fixed height: a self-sizing GraphicsView collapses to nothing on Android. -->
                        <Grid HeightRequest="180">
                            <controls:NetFlowBarChart Items="{Binding FinanceStats.TrendBuckets}"
                                                      PeakValue="{Binding FinanceStats.TrendPeak}"
                                                      IncomeColor="{DynamicResource Theme_Sage}"
                                                      ExpenseColor="{DynamicResource Theme_Coral}"
                                                      SurfaceColor="{DynamicResource Theme_Snow_Black}"
                                                      TextColor="{DynamicResource Theme_Midnight_Snow}"
                                                      MutedColor="{DynamicResource Theme_Ocean_Dust}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Comparison with the preceding equal-length window -->
                <Border Style="{StaticResource StatCard}" IsVisible="{Binding FinanceStats.IsNotEmpty}">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{x:Static localization:AppResources.StatsComparisonTitle}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextTransform="Uppercase" TextColor="{DynamicResource Theme_Amber}" />
                        <Label Text="{Binding FinanceStats.ComparisonRangeText}" FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                        <Label Text="{x:Static localization:AppResources.StatsNoBaseline}"
                               IsVisible="{Binding FinanceStats.HasComparison, Converter={toolkit:InvertedBoolConverter}}"
                               FontSize="13" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                        <VerticalStackLayout Spacing="10" IsVisible="{Binding FinanceStats.HasComparison}" BindableLayout.ItemsSource="{Binding FinanceStats.ComparisonMetrics}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="stats:MetricDeltaItem">
                                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0" Text="{Binding Label}" FontSize="13" VerticalOptions="Center" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                        <Label Grid.Column="1" Text="{Binding ValueText}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                        <Label Grid.Column="2" Text="{Binding DeltaText}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="72" HorizontalTextAlignment="End">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsGood}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource Theme_Sage}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsGood}" Value="False">
                                                    <Setter Property="TextColor" Value="{DynamicResource Theme_Coral}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="{x:Static localization:AppResources.StatsBiggestMoves}" IsVisible="{Binding FinanceStats.HasComparison}" FontSize="11" CharacterSpacing="1.2" TextTransform="Uppercase" TextColor="{DynamicResource Theme_Ocean_Dust}" Margin="0,4,0,0" />

                        <VerticalStackLayout Spacing="8" IsVisible="{Binding FinanceStats.HasComparison}" BindableLayout.ItemsSource="{Binding FinanceStats.ExpenseMovers}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="stats:CategoryMoverItem">
                                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="{Binding Category}" FontSize="13" VerticalOptions="Center" LineBreakMode="TailTruncation" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                        <Label Grid.Column="1" Text="{Binding Badge}" IsVisible="{Binding HasBadge}" FontSize="10" VerticalOptions="Center" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                                        <Label Grid.Column="2" Text="{Binding ChangeText}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" WidthRequest="90" HorizontalTextAlignment="End">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsGood}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource Theme_Sage}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsGood}" Value="False">
                                                    <Setter Property="TextColor" Value="{DynamicResource Theme_Coral}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Per-account flow. Hidden when a single account is already selected. -->
                <Border Style="{StaticResource StatCard}" IsVisible="{Binding FinanceStats.HasAccountBreakdown}">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{x:Static localization:AppResources.StatsAccountBreakdown}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextTransform="Uppercase" TextColor="{DynamicResource Theme_Amber}" />

                        <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding FinanceStats.AccountBreakdown}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="stats:AccountFlowItem">
                                    <VerticalStackLayout Spacing="4">
                                        <HorizontalStackLayout Spacing="8">
                                            <Border BackgroundColor="{Binding ColorHex}" StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                                            <Label Text="{Binding Icon}" FontSize="13" VerticalOptions="Center" />
                                            <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                        </HorizontalStackLayout>

                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="18,0,0,0">
                                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                <Label Text="{x:Static localization:AppResources.IncomeLabel}" FontSize="10" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                                                <Label Text="{Binding IncomeText}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource Theme_Sage}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                <Label Text="{x:Static localization:AppResources.ExpenseLabel}" FontSize="10" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                                                <Label Text="{Binding ExpenseText}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource Theme_Coral}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" Spacing="1" IsVisible="{Binding HasTransfers}">
                                                <Label Text="{x:Static localization:AppResources.StatsTransfersRow}" FontSize="10" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                                                <Label Text="{Binding TransferText}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ================= HABITS TAB ================= -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsHabitsTabVisible}">

                <VerticalStackLayout IsVisible="{Binding HabitStats.IsEmpty}" Spacing="12" HorizontalOptions="Center" Margin="0,40,0,0">
                    <Path Data="{x:Static icons:AppIcons.Sprout}" WidthRequest="40" HeightRequest="40" Stroke="{DynamicResource Theme_Ocean_Dust}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform" InputTransparent="True" HorizontalOptions="Center" />
                    <Label Text="{x:Static localization:AppResources.EmptyDataMessage}" FontSize="16" TextColor="{DynamicResource Theme_Ocean_Dust}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding HabitStats.Habits}" IsVisible="{Binding HabitStats.IsNotEmpty}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="stats:HabitCardViewModel">
                            <Border Style="{StaticResource StatCard}">
                                <Border.Shadow>
                                    <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.15" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource Theme_Midnight_Snow}" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding ScheduleText}" FontSize="11" TextColor="{DynamicResource Theme_Ocean_Dust}" LineBreakMode="TailTruncation" />
                                            <HorizontalStackLayout Spacing="4">
                                                <Path Data="{x:Static icons:AppIcons.Flame}" WidthRequest="12" HeightRequest="12" Stroke="{DynamicResource Theme_Ocean_Dust}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform" InputTransparent="True" VerticalOptions="Center" />
                                                <Label Text="{Binding StreakText}" FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End" Spacing="0">
                                            <Label Text="{Binding StrengthText}" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource Theme_Sage}" HorizontalOptions="End" />
                                            <Label Text="{x:Static localization:AppResources.StatsHabitStrength}" FontSize="10" CharacterSpacing="1" TextTransform="Uppercase" TextColor="{DynamicResource Theme_Ocean_Dust}" HorizontalOptions="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <controls:ContributionGrid HeightRequest="110"
                                                               CompletedDates="{Binding CompletedDates}"
                                                               StartDate="{Binding RangeStart}"
                                                               EndDate="{Binding RangeEnd}"
                                                               AccentColor="{DynamicResource Theme_Sage}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- ================= CYCLE TAB ================= -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsCycleTabVisible}">

                <VerticalStackLayout IsVisible="{Binding CycleStats.IsEmpty}" Spacing="12" HorizontalOptions="Center" Margin="0,40,0,0">
                    <Path Data="{x:Static icons:AppIcons.Drop}" WidthRequest="40" HeightRequest="40" Stroke="{DynamicResource Theme_Ocean_Dust}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform" InputTransparent="True" HorizontalOptions="Center" />
                    <Label Text="{x:Static localization:AppResources.EmptyDataMessage}" FontSize="16" TextColor="{DynamicResource Theme_Ocean_Dust}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- The period chips do not apply here: the shortest of them is a week. -->
                <Label Text="{x:Static localization:AppResources.CycleStatsAllTimeNote}"
                       IsVisible="{Binding CycleStats.IsNotEmpty}"
                       FontSize="11"
                       LineBreakMode="WordWrap"
                       TextColor="{DynamicResource Theme_Ocean_Dust}" />

                <!-- KPI rows -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding CycleStats.IsNotEmpty}">
                    <controls:StatTile Grid.Column="0"
                                       Label="{x:Static localization:AppResources.CycleStatsAverage}"
                                       Value="{Binding CycleStats.AverageCycleText}"
                                       Caption="{x:Static localization:AppResources.CycleStatsDaysCaption}"
                                       AccentColor="{DynamicResource Theme_Berry}" />
                    <controls:StatTile Grid.Column="1"
                                       Label="{x:Static localization:AppResources.CycleStatsPeriodLength}"
                                       Value="{Binding CycleStats.AveragePeriodText}"
                                       Caption="{x:Static localization:AppResources.CycleStatsDaysCaption}"
                                       AccentColor="{DynamicResource Theme_Berry}" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding CycleStats.IsNotEmpty}">
                    <controls:StatTile Grid.Column="0"
                                       Label="{x:Static localization:AppResources.CycleStatsShortest}"
                                       Value="{Binding CycleStats.ShortestCycleText}"
                                       Caption="{x:Static localization:AppResources.CycleStatsDaysCaption}"
                                       AccentColor="{DynamicResource Theme_Berry}" />
                    <controls:StatTile Grid.Column="1"
                                       Label="{x:Static localization:AppResources.CycleStatsLongest}"
                                       Value="{Binding CycleStats.LongestCycleText}"
                                       Caption="{x:Static localization:AppResources.CycleStatsDaysCaption}"
                                       AccentColor="{DynamicResource Theme_Berry}" />
                </Grid>

                <Label Text="{Binding CycleStats.BasisText}"
                       IsVisible="{Binding CycleStats.HasBasis}"
                       FontSize="11"
                       LineBreakMode="WordWrap"
                       TextColor="{DynamicResource Theme_Ocean_Dust}" />

                <!-- Cycle length chart -->
                <Border Style="{StaticResource StatCard}" IsVisible="{Binding CycleStats.HasCycles}">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{x:Static localization:AppResources.CycleStatsLengthChart}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Berry}" />
                        <controls:SleepBarChart HeightRequest="150"
                                                Items="{Binding CycleStats.CycleChartData}"
                                                MaxValue="45"
                                                BarColor="{DynamicResource Theme_Berry}"
                                                TextColor="{DynamicResource Theme_Midnight_Snow}"
                                                MutedColor="{DynamicResource Theme_Ocean_Dust}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Logged days heatmap -->
                <Border Style="{StaticResource StatCard}" IsVisible="{Binding CycleStats.HasCalendar}">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{x:Static localization:AppResources.CycleStatsCalendar}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Berry}" />
                        <controls:ContributionGrid HeightRequest="110"
                                                   CompletedDates="{Binding CycleStats.MarkedDates}"
                                                   StartDate="{Binding CycleStats.CalendarStart}"
                                                   EndDate="{Binding CycleStats.CalendarEnd}"
                                                   AccentColor="{DynamicResource Theme_Berry}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Most frequent symptoms -->
                <Border Style="{StaticResource StatCard}" IsVisible="{Binding CycleStats.HasSymptoms}">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{x:Static localization:AppResources.CycleStatsSymptoms}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Berry}" />
                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding CycleStats.Symptoms}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="stats:CycleSymptomItemViewModel">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding Label}" FontSize="14" VerticalOptions="Center" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                        <Label Grid.Column="1" Text="{Binding CountText}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource Theme_Berry}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

        <!-- Гід по дошці (онбординг, етап 3). Last child, so it covers the scroller. -->
        <controls:TourOverlayView x:Name="TourOverlay" />
    </Grid>
</ContentPage>
