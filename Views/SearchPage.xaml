<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:Diarion.Behaviors"
             xmlns:controls="clr-namespace:Diarion.Controls"
             xmlns:viewmodels="clr-namespace:Diarion.ViewModels;assembly=Diarion.Core"
             xmlns:localization="clr-namespace:Diarion.Resources.Localization;assembly=Diarion.Core"
             x:Class="Diarion.Views.SearchPage"
             x:DataType="viewmodels:SearchViewModel"
             Title="{Binding Title}"
             Shell.PresentationMode="ModalAnimated"
             BackgroundColor="{DynamicResource Theme_Earth_Midnight}">

    <!-- Opened from the section strip like Notes, so it opens the way Notes does: a modal sheet with
         the shared close button. Without it the screen had no way out on iPhone but the tab bar. -->
    <Grid RowDefinitions="Auto, Auto, *">
        <Grid Grid.Row="0" Padding="24,18,24,6" ColumnDefinitions="Auto,*">
            <controls:CloseButton Grid.Column="0" Tapped="OnCloseTapped" />
            <Label Grid.Column="1" Text="{Binding Title}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center"
                   VerticalOptions="Center" Margin="0,0,44,0" TextColor="{DynamicResource Theme_Midnight_Snow}" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="12" Padding="20,4,20,14">

            <SearchBar Text="{Binding Query}"
                       Placeholder="{x:Static localization:AppResources.SearchPlaceholder}"
                       BackgroundColor="{DynamicResource Theme_Snow_Black}"
                       TextColor="{DynamicResource Theme_Midnight_Snow}"
                       PlaceholderColor="{DynamicResource Theme_Ocean_Dust}" />

            <HorizontalStackLayout Spacing="8">
                <ContentView behaviors:PressFeedback.IsEnabled="True">
                    <ContentView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetScopeCommand}" CommandParameter="all" />
                    </ContentView.GestureRecognizers>
                    <Border StrokeShape="RoundRectangle 14" StrokeThickness="0" Padding="14,7"
                            BackgroundColor="{DynamicResource Theme_Snow_Black}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsAllScope}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Ocean_Ocean}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{x:Static localization:AppResources.SearchScopeAll}" InputTransparent="True"
                               FontSize="12" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                    </Border>
                </ContentView>

                <ContentView behaviors:PressFeedback.IsEnabled="True">
                    <ContentView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetScopeCommand}" CommandParameter="diary" />
                    </ContentView.GestureRecognizers>
                    <Border StrokeShape="RoundRectangle 14" StrokeThickness="0" Padding="14,7"
                            BackgroundColor="{DynamicResource Theme_Snow_Black}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsDiaryScope}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Ocean_Ocean}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{x:Static localization:AppResources.SearchScopeDiary}" InputTransparent="True"
                               FontSize="12" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                    </Border>
                </ContentView>

                <ContentView behaviors:PressFeedback.IsEnabled="True">
                    <ContentView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetScopeCommand}" CommandParameter="notes" />
                    </ContentView.GestureRecognizers>
                    <Border StrokeShape="RoundRectangle 14" StrokeThickness="0" Padding="14,7"
                            BackgroundColor="{DynamicResource Theme_Snow_Black}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsNotesScope}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Ocean_Ocean}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{x:Static localization:AppResources.SearchScopeNotes}" InputTransparent="True"
                               FontSize="12" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                    </Border>
                </ContentView>
            </HorizontalStackLayout>

            <Label Text="{Binding ResultsSummary}" FontSize="12"
                   TextColor="{DynamicResource Theme_Ocean_Dust}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{DynamicResource Theme_Ocean_Dust}" />

            <controls:EmptyStateView IsVisible="{Binding ShowEmptyState}" Scene="Search"
                                     Title="{x:Static localization:AppResources.EmptyStateSearchTitle}"
                                     Hint="{x:Static localization:AppResources.EmptyStateSearchHint}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Results}" Margin="20,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:SearchResultItem">
                    <!-- The pressable element is transparent and the card surface one layer down: press
                         feedback writes the background of the element it is attached to, and a theme
                         colour there stays behind after a theme switch. -->
                    <Border behaviors:PressFeedback.IsEnabled="True" StrokeThickness="0" BackgroundColor="Transparent"
                            Padding="0" Margin="0,0,0,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SearchViewModel}}, Path=OpenCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Border Style="{StaticResource Card}" Padding="14" InputTransparent="True">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding SourceLabel}" FontSize="11"
                                       FontAttributes="Bold" CharacterSpacing="1"
                                       TextColor="{DynamicResource Theme_Coral}" />
                                <Label Grid.Column="1" Text="{Binding DateLabel}" FontSize="11"
                                       HorizontalOptions="End"
                                       TextColor="{DynamicResource Theme_Ocean_Dust}" />
                            </Grid>
                            <Label Text="{Binding Snippet}" FontSize="14"
                                   TextColor="{DynamicResource Theme_Midnight_Snow}" />
                        </VerticalStackLayout>
                        </Border>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
