<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:Diarion.Resources.Localization;assembly=Diarion.Core"
             xmlns:viewModels="clr-namespace:Diarion.ViewModels;assembly=Diarion.Core"
             x:Class="Diarion.Views.CyclePage"
             x:Name="RootPage"
             x:DataType="viewModels:CycleViewModel"
             Shell.PresentationMode="ModalAnimated"
             Title="{Binding Title}"
             BackgroundColor="{DynamicResource Theme_Earth_Midnight}">

    <Grid RowDefinitions="Auto,*">
        <Grid Padding="24,18,24,6" ColumnDefinitions="Auto,*">
            <Grid Grid.Column="0" Padding="10" BackgroundColor="Transparent" VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseCommand}" />
                </Grid.GestureRecognizers>
                <Label Text="✕" FontSize="22" InputTransparent="True" TextColor="{DynamicResource Theme_Midnight_Snow}" />
            </Grid>
            <Label Grid.Column="1" Text="{Binding Title}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalOptions="Center" Margin="0,0,44,0" TextColor="{DynamicResource Theme_Midnight_Snow}" />
        </Grid>

        <ScrollView Grid.Row="1" Padding="24,10,24,32">
            <VerticalStackLayout Spacing="20">

                <!-- Forecast -->
                <Border StrokeShape="RoundRectangle 20" StrokeThickness="1"
                        Stroke="{DynamicResource Theme_Dust_Ocean}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        Padding="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{x:Static localization:AppResources.CycleForecastTitle}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextTransform="Uppercase" TextColor="{DynamicResource Theme_Coral}" Margin="0,0,0,4" />

                        <Label Text="{x:Static localization:AppResources.CycleNoDataHint}"
                               IsVisible="{Binding HasNoData}"
                               FontSize="13" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                        <VerticalStackLayout Spacing="3" IsVisible="{Binding HasData}">
                            <Label Text="{Binding CycleDayText}" FontAttributes="Bold" FontSize="16" TextColor="{DynamicResource Theme_Midnight_Snow}" />

                            <Label Text="{x:Static localization:AppResources.CycleFertileWindowLabel}"
                                   IsVisible="{Binding IsFertileWindowEstimate}"
                                   FontSize="13" TextColor="{DynamicResource Theme_Sage}" />

                            <Label Text="{Binding NextPeriodText}"
                                   IsVisible="{Binding HasForecast}"
                                   FontSize="13" TextColor="{DynamicResource Theme_Midnight_Snow}" />

                            <Label Text="{Binding BasisText}" FontSize="11" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                            <Label Text="{Binding VariabilityNote}"
                                   IsVisible="{Binding HasVariabilityNote}"
                                   FontSize="11" TextColor="{DynamicResource Theme_Amber}" />
                        </VerticalStackLayout>

                        <Label Text="{x:Static localization:AppResources.CycleDisclaimer}" FontSize="10" Margin="0,8,0,0" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Record a period -->
                <Border StrokeShape="RoundRectangle 20" StrokeThickness="1"
                        Stroke="{DynamicResource Theme_Dust_Ocean}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <!-- Louder than the other section captions on purpose: this is the one thing the page
                             is for, and at a caption's size it read as a label over the ДОДАТИ button. -->
                        <Label Text="{x:Static localization:AppResources.CycleAddTitle}" FontAttributes="Bold" FontSize="17" TextColor="{DynamicResource Theme_Coral}" />

                        <!-- Date field and button stacked, not side by side: the button keeps its width at any
                             screen size, so on a narrow phone it squeezed the picker against the card edge. -->
                        <Border StrokeShape="RoundRectangle 14" StrokeThickness="1"
                                Stroke="{DynamicResource Theme_Dust_Ocean}"
                                Padding="12,2">
                            <DatePicker Date="{Binding NewEpisodeStart}" MaximumDate="{Binding MaximumDate}" Format="dd.MM.yyyy" TextColor="{DynamicResource Theme_Midnight_Snow}" BackgroundColor="Transparent" FontSize="14" VerticalOptions="Center" HorizontalOptions="Fill" />
                        </Border>

                        <Border StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="{DynamicResource Theme_Coral}" Padding="18,12" HorizontalOptions="Fill">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddEpisodeCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="{x:Static localization:AppResources.CycleAddButton}" InputTransparent="True" FontAttributes="Bold" FontSize="14" CharacterSpacing="1" HorizontalTextAlignment="Center" HorizontalOptions="Center" TextColor="{DynamicResource Theme_Snow}" />
                        </Border>

                        <Label Text="{x:Static localization:AppResources.CycleAddHint}" FontSize="11" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Recorded history -->
                <Border StrokeShape="RoundRectangle 20" StrokeThickness="1"
                        Stroke="{DynamicResource Theme_Dust_Ocean}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static localization:AppResources.CycleHistoryTitle}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextTransform="Uppercase" TextColor="{DynamicResource Theme_Coral}" />

                        <Label Text="{x:Static localization:AppResources.CycleHistoryEmpty}"
                               IsVisible="{Binding HasNoData}"
                               FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Episodes}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:CycleEpisodeItemViewModel">
                                    <Border StrokeThickness="1" Stroke="{DynamicResource Theme_Dust_Ocean}"
                                            BackgroundColor="Transparent"
                                            StrokeShape="RoundRectangle 14" Padding="14,12">
                                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12">
                                            <Label Grid.Column="0" Text="{Binding RangeText}" FontSize="14" VerticalOptions="Center" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                            <Label Grid.Column="1" Text="{Binding IntervalText}" FontSize="11" VerticalOptions="Center" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                                            <Label Grid.Column="2" Text="✕" FontSize="14" VerticalOptions="Center" TextColor="{DynamicResource Theme_Coral}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.DeleteEpisodeCommand}" CommandParameter="{Binding .}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Symptom log. Any day can carry symptoms, not only a period day. -->
                <Border StrokeShape="RoundRectangle 20" StrokeThickness="1"
                        Stroke="{DynamicResource Theme_Dust_Ocean}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.CycleSymptomsLabel}"
                                   FontSize="12" FontAttributes="Bold" CharacterSpacing="1.5" TextTransform="Uppercase"
                                   VerticalOptions="Center" TextColor="{DynamicResource Theme_Coral}" />
                            <DatePicker Grid.Column="1" Date="{Binding SymptomDate}" MaximumDate="{Binding MaximumDate}"
                                        Format="dd.MM.yyyy" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"
                                        BackgroundColor="Transparent" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                        </Grid>

                        <!-- Two fixed columns, height stated and not measured — the same FlexLayout trap as the
                             calendar grid and the habit list. Left to size itself, every chip came out at
                             nothing and the whole symptom list was invisible on the page. The gutter is a
                             margin inside the cell, not on it: a margin on top of a 50% basis is wider than
                             half the row, so the chips would never pair up. -->
                        <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignContent="Start" Direction="Row"
                                    BindableLayout.ItemsSource="{Binding SymptomToggles}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:SymptomToggleViewModel">
                                    <ContentView FlexLayout.Basis="50%" HeightRequest="46">
                                        <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Margin="0,0,8,8"
                                                Stroke="{DynamicResource Theme_Dust_Ocean}" Padding="6,8">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Coral}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.ToggleSymptomCommand}" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <!-- 12pt, not 13: the longest symptom is "Чутливість грудей", and half a
                                                 narrow phone leaves it no room to spare. A chip cannot wrap its way
                                                 out of it — FlexLayout measures the label against infinite width, so
                                                 it reports one line and is then cut to the column. -->
                                            <Label Text="{Binding Label}" FontSize="12" InputTransparent="True"
                                                   HorizontalTextAlignment="Center" VerticalOptions="Center"
                                                   TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                        </Border>
                                    </ContentView>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
