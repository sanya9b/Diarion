<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:Diarion.Resources.Localization;assembly=Diarion.Core"
             xmlns:viewModels="clr-namespace:Diarion.ViewModels;assembly=Diarion.Core"
             xmlns:models="clr-namespace:Diarion.Models;assembly=Diarion.Core"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Diarion.Views.NoteDetailPage"
             x:Name="RootPage"
             x:DataType="viewModels:NoteDetailViewModel"
             Shell.PresentationMode="ModalAnimated"
             Title="{localization:Translate Key=EditEntryTitle}"
             BackgroundColor="{DynamicResource Theme_Earth_Midnight}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Disappearing" Command="{Binding FlushSaveCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*">
        <!-- Top Custom Bar -->
        <Grid Padding="24,18,24,6" ColumnDefinitions="Auto,*,Auto">
            <Grid Grid.Column="0" Padding="10" BackgroundColor="Transparent" VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SaveNoteCommand}" />
                </Grid.GestureRecognizers>
                <!-- Back/Close arrow -->
                <Path Data="M 20 24 L 12 16 L 20 8 M 12 16 H 32"
                      Stroke="{DynamicResource Theme_Midnight_Snow}"
                      StrokeThickness="2"
                      StrokeLineCap="Round"
                      StrokeLineJoin="Round"
                      VerticalOptions="Center"
                      HorizontalOptions="Center"
                      WidthRequest="32"
                      HeightRequest="32" />
            </Grid>

            <VerticalStackLayout Grid.Column="1" Spacing="4">
                <!-- Empty for minimal look -->
            </VerticalStackLayout>
        </Grid>

        <!-- Editor + metadata -->
        <ScrollView Grid.Row="1" Padding="24,10,24,32">
            <VerticalStackLayout Spacing="20">

                <Editor Text="{Binding NoteContent}"
                        Placeholder="{localization:Translate Key=NoteContentPlaceholder}"
                        PlaceholderColor="{DynamicResource Theme_Ocean_Dust}"
                        TextColor="{DynamicResource Theme_Midnight_Snow}"
                        FontSize="18"
                        AutoSize="TextChanges"
                        BackgroundColor="Transparent"
                        MinimumHeightRequest="200" />

                <!-- Tags -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasTags}">
                    <Label Text="{localization:Translate Key=NotesTags}" FontSize="12" FontAttributes="Bold" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Amber}" />
                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Tags}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Margin="0,0,8,8" Padding="10,4" StrokeThickness="1"
                                        Stroke="{DynamicResource Theme_Dust_Ocean}"
                                        BackgroundColor="Transparent" StrokeShape="RoundRectangle 14">
                                    <Label Text="{Binding ., StringFormat='#{0}'}" FontSize="13" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- Linked notes (outgoing) -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasOutgoingLinks}">
                    <Label Text="{localization:Translate Key=NotesLinked}" FontSize="12" FontAttributes="Bold" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Amber}" />
                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding OutgoingLinks}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:NoteLinkItem">
                                <Border Margin="0,0,8,8" Padding="12,5" StrokeThickness="1"
                                        Stroke="{DynamicResource Theme_Coral}"
                                        BackgroundColor="Transparent" StrokeShape="RoundRectangle 14">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Exists}" Value="False">
                                            <Setter Property="Stroke" Value="{DynamicResource Theme_Ocean_Dust}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.OpenLinkedNoteCommand}" CommandParameter="{Binding Title}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Exists}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource Theme_Coral}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Exists}" Value="False">
                                                <Setter Property="TextColor" Value="{DynamicResource Theme_Ocean_Dust}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- Backlinks -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasBacklinks}">
                    <Label Text="{localization:Translate Key=NotesBacklinks}" FontSize="12" FontAttributes="Bold" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Amber}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Backlinks}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Note">
                                <Border StrokeThickness="1" Stroke="{DynamicResource Theme_Dust_Ocean}"
                                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                                        StrokeShape="RoundRectangle 12" Padding="12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.OpenBacklinkCommand}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource Theme_Midnight_Snow}" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Content}" FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" LineBreakMode="TailTruncation" MaxLines="1" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
