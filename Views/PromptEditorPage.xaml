<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:Diarion.Resources.Localization;assembly=Diarion.Core"
             xmlns:viewModels="clr-namespace:Diarion.ViewModels;assembly=Diarion.Core"
             xmlns:models="clr-namespace:Diarion.Models;assembly=Diarion.Core"
             x:Class="Diarion.Views.PromptEditorPage"
             x:Name="RootPage"
             x:DataType="viewModels:PromptEditorViewModel"
             Shell.PresentationMode="ModalAnimated"
             Title="{Binding Title}"
             BackgroundColor="{DynamicResource Theme_Earth_Midnight}">

    <Grid RowDefinitions="Auto,*">
        <!-- Top bar -->
        <Grid Padding="24,18,24,6" ColumnDefinitions="Auto,*,Auto">
            <Grid Grid.Column="0" Padding="10" BackgroundColor="Transparent" VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CancelCommand}" />
                </Grid.GestureRecognizers>
                <Label Text="✕" FontSize="22" InputTransparent="True" TextColor="{DynamicResource Theme_Midnight_Snow}" />
            </Grid>

            <Label Grid.Column="1" Text="{Binding Title}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalOptions="Center" TextColor="{DynamicResource Theme_Midnight_Snow}" />

            <Grid Grid.Column="2" Padding="10" BackgroundColor="Transparent" VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SaveCommand}" />
                </Grid.GestureRecognizers>
                <Label Text="✓" FontSize="22" FontAttributes="Bold" InputTransparent="True" TextColor="{DynamicResource Theme_Coral}" />
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1" Padding="24,10,24,32">
            <VerticalStackLayout Spacing="20">

                <Label Text="{x:Static localization:AppResources.PromptEditorTextUkLabel}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextTransform="Uppercase" TextColor="{DynamicResource Theme_Sage}" />
                <Border StrokeThickness="1" Stroke="{DynamicResource Theme_Dust_Ocean}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        StrokeShape="RoundRectangle 16" Padding="16,8">
                    <Editor Text="{Binding TextUk}"
                            TextColor="{DynamicResource Theme_Midnight_Snow}"
                            BackgroundColor="Transparent"
                            MinimumHeightRequest="70" AutoSize="TextChanges" />
                </Border>

                <Label Text="{x:Static localization:AppResources.PromptEditorTextEnLabel}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextTransform="Uppercase" TextColor="{DynamicResource Theme_Sage}" />
                <Border StrokeThickness="1" Stroke="{DynamicResource Theme_Dust_Ocean}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        StrokeShape="RoundRectangle 16" Padding="16,8">
                    <Editor Text="{Binding TextEn}"
                            TextColor="{DynamicResource Theme_Midnight_Snow}"
                            BackgroundColor="Transparent"
                            MinimumHeightRequest="70" AutoSize="TextChanges" />
                </Border>

                <Label Text="{x:Static localization:AppResources.PromptEditorCategoryLabel}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextTransform="Uppercase" TextColor="{DynamicResource Theme_Sage}" />
                <VerticalStackLayout Spacing="8">
                    <Border Padding="14,10" StrokeThickness="1" StrokeShape="RoundRectangle 16"
                            Stroke="{DynamicResource Theme_Dust_Ocean}" BackgroundColor="Transparent">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Category}" Value="{x:Static models:PromptCategory.CbtReframe}">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Sage}" />
                                <Setter Property="Stroke" Value="{DynamicResource Theme_Sage}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetCategoryCommand}" CommandParameter="{x:Static models:PromptCategory.CbtReframe}" />
                        </Border.GestureRecognizers>
                        <Label Text="{x:Static localization:AppResources.PromptCategoryCbtReframe}" InputTransparent="True" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                    </Border>

                    <Border Padding="14,10" StrokeThickness="1" StrokeShape="RoundRectangle 16"
                            Stroke="{DynamicResource Theme_Dust_Ocean}" BackgroundColor="Transparent">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Category}" Value="{x:Static models:PromptCategory.Savouring}">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Sage}" />
                                <Setter Property="Stroke" Value="{DynamicResource Theme_Sage}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetCategoryCommand}" CommandParameter="{x:Static models:PromptCategory.Savouring}" />
                        </Border.GestureRecognizers>
                        <Label Text="{x:Static localization:AppResources.PromptCategorySavouring}" InputTransparent="True" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                    </Border>

                    <Border Padding="14,10" StrokeThickness="1" StrokeShape="RoundRectangle 16"
                            Stroke="{DynamicResource Theme_Dust_Ocean}" BackgroundColor="Transparent">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Category}" Value="{x:Static models:PromptCategory.OpenReflection}">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Sage}" />
                                <Setter Property="Stroke" Value="{DynamicResource Theme_Sage}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetCategoryCommand}" CommandParameter="{x:Static models:PromptCategory.OpenReflection}" />
                        </Border.GestureRecognizers>
                        <Label Text="{x:Static localization:AppResources.PromptCategoryOpenReflection}" InputTransparent="True" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                    </Border>

                    <Border Padding="14,10" StrokeThickness="1" StrokeShape="RoundRectangle 16"
                            Stroke="{DynamicResource Theme_Dust_Ocean}" BackgroundColor="Transparent">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Category}" Value="{x:Static models:PromptCategory.EveningGratitude}">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Sage}" />
                                <Setter Property="Stroke" Value="{DynamicResource Theme_Sage}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetCategoryCommand}" CommandParameter="{x:Static models:PromptCategory.EveningGratitude}" />
                        </Border.GestureRecognizers>
                        <Label Text="{x:Static localization:AppResources.PromptCategoryEveningGratitude}" InputTransparent="True" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                    </Border>
                </VerticalStackLayout>

                <Label Text="{Binding ValidationMessage}"
                       IsVisible="{Binding HasValidationMessage}"
                       FontSize="13" TextColor="{DynamicResource Theme_Coral}" />

                <Label Text="{x:Static localization:AppResources.DeletePromptConfirmTitle}"
                       IsVisible="{Binding IsExisting}"
                       FontSize="14" HorizontalOptions="Center" Margin="0,10,0,0"
                       TextColor="{DynamicResource Theme_Coral}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DeleteCommand}" />
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
