<?xml version="1.0" encoding="utf-8" ?>
<!--
  The quick entry (roadmap 2.1). One sheet, three things: how you feel at this hour, one line for
  yourself, which habits are done. Reached from the pencil on the home screen, from the evening
  reminder, and from the home-screen shortcut. Saves into today's ordinary row and only on Save.

  The mood row is the day screen's row: the same five faces, the same discs and hues, the same
  rule that the pressable cell is transparent and the colour sits one layer down (press feedback
  writes the background of the element it is attached to). The precise states sit inline under it.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Diarion.ViewModels;assembly=Diarion.Core"
             xmlns:localization="clr-namespace:Diarion.Resources.Localization;assembly=Diarion.Core"
             xmlns:behaviors="clr-namespace:Diarion.Behaviors"
             xmlns:controls="clr-namespace:Diarion.Controls"
             x:Class="Diarion.Views.QuickCapturePage"
             x:Name="PageRoot"
             x:DataType="viewmodels:QuickCaptureViewModel"
             Title="{Binding Title}"
             Shell.PresentationMode="ModalAnimated"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{DynamicResource Theme_Earth_Midnight}">

    <ContentPage.Resources>
        <!-- A face's tap target: the whole cell, transparent. Same as MoodSection. -->
        <Style x:Key="FaceCell" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HeightRequest" Value="60" />
            <Setter Property="behaviors:PressFeedback.IsEnabled" Value="True" />
        </Style>

        <Style x:Key="FaceDisc" TargetType="Border">
            <Setter Property="StrokeShape" Value="Ellipse" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Earth_Midnight}" />
            <Setter Property="WidthRequest" Value="48" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="InputTransparent" Value="True" />
        </Style>

        <Style x:Key="Fill" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="InputTransparent" Value="True" />
        </Style>

        <!-- Chips: outlined, transparent, press feedback here; fill on the inner layer. No shrink, so a
             long name wraps to the next line instead of being cut (the iPhone FlexLayout lesson). -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{DynamicResource Theme_Dust_Ocean}" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="FlexLayout.Shrink" Value="0" />
            <Setter Property="behaviors:PressFeedback.IsEnabled" Value="True" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Header: the way out on the left, as on every modal page; the hour the mood goes to below the title. -->
        <Grid Grid.Row="0" Padding="24,18,24,6" ColumnDefinitions="Auto,*">
            <controls:CloseButton Grid.Column="0" Command="{Binding CancelCommand}" />
            <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="0,0,44,0" VerticalOptions="Center">
                <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center"
                       TextColor="{DynamicResource Theme_Midnight_Snow}" />
                <Label Text="{Binding HourText}" FontSize="12" HorizontalTextAlignment="Center"
                       TextColor="{DynamicResource Theme_Ocean_Dust}" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1" Padding="24,10,24,16">
            <!-- Disabled as a whole while the diary is read-only, like the home blocks: the paywall
                 is the answer to Save, but typing a line first and losing it would be the worse way
                 to learn that. -->
            <VerticalStackLayout Spacing="16" behaviors:ReadOnlyAccess.DisableWhenReadOnly="True">

                <!-- Mood at this hour -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{x:Static localization:AppResources.QuickCaptureMoodLabel}" Style="{StaticResource SectionHeader}" />

                        <Grid ColumnDefinitions="*,*,*,*,*" BindableLayout.ItemsSource="{Binding Quadrants}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:MoodQuadrantViewModel">
                                    <Border Style="{StaticResource FaceCell}" Grid.Column="{Binding Column}"
                                            SemanticProperties.Description="{Binding Name}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectQuadrantCommand}"
                                                                  CommandParameter="{Binding Quadrant}" />
                                        </Border.GestureRecognizers>
                                        <Border Style="{StaticResource FaceDisc}" behaviors:SelectionEmphasis.IsActive="{Binding IsSelected}">
                                            <Border Style="{StaticResource Fill}" StrokeShape="Ellipse" behaviors:ThemeColor.BackgroundKey="{Binding FillColorKey}">
                                                <Image Source="{Binding IconFile}" WidthRequest="38" HeightRequest="38"
                                                       HorizontalOptions="Center" VerticalOptions="Center"
                                                       Opacity="{x:Static behaviors:MoodIconMotion.RestOpacity}"
                                                       behaviors:MoodIconMotion.IsActive="{Binding IsSelected}" />
                                            </Border>
                                        </Border>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>

                        <Label Text="{Binding SelectedMoodName}" IsVisible="{Binding HasSelectedMood}"
                               FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="Center"
                               TextColor="{DynamicResource Theme_Midnight_Snow}" />

                        <!-- The precise states of the chosen face, inline. Optional: a face alone is an entry. -->
                        <VerticalStackLayout Spacing="2" IsVisible="{Binding HasSelectedMood}">
                            <FlexLayout Wrap="Wrap" JustifyContent="Center" AlignItems="Center" AlignContent="Center"
                                        IsVisible="{Binding HasRefinements}"
                                        BindableLayout.ItemsSource="{Binding Refinements}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:MoodChipViewModel">
                                        <Border Style="{StaticResource Chip}" SemanticProperties.Description="{Binding Name}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectEmotionCommand}"
                                                                      CommandParameter="{Binding Emotion}" />
                                            </Border.GestureRecognizers>
                                            <Border Style="{StaticResource Fill}" StrokeShape="RoundRectangle 15" Padding="12,7"
                                                    behaviors:ThemeColor.BackgroundKey="{Binding FillColorKey}"
                                                    behaviors:ThemeColor.BackgroundFallbackKey="Theme_Snow_Black">
                                                <Label Text="{Binding Name}" FontSize="13" LineBreakMode="NoWrap"
                                                       TextColor="{DynamicResource Theme_Midnight_Snow}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="TextColor" Value="{DynamicResource Theme_OnAccent}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>

                            <!-- Un-logging behind a deliberate tap, never on a face — the day screen's rule. -->
                            <Border Style="{StaticResource Chip}" HorizontalOptions="Center" StrokeThickness="0"
                                    SemanticProperties.Description="{x:Static localization:AppResources.MoodClear}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ClearMoodCommand}" />
                                </Border.GestureRecognizers>
                                <Border Style="{StaticResource Fill}" Padding="12,6">
                                    <Label Text="{x:Static localization:AppResources.MoodClear}" FontSize="12" LineBreakMode="NoWrap"
                                           TextColor="{DynamicResource Theme_Ocean_Dust}" />
                                </Border>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- One line, into the same "for myself" field the day screen has, in the same field style. -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static localization:AppResources.SoulFoodLabel}" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Field}" Padding="12,8">
                            <Editor Text="{Binding Text}"
                                    Placeholder="{x:Static localization:AppResources.QuickCaptureTextPlaceholder}"
                                    PlaceholderColor="{DynamicResource Theme_Ocean_Dust}"
                                    BackgroundColor="Transparent"
                                    TextColor="{DynamicResource Theme_Midnight_Snow}"
                                    FontSize="14" MinimumHeightRequest="56" AutoSize="TextChanges" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Habit chips: tap to tick. Same ticks as the home block, nothing new. -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasHabits}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static localization:AppResources.QuickCaptureHabitsLabel}" Style="{StaticResource SectionHeader}" />

                        <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center"
                                    BindableLayout.ItemsSource="{Binding Habits}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:QuickHabitChip">
                                    <Border Style="{StaticResource Chip}" SemanticProperties.Description="{Binding Name}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ToggleHabitCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border Style="{StaticResource Fill}" StrokeShape="RoundRectangle 15" Padding="12,7"
                                                behaviors:ThemeColor.BackgroundKey="{Binding FillColorKey}"
                                                behaviors:ThemeColor.BackgroundFallbackKey="Theme_Snow_Black">
                                            <HorizontalStackLayout Spacing="6">
                                                <!-- A tick mark, not colour alone: the palette is not told apart by hue. -->
                                                <Label Text="✓" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"
                                                       IsVisible="{Binding IsCompleted}"
                                                       TextColor="{DynamicResource Theme_OnAccent}" />
                                                <Label Text="{Binding Name}" FontSize="13" VerticalOptions="Center" LineBreakMode="NoWrap"
                                                       TextColor="{DynamicResource Theme_Midnight_Snow}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="TextColor" Value="{DynamicResource Theme_OnAccent}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Save, styled as the task page's Save, and the way to the full form. -->
        <VerticalStackLayout Grid.Row="2" Spacing="12" Padding="24,0,24,20">
            <Border HeightRequest="48" StrokeThickness="0" BackgroundColor="Transparent"
                    behaviors:PressFeedback.IsEnabled="True"
                    SemanticProperties.Description="{x:Static localization:AppResources.QuickCaptureSave}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SaveCommand}" />
                </Border.GestureRecognizers>
                <!-- The surface and its dimmed state live here, not on the pressable element above. -->
                <Border StrokeShape="RoundRectangle 14" StrokeThickness="0" InputTransparent="True"
                        BackgroundColor="{DynamicResource Theme_Ocean_Ocean}">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,4" Radius="8" Opacity="0.2" />
                    </Border.Shadow>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding CanSave}" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="{x:Static localization:AppResources.QuickCaptureSave}"
                           FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{DynamicResource Theme_Snow_Midnight}" />
                </Border>
            </Border>

            <Label Text="{x:Static localization:AppResources.QuickCaptureOpenFull}"
                   FontSize="13" HorizontalOptions="Center" TextDecorations="Underline"
                   TextColor="{DynamicResource Theme_Ocean_Dust}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenFullEntryCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>

        <ActivityIndicator Grid.Row="0" Grid.RowSpan="3"
                           IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           Color="{DynamicResource Theme_Ocean_Dust}" />
    </Grid>
</ContentPage>
