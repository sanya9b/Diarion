<?xml version="1.0" encoding="utf-8" ?>
<!--
  The quick entry (roadmap 2.1). One sheet, three things: how you feel at this hour, one line for
  yourself, which habits are done. Reached from the pencil on the home screen, from the evening
  reminder, and from the home-screen shortcut. Saves into today's ordinary row and only on Save.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Diarion.ViewModels;assembly=Diarion.Core"
             xmlns:localization="clr-namespace:Diarion.Resources.Localization;assembly=Diarion.Core"
             xmlns:behaviors="clr-namespace:Diarion.Behaviors"
             x:Class="Diarion.Views.QuickCapturePage"
             x:Name="PageRoot"
             x:DataType="viewmodels:QuickCaptureViewModel"
             Title="{Binding Title}"
             Shell.PresentationMode="ModalAnimated"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{DynamicResource Theme_Earth_Midnight}">

    <ContentPage.Resources>
        <Style x:Key="QuickCard" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 20" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{DynamicResource Theme_Dust_Ocean}" />
            <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Snow_Black}" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="QuickCaption" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="CharacterSpacing" Value="1.5" />
            <Setter Property="TextColor" Value="{DynamicResource Theme_Coral}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto" Padding="24,12,24,20" RowSpacing="12">

        <!-- Header: title and the hour the mood will land on; always a way out. -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="12">
            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                <Label Text="{Binding Title}" FontSize="22" FontAttributes="Bold"
                       TextColor="{DynamicResource Theme_Midnight_Snow}" />
                <Label Text="{Binding HourText}" FontSize="13"
                       TextColor="{DynamicResource Theme_Ocean_Dust}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="✕"
                    VerticalOptions="Start"
                    BackgroundColor="Transparent" BorderWidth="0"
                    FontSize="22" Padding="0" HeightRequest="44" WidthRequest="44"
                    TextColor="{DynamicResource Theme_Ocean_Dust}"
                    Command="{Binding CancelCommand}"
                    SemanticProperties.Description="{x:Static localization:AppResources.QuickCaptureCancel}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <!-- Disabled as a whole while the diary is read-only, like the home blocks: the paywall
                 is the answer to Save, but typing a line first and losing it would be the worse way
                 to learn that. -->
            <VerticalStackLayout Spacing="14" behaviors:ReadOnlyAccess.DisableWhenReadOnly="True">

                <!-- Mood at this hour -->
                <Border Style="{StaticResource QuickCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{x:Static localization:AppResources.QuickCaptureMoodLabel}" Style="{StaticResource QuickCaption}" />

                        <FlexLayout Direction="Row" JustifyContent="SpaceBetween" AlignItems="Start"
                                    BindableLayout.ItemsSource="{Binding Emotions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:QuickEmotionChoice">
                                    <VerticalStackLayout Spacing="4" FlexLayout.Basis="19%">
                                        <!-- The fill is a bound inner layer, not a trigger on this Border: a
                                             trigger setter on a Border that also has press feedback applies
                                             but never reverts, and the previous tile stays lit. -->
                                        <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Padding="0"
                                                Stroke="{DynamicResource Theme_Dust_Ocean}"
                                                BackgroundColor="{DynamicResource Theme_Snow_Midnight}"
                                                HeightRequest="52" HorizontalOptions="Fill"
                                                behaviors:PressFeedback.IsEnabled="True"
                                                SemanticProperties.Description="{Binding Name}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectEmotionCommand}"
                                                                      CommandParameter="{Binding Emotion}" />
                                            </Border.GestureRecognizers>
                                            <Border StrokeShape="RoundRectangle 15" StrokeThickness="0" Padding="0"
                                                    InputTransparent="True"
                                                    BackgroundColor="{Binding FillColorHex}">
                                                <Label Text="{Binding Glyph}" FontSize="24" InputTransparent="True"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Border>
                                        <Label Text="{Binding Name}" FontSize="10" HorizontalTextAlignment="Center"
                                               HorizontalOptions="Center" LineBreakMode="TailTruncation"
                                               TextColor="{DynamicResource Theme_Ocean_Dust}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- One line, into the same "for myself" field the day screen has -->
                <Border Style="{StaticResource QuickCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static localization:AppResources.SoulFoodLabel}" Style="{StaticResource QuickCaption}" />
                        <Editor Text="{Binding Text}"
                                Placeholder="{x:Static localization:AppResources.QuickCaptureTextPlaceholder}"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="64"
                                FontSize="15"
                                TextColor="{DynamicResource Theme_Midnight_Snow}"
                                PlaceholderColor="{DynamicResource Theme_Ocean_Dust}"
                                BackgroundColor="Transparent" />
                    </VerticalStackLayout>
                </Border>

                <!-- Habit chips: tap to tick. Same ticks as the home block, nothing new. -->
                <Border Style="{StaticResource QuickCard}" IsVisible="{Binding HasHabits}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static localization:AppResources.QuickCaptureHabitsLabel}" Style="{StaticResource QuickCaption}" />

                        <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center"
                                    BindableLayout.ItemsSource="{Binding Habits}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:QuickHabitChip">
                                    <!-- Same arrangement as the tiles above: the fill lives on a bound inner
                                         layer so that unticking gives the colour back. -->
                                    <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Padding="0"
                                            Margin="0,0,8,8"
                                            Stroke="{DynamicResource Theme_Dust_Ocean}"
                                            BackgroundColor="{DynamicResource Theme_Snow_Midnight}"
                                            behaviors:PressFeedback.IsEnabled="True">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ToggleHabitCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border StrokeShape="RoundRectangle 15" StrokeThickness="0" Padding="12,7"
                                                InputTransparent="True"
                                                BackgroundColor="{Binding FillColorHex}">
                                            <HorizontalStackLayout Spacing="6" InputTransparent="True">
                                                <!-- A tick mark, not colour alone: the palette is not told apart by hue. -->
                                                <Label Text="✓" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"
                                                       IsVisible="{Binding IsCompleted}"
                                                       TextColor="{DynamicResource Theme_Snow}" />
                                                <Label Text="{Binding Name}" FontSize="13" VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="TextColor" Value="{DynamicResource Theme_Snow}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="False">
                                                            <Setter Property="TextColor" Value="{DynamicResource Theme_Midnight_Snow}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Save, and the way to the full form -->
        <VerticalStackLayout Grid.Row="2" Spacing="12">
            <!-- Dimmed, not recoloured, while there is nothing to save: an explicit BackgroundColor
                 overrides the platform's own disabled look, so the state has to be drawn here. -->
            <Button Text="{x:Static localization:AppResources.QuickCaptureSave}"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="{DynamicResource Theme_Coral}"
                    TextColor="{DynamicResource Theme_Snow}"
                    FontAttributes="Bold"
                    CornerRadius="14"
                    HeightRequest="50">
                <Button.Triggers>
                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </Trigger>
                </Button.Triggers>
            </Button>

            <Label Text="{x:Static localization:AppResources.QuickCaptureOpenFull}"
                   FontSize="13" HorizontalOptions="Center" TextDecorations="Underline"
                   TextColor="{DynamicResource Theme_Ocean_Dust}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenFullEntryCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>

        <ActivityIndicator Grid.Row="0" Grid.RowSpan="3"
                           IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           Color="{DynamicResource Theme_Ocean_Dust}" />
    </Grid>
</ContentPage>
