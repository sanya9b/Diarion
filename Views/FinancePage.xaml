                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                        <Entry Grid.Column="0" Text="{Binding NewTransferNote}" Placeholder="{localization:Translate Key=NotePlaceholder}" BackgroundColor="Transparent" TextColor="{DynamicResource Theme_Midnight_Snow}" FontSize="14" VerticalOptions="Center" />
                        <DatePicker Grid.Column="1" Date="{Binding NewTransferDate}" TextColor="{DynamicResource Theme_Midnight_Snow}" BackgroundColor="Transparent" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" Format="dd.MM.yyyy" />
                    </Grid>

                    <Label Text="{Binding TransferError}" IsVisible="{Binding HasTransferError}" FontSize="12" TextColor="{DynamicResource Theme_Coral}" />

                    <Button Text="{localization:Translate Key=SaveButton}"
                            Command="{Binding SaveTransferCommand}"
                            CornerRadius="12"
                            Padding="16,10"
                            Margin="0,4,0,0"
                            BackgroundColor="{DynamicResource Theme_Midnight_Snow}"
                            TextColor="{DynamicResource Theme_Snow_Midnight}"
                            FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Planned (recurring) rule form overlay -->
        <Grid Grid.RowSpan="2"
              BackgroundColor="{DynamicResource Theme_Val_99000000_B3000000}"
              IsVisible="{Binding IsRecurringFormVisible}"
              InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding HideRecurringFormCommand}" />
            </Grid.GestureRecognizers>

            <Border StrokeShape="RoundRectangle 24"
                    StrokeThickness="1"
                    Stroke="{DynamicResource Theme_Dust_Ocean}"
                    BackgroundColor="{DynamicResource Theme_Snow_Midnight}"
                    Padding="20,16"
                    Margin="24"
                    VerticalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource Theme_Midnight}" Offset="0,4" Radius="10" Opacity="0.2" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="10">
                    <Label Text="{localization:Translate Key=PlannedFormTitle}" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource Theme_Midnight_Snow}" />

                    <!-- Income / expense -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{DynamicResource Theme_Dust_Ocean}" Padding="12,8">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsRecurringExpenseSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Coral}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetRecurringTypeCommand}" CommandParameter="Expense" />
                            </Border.GestureRecognizers>
                            <Label Text="{localization:Translate Key=ExpenseLabel}" HorizontalOptions="Center" FontAttributes="Bold" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                        </Border>
                        <Border Grid.Column="1" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{DynamicResource Theme_Dust_Ocean}" Padding="12,8">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsRecurringIncomeSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Sage}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetRecurringTypeCommand}" CommandParameter="Income" />
                            </Border.GestureRecognizers>
                            <Label Text="{localization:Translate Key=IncomeLabel}" HorizontalOptions="Center" FontAttributes="Bold" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                        </Border>
                    </Grid>

                    <Entry Text="{Binding NewRecurringAmountText}" Placeholder="{localization:Translate Key=AmountPlaceholder}" Keyboard="Numeric" BackgroundColor="Transparent" TextColor="{DynamicResource Theme_Midnight_Snow}" FontSize="15" />
                    <Entry Text="{Binding NewRecurringCategory}" Placeholder="{localization:Translate Key=CategoryPlaceholder}" BackgroundColor="Transparent" TextColor="{DynamicResource Theme_Midnight_Snow}" FontSize="15" />
                    <Entry Text="{Binding NewRecurringNote}" Placeholder="{localization:Translate Key=NotePlaceholder}" BackgroundColor="Transparent" TextColor="{DynamicResource Theme_Midnight_Snow}" FontSize="14" />

                    <!-- Recurrence kind -->
                    <Label Text="{localization:Translate Key=PlannedRepeatLabel}" FontSize="12" FontAttributes="Bold" CharacterSpacing="1.5" TextTransform="Uppercase" TextColor="{DynamicResource Theme_Ocean_Dust}" Margin="0,4,0,0" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{DynamicResource Theme_Dust_Ocean}" Padding="10,8">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsRecurringMonthly}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Ocean_Ocean}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetRecurringKindCommand}" CommandParameter="MonthlyByDay" />
                            </Border.GestureRecognizers>
                            <Label Text="{localization:Translate Key=MonthLabel}" HorizontalOptions="Center" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                        </Border>
                        <Border Grid.Column="1" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{DynamicResource Theme_Dust_Ocean}" Padding="10,8">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsRecurringWeekly}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Ocean_Ocean}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetRecurringKindCommand}" CommandParameter="Weekly" />
                            </Border.GestureRecognizers>
                            <Label Text="{localization:Translate Key=HabitScheduleTimesPerWeek}" HorizontalOptions="Center" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                        </Border>
                        <Border Grid.Column="2" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{DynamicResource Theme_Dust_Ocean}" Padding="10,8">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsRecurringDaily}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Ocean_Ocean}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetRecurringKindCommand}" CommandParameter="Daily" />
                            </Border.GestureRecognizers>
                            <Label Text="{localization:Translate Key=HabitScheduleDaily}" HorizontalOptions="Center" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                        </Border>
                    </Grid>

                    <!-- The start date also sets the day-of-month / weekday the rule lands on. -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                        <Label Grid.Column="0" Text="{localization:Translate Key=PlannedStartsOnLabel}" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" VerticalOptions="Center" />
                        <DatePicker Grid.Column="1" Date="{Binding NewRecurringStartDate}" TextColor="{DynamicResource Theme_Midnight_Snow}" BackgroundColor="Transparent" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" Format="dd.MM.yyyy" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                            <Label Text="{localization:Translate Key=PlannedAutoPostLabel}" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            <Label Text="{localization:Translate Key=PlannedAutoPostHint}" FontSize="11" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding NewRecurringAutoPost}" OnColor="{DynamicResource Theme_Sage}" VerticalOptions="Center" />
                    </Grid>

                    <Label Text="{Binding RecurringError}" IsVisible="{Binding HasRecurringError}" FontSize="12" TextColor="{DynamicResource Theme_Coral}" />

                    <Button Text="{localization:Translate Key=SaveButton}"
                            Command="{Binding SaveRecurringRuleCommand}"
                            CornerRadius="12"
                            Padding="16,10"
                            Margin="0,4,0,0"
                            BackgroundColor="{DynamicResource Theme_Midnight_Snow}"
                            TextColor="{DynamicResource Theme_Snow_Midnight}"
                            FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>