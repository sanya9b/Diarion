<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:Diarion.Resources.Localization;assembly=Diarion.Core"
             xmlns:viewModels="clr-namespace:Diarion.ViewModels;assembly=Diarion.Core"
             xmlns:models="clr-namespace:Diarion.Models;assembly=Diarion.Core"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:selectors="clr-namespace:Diarion.Selectors"
             x:Class="Diarion.Views.FinancePage"
             x:Name="RootPage"
             x:DataType="viewModels:FinanceViewModel"
             Shell.PresentationMode="ModalAnimated"
             Title="{localization:Translate Key=FinanceTitle}"
             BackgroundColor="{DynamicResource Theme_Earth_Midnight}">

    <ContentPage.Resources>
        <DataTemplate x:Key="FeedTransactionTemplate" x:DataType="viewModels:TransactionFeedItem">
            <Border Padding="14,8"
                    Margin="24,0"
                    StrokeThickness="1"
                    Stroke="{DynamicResource Theme_Dust_Ocean}"
                    BackgroundColor="{DynamicResource Theme_Snow_Black}"
                    StrokeShape="RoundRectangle 14">
                <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8" VerticalOptions="Center">
                    <!-- Marks a row a rule posted, so an unexpected entry is traceable to its plan. -->
                    <Label Grid.Column="0"
                           Text="⟳"
                           FontSize="12"
                           VerticalOptions="Center"
                           IsVisible="{Binding IsFromPlan}"
                           TextColor="{DynamicResource Theme_Ocean_Dust}"
                           SemanticProperties.Description="{x:Static localization:AppResources.PlannedTransactionsLabel}" />

                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="{Binding Model.Category}" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                        <Label Text="{Binding Model.Note}" FontSize="12" LineBreakMode="TailTruncation" TextColor="{DynamicResource Theme_Ocean_Dust}" IsVisible="{Binding Model.Note, Converter={toolkit:IsStringNotNullOrWhiteSpaceConverter}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center" HorizontalOptions="End">
                        <Label FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="End">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Model.Type}" Value="Income">
                                    <Setter Property="Text" Value="{Binding Model.Amount, StringFormat='+{0:N2}'}" />
                                    <Setter Property="TextColor" Value="{DynamicResource Theme_Sage}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Model.Type}" Value="Expense">
                                    <Setter Property="Text" Value="{Binding Model.Amount, StringFormat='-{0:N2}'}" />
                                    <Setter Property="TextColor" Value="{DynamicResource Theme_Coral}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="{Binding Model.Date, StringFormat='{0:dd.MM.yyyy}'}" FontSize="10" HorizontalTextAlignment="End" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                    </VerticalStackLayout>

                    <Grid Grid.Column="3" ColumnDefinitions="Auto, Auto" ColumnSpacing="12" BackgroundColor="Transparent" Padding="8,4" VerticalOptions="Center">
                        <Grid Grid.Column="0">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.EditTransactionCommand}" CommandParameter="{Binding Model}" />
                            </Grid.GestureRecognizers>
                            <Label Text="✏️" FontSize="14" InputTransparent="True" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.DeleteTransactionCommand}" CommandParameter="{Binding Model}" />
                            </Grid.GestureRecognizers>
                            <Label Text="✕" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource Theme_Coral}" InputTransparent="True" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FeedTransferTemplate" x:DataType="viewModels:TransferFeedItem">
            <Border Padding="14,8"
                    Margin="24,0"
                    StrokeThickness="1"
                    Stroke="{DynamicResource Theme_Dust_Ocean}"
                    BackgroundColor="{DynamicResource Theme_Snow_Black}"
                    StrokeShape="RoundRectangle 14">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="⇄" FontSize="13" VerticalOptions="Center" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource Theme_Midnight_Snow}" LineBreakMode="TailTruncation">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding FromName}" />
                                    <Span Text=" → " />
                                    <Span Text="{Binding ToName}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Text="{Binding Note}" FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" LineBreakMode="TailTruncation" IsVisible="{Binding Note, Converter={toolkit:IsStringNotNullOrWhiteSpaceConverter}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center" HorizontalOptions="End">
                        <Label Text="{Binding AmountText}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource Theme_Ocean_Dust}" HorizontalTextAlignment="End" />
                        <Label Text="{Binding DateText}" FontSize="10" TextColor="{DynamicResource Theme_Ocean_Dust}" HorizontalTextAlignment="End" />
                    </VerticalStackLayout>

                    <Grid Grid.Column="3" BackgroundColor="Transparent" Padding="8,4" VerticalOptions="Center">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.DeleteTransferCommand}" CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        <Label Text="✕" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource Theme_Coral}" InputTransparent="True" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FeedPlannedTemplate" x:DataType="viewModels:PlannedFeedItem">
            <Border Padding="14,8"
                    Margin="24,0"
                    StrokeThickness="1"
                    Stroke="{DynamicResource Theme_Sage}"
                    BackgroundColor="{DynamicResource Theme_Snow_Black}"
                    StrokeShape="RoundRectangle 14">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="⏳" FontSize="13" VerticalOptions="Center" />

                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="{Binding Category}" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                        <Label Text="{Binding RecurrenceText}" FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center" HorizontalOptions="End">
                        <Label FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="End" TextColor="{DynamicResource Theme_Ocean_Dust}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsExpense}" Value="True">
                                    <Setter Property="Text" Value="{Binding AmountText, StringFormat='-{0}'}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsExpense}" Value="False">
                                    <Setter Property="Text" Value="{Binding AmountText, StringFormat='+{0}'}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="{Binding DateText}" FontSize="10" HorizontalTextAlignment="End" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                    </VerticalStackLayout>

                    <Grid Grid.Column="3" ColumnDefinitions="Auto,Auto" ColumnSpacing="12" BackgroundColor="Transparent" Padding="8,4" VerticalOptions="Center">
                        <Grid Grid.Column="0">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.ConfirmPlannedCommand}" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Label Text="✓" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource Theme_Sage}" InputTransparent="True"
                                   SemanticProperties.Description="{x:Static localization:AppResources.PlannedConfirmButton}" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.SkipPlannedCommand}" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Label Text="✕" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource Theme_Coral}" InputTransparent="True"
                                   SemanticProperties.Description="{x:Static localization:AppResources.PlannedSkipButton}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <selectors:FinanceFeedTemplateSelector x:Key="FeedTemplateSelector"
                                               TransactionTemplate="{StaticResource FeedTransactionTemplate}"
                                               TransferTemplate="{StaticResource FeedTransferTemplate}"
                                               PlannedTemplate="{StaticResource FeedPlannedTemplate}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Grid Padding="24,18,24,6" ColumnDefinitions="Auto,*,Auto">
            <Grid Grid.Column="0" Padding="10" BackgroundColor="Transparent" VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseTapped" />
                </Grid.GestureRecognizers>
                <Label Text="✕" FontSize="22" InputTransparent="True" SemanticProperties.Description="{x:Static localization:AppResources.CloseButtonLabel}" TextColor="{DynamicResource Theme_Midnight_Snow}" />
            </Grid>

            <VerticalStackLayout Grid.Column="1" Spacing="4">
                <Label Text="{localization:Translate Key=FinanceTitle}" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{DynamicResource Theme_Midnight_Snow}" />
            </VerticalStackLayout>

            <ActivityIndicator Grid.Column="2"
                               WidthRequest="28"
                               HeightRequest="28"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{DynamicResource Theme_Sage}"
                               VerticalOptions="Center" />
        </Grid>

        <!-- Virtualized list: balance summary + add button in the header, feed rows recycled. One stream
             for transactions, transfers and pending plans so they read in date order instead of by kind. -->
        <CollectionView Grid.Row="1" BackgroundColor="Transparent" ItemsSource="{Binding Feed}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout Padding="24,10,24,4" Spacing="18">
                    <!-- Рахунки (селектор + керування) -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" BackgroundColor="Transparent">
                        <HorizontalStackLayout Spacing="8">
                            <!-- Всі -->
                            <Border StrokeShape="RoundRectangle 14" Padding="12,6" StrokeThickness="1" Stroke="{DynamicResource Theme_Dust_Ocean}" BackgroundColor="{DynamicResource Theme_Snow_Black}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectAllAccountsCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsAllAccountsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Midnight_Snow}" />
                                        <Setter Property="Stroke" Value="{DynamicResource Theme_Midnight_Snow}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{localization:Translate Key=AllAccounts}" FontSize="13" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsAllAccountsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource Theme_Snow_Midnight}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsAllAccountsSelected}" Value="False">
                                            <Setter Property="TextColor" Value="{DynamicResource Theme_Midnight_Snow}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <!-- Рахунки -->
                            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Accounts}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:AccountItemViewModel">
                                        <Border StrokeShape="RoundRectangle 14" Padding="12,6" StrokeThickness="1" Stroke="{DynamicResource Theme_Dust_Ocean}" BackgroundColor="{DynamicResource Theme_Snow_Black}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.SelectAccountCommand}" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Midnight_Snow}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource Theme_Midnight_Snow}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsArchived}" Value="True">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding Icon}" FontSize="13" VerticalOptions="Center" />
                                                <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="TailTruncation">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="TextColor" Value="{DynamicResource Theme_Snow_Midnight}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                            <Setter Property="TextColor" Value="{DynamicResource Theme_Midnight_Snow}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>

                            <!-- Редагувати обраний -->
                            <Border StrokeShape="RoundRectangle 14" Padding="12,6" StrokeThickness="1" Stroke="{DynamicResource Theme_Dust_Ocean}" BackgroundColor="{DynamicResource Theme_Snow_Black}"
                                    IsVisible="{Binding IsAllAccountsSelected, Converter={toolkit:InvertedBoolConverter}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding EditSelectedAccountCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="✎" FontSize="14" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                            </Border>

                            <!-- Додати рахунок -->
                            <Border StrokeShape="RoundRectangle 14" Padding="12,6" StrokeThickness="1" Stroke="{DynamicResource Theme_Sage}" BackgroundColor="{DynamicResource Theme_Snow_Black}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowAccountFormCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="＋" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource Theme_Sage}"
                                       SemanticProperties.Description="{x:Static localization:AppResources.AddAccountButton}" />
                            </Border>

                            <!-- Показати архівні -->
                            <Border StrokeShape="RoundRectangle 14" Padding="12,6" StrokeThickness="1" Stroke="{DynamicResource Theme_Dust_Ocean}" BackgroundColor="{DynamicResource Theme_Snow_Black}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleShowArchivedAccountsCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding ShowArchivedAccounts}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Midnight_Snow}" />
                                        <Setter Property="Stroke" Value="{DynamicResource Theme_Midnight_Snow}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{localization:Translate Key=ShowArchivedAccountsButton}" FontSize="13">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding ShowArchivedAccounts}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource Theme_Snow_Midnight}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding ShowArchivedAccounts}" Value="False">
                                            <Setter Property="TextColor" Value="{DynamicResource Theme_Ocean_Dust}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Картка балансу -->
                    <Border Padding="20"
                            StrokeThickness="0"
                            BackgroundColor="{DynamicResource Theme_Sage}"
                            StrokeShape="RoundRectangle 20">
                        <Border.Shadow>
                            <Shadow Brush="{DynamicResource Theme_Sage}" Offset="0,6" Radius="12" Opacity="0.3" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="{localization:Translate Key=TotalBalanceLabel}" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource Theme_Snow}" HorizontalOptions="Center" />
                            <Label Text="{Binding TotalBalance, StringFormat='{0:N2}'}" FontSize="36" FontAttributes="Bold" TextColor="{DynamicResource Theme_Snow}" HorizontalOptions="Center" Margin="0,0,0,12" />

                            <Grid ColumnDefinitions="*, Auto, *" ColumnSpacing="16">
                                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                                    <Label Text="{localization:Translate Key=MonthIncomeLabel}" FontSize="10" TextColor="{DynamicResource Theme_Snow}" Opacity="0.8" HorizontalOptions="Center" />
                                    <Label Text="{Binding MonthIncome, StringFormat='+{0:N2}'}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource Theme_Snow}" HorizontalOptions="Center" />
                                </VerticalStackLayout>

                                <BoxView Grid.Column="1" WidthRequest="1" BackgroundColor="{DynamicResource Theme_Snow}" Opacity="0.3" VerticalOptions="Fill" />

                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                                    <Label Text="{localization:Translate Key=MonthExpenseLabel}" FontSize="10" TextColor="{DynamicResource Theme_Snow}" Opacity="0.8" HorizontalOptions="Center" />
                                    <Label Text="{Binding MonthExpense, StringFormat='-{0:N2}'}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource Theme_Snow}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Кнопка додавання -->
                    <Button Text="{localization:Translate Key=AddTransactionButton}"
                            Command="{Binding ToggleAddTransactionCommand}"
                            CornerRadius="12"
                            Padding="16,12"
                            BackgroundColor="{DynamicResource Theme_Midnight_Snow}"
                            TextColor="{DynamicResource Theme_Snow_Midnight}"
                            FontAttributes="Bold" />

                    <!-- Бюджети (горизонтальна смуга віджетів) -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowBudgets}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{localization:Translate Key=BudgetsLabel}" FontSize="12" FontAttributes="Bold" CharacterSpacing="1.5" TextTransform="Uppercase" TextColor="{DynamicResource Theme_Ocean_Dust}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{localization:Translate Key=AddBudgetButton}" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource Theme_Sage}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowBudgetFormCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" IsVisible="{Binding HasBudgets}">
                            <HorizontalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Budgets}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:BudgetItemViewModel">
                                        <Border WidthRequest="140" StrokeThickness="1" Stroke="{DynamicResource Theme_Dust_Ocean}" BackgroundColor="{DynamicResource Theme_Snow_Black}" StrokeShape="RoundRectangle 16" Padding="12,10">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.ShowCategoryDetailCommand}" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="6">
                                                <Label Text="{Binding Category}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource Theme_Midnight_Snow}" LineBreakMode="TailTruncation" />
                                                <ProgressBar Progress="{Binding Progress}">
                                                    <ProgressBar.Triggers>
                                                        <DataTrigger TargetType="ProgressBar" Binding="{Binding IsOverspent}" Value="True">
                                                            <Setter Property="ProgressColor" Value="{DynamicResource Theme_Coral}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="ProgressBar" Binding="{Binding IsOverspent}" Value="False">
                                                            <Setter Property="ProgressColor" Value="{DynamicResource Theme_Sage}" />
                                                        </DataTrigger>
                                                    </ProgressBar.Triggers>
                                                </ProgressBar>
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Label Grid.Column="0" Text="{Binding ProgressPercentText}" FontSize="12" FontAttributes="Bold">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsOverspent}" Value="True">
                                                                <Setter Property="TextColor" Value="{DynamicResource Theme_Coral}" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsOverspent}" Value="False">
                                                                <Setter Property="TextColor" Value="{DynamicResource Theme_Sage}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                    <Label Grid.Column="1" Text="{Binding AmountText}" FontSize="9" TextColor="{DynamicResource Theme_Ocean_Dust}" HorizontalTextAlignment="End" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <!-- Перекази і плани: тільки кнопки додавання. Самі рядки живуть у спільній стрічці. -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Label Grid.Column="0" Text="{localization:Translate Key=AddTransferButton}" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource Theme_Sage}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowTransferFormCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Grid.Column="2" Text="{localization:Translate Key=AddPlannedButton}" FontSize="12" FontAttributes="Bold" IsVisible="{Binding ShowPlanned}" TextColor="{DynamicResource Theme_Sage}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowRecurringFormCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <StaticResource Key="FeedTemplateSelector" />
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- Popup Overlay -->
        <Grid Grid.RowSpan="2"
              BackgroundColor="{DynamicResource Theme_Val_99000000_B3000000}"
              IsVisible="{Binding IsAddTransactionVisible}"
              InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleAddTransactionCommand}" />
            </Grid.GestureRecognizers>

            <Border StrokeShape="RoundRectangle 24"
                    StrokeThickness="1"
                    Stroke="{DynamicResource Theme_Dust_Ocean}"
                    BackgroundColor="{DynamicResource Theme_Snow_Midnight}"
                    Padding="20,16"
                    Margin="24"
                    VerticalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource Theme_Midnight}" Offset="0,4" Radius="10" Opacity="0.2" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <Label FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource Theme_Midnight_Snow}" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Text" Value="{localization:Translate Key=EditTransactionTitle}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsEditing}" Value="False">
                                    <Setter Property="Text" Value="{localization:Translate Key=AddTransactionButton}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Grid Grid.Column="1" Padding="8,0,0,8">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleAddTransactionCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="✕" FontSize="20" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                        </Grid>
                    </Grid>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                        <Border Grid.Column="0" StrokeThickness="1" Padding="6" StrokeShape="RoundRectangle 8" BackgroundColor="Transparent">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsIncomeTypeSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource Theme_Sage}" />
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Sage}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsIncomeTypeSelected}" Value="False">
                                    <Setter Property="Stroke" Value="{DynamicResource Theme_Dust_Ocean}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetTransactionTypeCommand}" CommandParameter="Income" />
                            </Border.GestureRecognizers>
                            <Label Text="{localization:Translate Key=IncomeLabel}" HorizontalOptions="Center" FontAttributes="Bold" FontSize="13">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsIncomeTypeSelected}" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource Theme_Snow}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsIncomeTypeSelected}" Value="False">
                                        <Setter Property="TextColor" Value="{DynamicResource Theme_Ocean_Dust}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>

                        <Border Grid.Column="1" StrokeThickness="1" Padding="6" StrokeShape="RoundRectangle 8" BackgroundColor="Transparent">
