<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:Diarion.Resources.Icons;assembly=Diarion.Core"
             xmlns:viewmodels="clr-namespace:Diarion.ViewModels;assembly=Diarion.Core"
             xmlns:localization="clr-namespace:Diarion.Resources.Localization;assembly=Diarion.Core"
             x:Class="Diarion.Views.LockPage"
             x:DataType="viewmodels:LockViewModel"
             BackgroundColor="{DynamicResource Theme_Earth_Midnight}"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*, Auto, Auto, *" Padding="32">

        <!-- Header + PIN dots -->
        <VerticalStackLayout Grid.Row="1" Spacing="18" VerticalOptions="End" HorizontalOptions="Center">
            <Path Data="{x:Static icons:AppIcons.Lock}" WidthRequest="44" HeightRequest="44" Stroke="{DynamicResource Theme_Midnight_Snow}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform" InputTransparent="True" HorizontalOptions="Center" />
            <Label Text="{x:Static localization:AppResources.EnterPinTitle}"
                   FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"
                   TextColor="{DynamicResource Theme_Midnight_Snow}" />
            <Label Text="{Binding PinDisplay}"
                   FontSize="34" CharacterSpacing="10" HorizontalOptions="Center"
                   TextColor="{DynamicResource Theme_Midnight_Snow}" />
            <Label Text="{Binding ErrorMessage}"
                   FontSize="13" HorizontalOptions="Center" MinimumHeightRequest="18"
                   TextColor="{DynamicResource Theme_Coral}" />
        </VerticalStackLayout>

        <!-- Numeric keypad -->
        <Grid Grid.Row="2" Margin="0,32,0,0"
              ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
              ColumnSpacing="20" RowSpacing="20" HorizontalOptions="Center">

            <Button Grid.Row="0" Grid.Column="0" Text="1" Style="{StaticResource PinKey}" Command="{Binding EnterDigitCommand}" CommandParameter="1" />
            <Button Grid.Row="0" Grid.Column="1" Text="2" Style="{StaticResource PinKey}" Command="{Binding EnterDigitCommand}" CommandParameter="2" />
            <Button Grid.Row="0" Grid.Column="2" Text="3" Style="{StaticResource PinKey}" Command="{Binding EnterDigitCommand}" CommandParameter="3" />

            <Button Grid.Row="1" Grid.Column="0" Text="4" Style="{StaticResource PinKey}" Command="{Binding EnterDigitCommand}" CommandParameter="4" />
            <Button Grid.Row="1" Grid.Column="1" Text="5" Style="{StaticResource PinKey}" Command="{Binding EnterDigitCommand}" CommandParameter="5" />
            <Button Grid.Row="1" Grid.Column="2" Text="6" Style="{StaticResource PinKey}" Command="{Binding EnterDigitCommand}" CommandParameter="6" />

            <Button Grid.Row="2" Grid.Column="0" Text="7" Style="{StaticResource PinKey}" Command="{Binding EnterDigitCommand}" CommandParameter="7" />
            <Button Grid.Row="2" Grid.Column="1" Text="8" Style="{StaticResource PinKey}" Command="{Binding EnterDigitCommand}" CommandParameter="8" />
            <Button Grid.Row="2" Grid.Column="2" Text="9" Style="{StaticResource PinKey}" Command="{Binding EnterDigitCommand}" CommandParameter="9" />

            <!-- Biometric (only when available) -->
            <Button Grid.Row="3" Grid.Column="0"
                    Style="{StaticResource PinKey}"
                    BackgroundColor="Transparent" BorderWidth="0"
                    IsVisible="{Binding IsBiometricAvailable}"
                    Command="{Binding TryBiometricCommand}"
                    SemanticProperties.Description="{x:Static localization:AppResources.UnlockWithBiometricsButton}" />
            <!-- Drawn over the button rather than typed into it: a Button can only show text, and the
                 pointing-hand emoji was a colour glyph on a monochrome keypad. The button keeps the tap
                 and the screen-reader name. -->
            <Path Grid.Row="3" Grid.Column="0" IsVisible="{Binding IsBiometricAvailable}" Data="{x:Static icons:AppIcons.Fingerprint}" WidthRequest="28" HeightRequest="28" Stroke="{DynamicResource Theme_Midnight_Snow}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform" InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" />

            <Button Grid.Row="3" Grid.Column="1" Text="0" Style="{StaticResource PinKey}" Command="{Binding EnterDigitCommand}" CommandParameter="0" />

            <Button Grid.Row="3" Grid.Column="2" Text="⌫"
                    Style="{StaticResource PinKey}"
                    BackgroundColor="Transparent" BorderWidth="0"
                    Command="{Binding DeleteDigitCommand}"
                    SemanticProperties.Description="{x:Static localization:AppResources.DeleteButtonLabel}" />
        </Grid>
    </Grid>
</ContentPage>
