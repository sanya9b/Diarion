<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:Diarion.Resources.Localization;assembly=Diarion.Core"
             xmlns:viewModels="clr-namespace:Diarion.ViewModels;assembly=Diarion.Core"
             xmlns:views="clr-namespace:Diarion.Views"
             x:Class="Diarion.Views.HappyMomentsPage"
             x:Name="RootPage"
             x:DataType="viewModels:HappyMomentsViewModel"
             Shell.PresentationMode="ModalAnimated"
             Title="{localization:Translate Key=HappyMomentsTitle}"
             BackgroundColor="{DynamicResource Theme_Earth_Midnight}">

    <Grid RowDefinitions="Auto,*">
        <Grid Padding="24,18,24,6" ColumnDefinitions="Auto,*,Auto">
            <Grid Grid.Column="0" Padding="10" BackgroundColor="Transparent" VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseTapped" />
                </Grid.GestureRecognizers>
                <Label Text="✕" FontSize="22" InputTransparent="True" TextColor="{DynamicResource Theme_Midnight_Snow}" />
            </Grid>

            <VerticalStackLayout Grid.Column="1" Spacing="4">
                <Label Text="{localization:Translate Key=HappyMomentsTitle}" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                <Label Text="{localization:Translate Key=HappyMomentsSubtitle}" FontSize="12" HorizontalTextAlignment="Center" TextColor="{DynamicResource Theme_Ocean_Dust}" />
            </VerticalStackLayout>

            <ActivityIndicator Grid.Column="2"
                               WidthRequest="28"
                               HeightRequest="28"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{DynamicResource Theme_Berry}"
                               VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,10,24,32" Spacing="18">
                <FlexLayout BindableLayout.ItemsSource="{Binding MomentSlots}" Wrap="Wrap" JustifyContent="Center" AlignItems="Start" AlignContent="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:HappyMomentSlotItemViewModel">
                            <Grid Margin="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.SelectSlotCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                
                                <!-- Filled State (Polaroid 3D Vector) -->
                                <views:HappyMomentsItem IsVisible="{Binding IsFilled}" />
                                
                                <!-- Empty State -->
                                <Border IsVisible="{Binding IsEmpty}"
                                        WidthRequest="120" HeightRequest="160"
                                        StrokeThickness="1.5"
                                        Stroke="{DynamicResource Theme_Dust_Ocean}"
                                        BackgroundColor="{DynamicResource Theme_Snow_Midnight}"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeDashArray="6,6">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource Theme_Berry}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Setter Property="StrokeDashArray" Value="" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                                        <Label Text="+"
                                               FontSize="32"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               TextColor="{DynamicResource Theme_Berry}" />
                                        <Label Text="{Binding SlotCaption}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{DynamicResource Theme_Ocean_Dust}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Popup Overlay -->
        <Grid Grid.RowSpan="2"
              BackgroundColor="{DynamicResource Theme_Val_99000000_B3000000}"
              IsVisible="{Binding IsAddMomentFormVisible}"
              InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SelectSlotCommand}" CommandParameter="{Binding SelectedEmptySlot}" />
            </Grid.GestureRecognizers>

            <Border StrokeShape="RoundRectangle 24"
                    StrokeThickness="1"
                    Stroke="{DynamicResource Theme_Berry}"
                    BackgroundColor="{DynamicResource Theme_Snow_Midnight}"
                    Padding="24"
                    Margin="24"
                    VerticalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource Theme_Midnight}" Offset="0,4" Radius="10" Opacity="0.2" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,8">
                        <Border WidthRequest="42"
                                HeightRequest="42"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{DynamicResource Theme_Berry}">
                            <Label Text="✦"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextColor="{DynamicResource Theme_Snow}" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{localization:Translate Key=HappyMomentsFormTitle}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            <Label Text="{Binding SelectedEmptySlot.SlotCaption}"
                                   FontSize="12"
                                   TextColor="{DynamicResource Theme_Ocean_Dust}" />
                        </VerticalStackLayout>

                        <!-- Close Button -->
                        <Grid Grid.Column="2" VerticalOptions="Start" Padding="8,0,0,8">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectSlotCommand}" CommandParameter="{Binding SelectedEmptySlot}" />
                            </Grid.GestureRecognizers>
                            <Label Text="✕" FontSize="20" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                        </Grid>
                    </Grid>

                    <Label Text="{localization:Translate Key=HappyMomentsTitleLabel}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource Theme_Midnight_Snow}" />
                    <Editor Text="{Binding NewMomentTitle}"
                            Placeholder="{localization:Translate Key=HappyMomentsTitlePlaceholder}"
                            AutoSize="TextChanges"
                            TextColor="{DynamicResource Theme_Midnight_Snow}"
                            PlaceholderColor="{DynamicResource Theme_Dust_Ocean}" />

                    <Label Text="{localization:Translate Key=HappyMomentsDateLabel}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource Theme_Midnight_Snow}" />
                    <DatePicker Date="{Binding NewMomentDate}"
                                MaximumDate="{Binding MaxMomentDate}"
                                TextColor="{DynamicResource Theme_Midnight_Snow}" />

                    <Label Text="{Binding ValidationMessage}"
                           IsVisible="{Binding HasValidationMessage}"
                           FontSize="12"
                           TextColor="{DynamicResource Theme_Coral}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <Button Grid.Column="0"
                                Text="{localization:Translate Key=DeleteButton}"
                                Command="{Binding DeleteSelectedMomentCommand}"
                                IsVisible="{Binding SelectedEmptySlot.IsFilled}"
                                CornerRadius="18"
                                Padding="18,12"
                                BackgroundColor="Transparent"
                                BorderColor="{DynamicResource Theme_Coral}"
                                BorderWidth="1"
                                TextColor="{DynamicResource Theme_Coral}"
                                FontAttributes="Bold" />
                                
                        <Button Grid.Column="1"
                                Text="{localization:Translate Key=HappyMomentsSaveButton}"
                                Command="{Binding SaveSelectedMomentCommand}"
                                IsVisible="{Binding SelectedEmptySlot.IsFilled}"
                                CornerRadius="18"
                                Padding="18,12"
                                BackgroundColor="{DynamicResource Theme_Berry}"
                                TextColor="{DynamicResource Theme_Snow}"
                                FontAttributes="Bold" />

                        <Button Grid.Column="0" Grid.ColumnSpan="2"
                                Text="{localization:Translate Key=HappyMomentsSaveButton}"
                                Command="{Binding SaveSelectedMomentCommand}"
                                IsVisible="{Binding SelectedEmptySlot.IsEmpty}"
                                CornerRadius="18"
                                Padding="18,12"
                                BackgroundColor="{DynamicResource Theme_Berry}"
                                TextColor="{DynamicResource Theme_Snow}"
                                FontAttributes="Bold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
