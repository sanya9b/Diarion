<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:Diarion.Resources.Icons;assembly=Diarion.Core"
             xmlns:behaviors="clr-namespace:Diarion.Behaviors"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             xmlns:viewmodels="clr-namespace:Diarion.ViewModels;assembly=Diarion.Core"
             xmlns:localization="clr-namespace:Diarion.Resources.Localization;assembly=Diarion.Core"
             xmlns:controls="clr-namespace:Diarion.Controls"
             xmlns:models="clr-namespace:Diarion.Models;assembly=Diarion.Core"
             x:Class="Diarion.Views.ProfilePage"
             x:DataType="viewmodels:ProfileViewModel"
             Title="{Binding Title}"
             BackgroundColor="{DynamicResource Theme_Earth_Midnight}">

    <!-- The grid exists for the guide layer alone: it has to sit over the scroller, not inside it,
         or it would scroll away with the content it is explaining. -->
    <Grid>
    <ScrollView x:Name="PageScroll">
        <VerticalStackLayout Padding="24,18,24,32" Spacing="20">

            <Grid Margin="0,0,0,8">
                <!-- Заголовок -->
                <Label Text="{Binding Title}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{DynamicResource Theme_Midnight_Snow}" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource Theme_Ocean_Dust}" />

            <!-- Segmented tab bar -->
            <Border x:Name="TabsAnchor"
                    StrokeShape="RoundRectangle 14" StrokeThickness="1"
                    Stroke="{DynamicResource Theme_Dust_Ocean}"
                    BackgroundColor="{DynamicResource Theme_Snow_Black}"
                    Padding="4">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                    <!-- Profile tab -->
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="Transparent" Padding="0,10">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsProfileTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Ocean_Ocean}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="0" />
                        </Border.GestureRecognizers>
                        <Label Text="{x:Static localization:AppResources.SettingsTabProfile}" InputTransparent="True" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsProfileTab}" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource Theme_Snow}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsProfileTab}" Value="False">
                                    <Setter Property="TextColor" Value="{DynamicResource Theme_Midnight_Snow}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                    <!-- Screen tab -->
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="Transparent" Padding="0,10">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsScreenTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Ocean_Ocean}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="1" />
                        </Border.GestureRecognizers>
                        <Label Text="{x:Static localization:AppResources.SettingsTabScreen}" InputTransparent="True" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsScreenTab}" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource Theme_Snow}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsScreenTab}" Value="False">
                                    <Setter Property="TextColor" Value="{DynamicResource Theme_Midnight_Snow}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                    <!-- Data tab -->
                    <Border Grid.Column="2" StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="Transparent" Padding="0,10">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsDataTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Ocean_Ocean}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="2" />
                        </Border.GestureRecognizers>
                        <Label Text="{x:Static localization:AppResources.SettingsTabData}" InputTransparent="True" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsDataTab}" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource Theme_Snow}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsDataTab}" Value="False">
                                    <Setter Property="TextColor" Value="{DynamicResource Theme_Midnight_Snow}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </Grid>
            </Border>

            <!-- ============ PROFILE TAB ============ -->
            <VerticalStackLayout Spacing="20" IsVisible="{Binding IsProfileTab}">

                <!-- App Customization (Moved from Flyout) -->
                <Border StrokeShape="RoundRectangle 20" StrokeThickness="1"
                        Stroke="{DynamicResource Theme_Dust_Ocean}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        Padding="16">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="{x:Static localization:AppResources.SettingsAppearanceTitle}" FontAttributes="Bold" FontSize="11" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                        <HorizontalStackLayout Spacing="16" HorizontalOptions="Center">
                            <!-- Language Switch -->
                            <Grid HeightRequest="40" WidthRequest="110" VerticalOptions="Center">
                                <Border StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="{DynamicResource Theme_Dust_Ocean}" BackgroundColor="{DynamicResource Theme_Snow_Black}" />
                                <Border x:Name="LangThumb" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="{DynamicResource Theme_Dust_Ocean}" WidthRequest="50" HorizontalOptions="{Binding LangThumbAlignment, Source={RelativeSource AncestorType={x:Type ContentPage}}}" Margin="4" />
                                <Grid ColumnDefinitions="*,*">
                                    <Label Grid.Column="0" Text="EN" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                    <Label Grid.Column="1" Text="UA" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                </Grid>
                                <Button BackgroundColor="Transparent" BorderWidth="0" Clicked="OnToggleLanguageClicked" HorizontalOptions="Fill" VerticalOptions="Fill" ZIndex="10" />
                            </Grid>

                            <!-- Theme Switch -->
                            <Grid HeightRequest="40" WidthRequest="130" VerticalOptions="Center">
                                <Border StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="{DynamicResource Theme_Dust_Ocean}" BackgroundColor="{DynamicResource Theme_Snow_Black}" />
                                <Border x:Name="ThemeThumb" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="{DynamicResource Theme_Dust_Ocean}" WidthRequest="40" HorizontalOptions="{Binding ThemeThumbAlignment, Source={RelativeSource AncestorType={x:Type ContentPage}}}" Margin="4" />
                                <Grid ColumnDefinitions="*,*,*">
                                    <Path Grid.Column="0" Data="{x:Static icons:AppIcons.Sun}" WidthRequest="16" HeightRequest="16" Stroke="{DynamicResource Theme_Midnight_Snow}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform" InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Path Grid.Column="1" Data="{x:Static icons:AppIcons.Moon}" WidthRequest="15" HeightRequest="15" Stroke="{DynamicResource Theme_Midnight_Snow}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform" InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Path Grid.Column="2" Data="{x:Static icons:AppIcons.Blossom}" WidthRequest="16" HeightRequest="16" Stroke="{DynamicResource Theme_Midnight_Snow}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeLineJoin="Round" Aspect="Uniform" InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>
                                <Button BackgroundColor="Transparent" BorderWidth="0" Clicked="OnToggleThemeClicked" HorizontalOptions="Fill" VerticalOptions="Fill" ZIndex="10" />
                            </Grid>
                        </HorizontalStackLayout>

                        <!-- Mood icons (spec 18): what the five faces on the home screen look like. Each icon is
                             its own tap target, so one tap picks a set; no captions on the icons, the chosen
                             set's name sits under the title instead. Its own view model, like the
                             subscription card (ProfilePage.xaml.cs). -->
                        <Grid x:Name="MoodIconSetRow" x:DataType="viewmodels:MoodIconSetViewModel"
                              ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="{x:Static localization:AppResources.MoodIconSetTitle}" FontSize="14" FontAttributes="Bold"
                                       TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                <Label Text="{Binding CurrentName}" FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" HeightRequest="40" WidthRequest="132" VerticalOptions="Center">
                                <Border StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="{DynamicResource Theme_Dust_Ocean}" BackgroundColor="{DynamicResource Theme_Snow_Black}" />
                                <Grid ColumnDefinitions="*,*,*" Padding="4" InputTransparent="True">
                                    <Border Grid.Column="{Binding SelectedIndex}" StrokeShape="RoundRectangle 16" StrokeThickness="0"
                                            BackgroundColor="{DynamicResource Theme_Dust_Ocean}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*">
                                    <Grid Grid.Column="0" BackgroundColor="Transparent"
                                          SemanticProperties.Description="{x:Static localization:AppResources.MoodIconSetEmoji}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectCommand}" CommandParameter="{x:Static models:MoodIconSet.Emoji}" />
                                        </Grid.GestureRecognizers>
                                        <controls:MoodGlyph Quadrant="PleasantEnergetic" IconSet="Emoji" EmojiSize="18"
                                                            WidthRequest="24" HeightRequest="24"
                                                            HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Grid>
                                    <Grid Grid.Column="1" BackgroundColor="Transparent"
                                          SemanticProperties.Description="{x:Static localization:AppResources.MoodIconSetWeather}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectCommand}" CommandParameter="{x:Static models:MoodIconSet.Weather}" />
                                        </Grid.GestureRecognizers>
                                        <controls:MoodGlyph Quadrant="PleasantEnergetic" IconSet="Weather" EmojiSize="18"
                                                            WidthRequest="24" HeightRequest="24"
                                                            HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Grid>
                                    <Grid Grid.Column="2" BackgroundColor="Transparent"
                                          SemanticProperties.Description="{x:Static localization:AppResources.MoodIconSetPlants}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectCommand}" CommandParameter="{x:Static models:MoodIconSet.Plants}" />
                                        </Grid.GestureRecognizers>
                                        <controls:MoodGlyph Quadrant="PleasantEnergetic" IconSet="Plants" EmojiSize="18"
                                                            WidthRequest="24" HeightRequest="24"
                                                            HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Особиста інформація -->
                <Border StrokeShape="RoundRectangle 20" StrokeThickness="1"
                        Stroke="{DynamicResource Theme_Dust_Ocean}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.2" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static localization:AppResources.GeneralInfoLabel}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                        <Grid ColumnDefinitions="80, *" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.NameLabel}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            <Entry Grid.Column="1" Text="{Binding Profile.Name}" Placeholder="{x:Static localization:AppResources.NamePlaceholder}" BackgroundColor="Transparent" FontSize="14" HeightRequest="36" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{DynamicResource Theme_Dust_Ocean}" Opacity="0.5" />

                        <Grid ColumnDefinitions="80, *" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.GenderLabel}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            <Picker Grid.Column="1" ItemsSource="{Binding GenderList}" ItemDisplayBinding="{Binding DisplayName}" SelectedItem="{Binding SelectedGenderItem}" BackgroundColor="Transparent" FontSize="14" HeightRequest="36" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{DynamicResource Theme_Dust_Ocean}" Opacity="0.5" />

                        <!-- Replaced the typed "Age" box on 2026-09-20: a number goes stale every birthday, and
                             the two age gates (intimate life 18+, cycle 14+) need a date to count from. A DatePicker
                             has no empty state, so "not set" is a separate row with a button, and the picker only
                             appears once there is a date to show. -->
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.BirthDateLabel}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />

                            <Label Grid.Column="1" Text="{x:Static localization:AppResources.BirthDateNotSet}" IsVisible="{Binding HasBirthDate, Converter={toolkit:InvertedBoolConverter}}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                            <Button Style="{StaticResource SecondaryButton}" FontSize="13" HeightRequest="36" Padding="14,0" Grid.Column="2" Text="{x:Static localization:AppResources.BirthDateSetAction}" Command="{Binding SetBirthDateCommand}" IsVisible="{Binding HasBirthDate, Converter={toolkit:InvertedBoolConverter}}" />

                            <DatePicker Grid.Column="1" Date="{Binding BirthDateInput}" MinimumDate="{Binding MinimumBirthDate}" MaximumDate="{Binding MaximumBirthDate}" IsVisible="{Binding HasBirthDate}" BackgroundColor="Transparent" FontSize="14" HeightRequest="36" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            <Button Style="{StaticResource GhostButton}" FontSize="18" HeightRequest="36" Padding="0" Grid.Column="2" Text="×" Command="{Binding ClearBirthDateCommand}" IsVisible="{Binding HasBirthDate}" SemanticProperties.Description="{x:Static localization:AppResources.BirthDateClearAction}" WidthRequest="36" />
                        </Grid>
                        <Label Text="{x:Static localization:AppResources.BirthDatePrivacyHint}" FontSize="11" LineBreakMode="WordWrap" TextColor="{DynamicResource Theme_Ocean_Dust}" Margin="0,-4,0,0" />

                        <BoxView HeightRequest="1" Color="{DynamicResource Theme_Dust_Ocean}" Opacity="0.5" />

                        <Grid ColumnDefinitions="80, *, 80, *" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.WeightLabel}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            <Entry Grid.Column="1" Text="{Binding Profile.Weight}" Keyboard="Numeric" Placeholder="0.0" BackgroundColor="Transparent" FontSize="14" HeightRequest="36" />

                            <Label Grid.Column="2" Text="{x:Static localization:AppResources.HeightLabel}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" HorizontalTextAlignment="End" />
                            <Entry Grid.Column="3" Text="{Binding Profile.Height}" Keyboard="Numeric" Placeholder="0" BackgroundColor="Transparent" FontSize="14" HeightRequest="36" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Stands where the cycle card would be while the birth date is unknown (and the gender does
                     not rule the feature out). Once the date is known and under 14, neither card shows. -->
                <Border StrokeShape="RoundRectangle 20" StrokeThickness="1"
                        Stroke="{DynamicResource Theme_Dust_Ocean}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        IsVisible="{Binding Profile.NeedsBirthDateForCycle}"
                        Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static localization:AppResources.MenstrualTrackingTitle}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Coral}" />
                        <Label Text="{x:Static localization:AppResources.CycleAgeHint}" FontSize="13" LineBreakMode="WordWrap" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Менструальний календар (Menstrual Tracker) -->
                <Border StrokeShape="RoundRectangle 20" StrokeThickness="1"
                        Stroke="{DynamicResource Theme_Dust_Ocean}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        IsVisible="{Binding Profile.IsCycleFeatureAvailable}"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.2" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static localization:AppResources.MenstrualTrackingTitle}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Coral}" />

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.EnableTrackingLabel}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            <Switch Grid.Column="1" IsToggled="{Binding Profile.IsMenstrualTrackingEnabled}" VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout Spacing="16" IsVisible="{Binding Profile.IsMenstrualTrackingEnabled}">
                            <BoxView HeightRequest="1" Color="{DynamicResource Theme_Dust_Ocean}" Opacity="0.5" />

                            <Grid ColumnDefinitions="*, 80" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="{x:Static localization:AppResources.CycleLengthLabel}" VerticalOptions="Center" FontSize="13" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                <Entry Grid.Column="1" Text="{Binding Profile.CycleLength}" Keyboard="Numeric" BackgroundColor="Transparent" FontSize="14" HorizontalTextAlignment="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{DynamicResource Theme_Dust_Ocean}" Opacity="0.5" />

                            <Grid ColumnDefinitions="*, 80" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="{x:Static localization:AppResources.PeriodLengthLabel}" VerticalOptions="Center" FontSize="13" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                <Entry Grid.Column="1" Text="{Binding Profile.PeriodLength}" Keyboard="Numeric" BackgroundColor="Transparent" FontSize="14" HorizontalTextAlignment="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{DynamicResource Theme_Dust_Ocean}" Opacity="0.5" />

                            <!-- Recording a period moved to the home screen, the "+ Місячні" chip in the health
                                 block (spec 18). What stays here is the page with the history and forecast. -->
                            <!-- The history, forecast and symptoms live on their own page: it is a handful of
                                 days a month, so it has no business occupying the daily screen. That page is
                                 reachable from here alone, so the row is a row and not dim small print. -->
                            <!-- Padded to a full touch target rather than to the text: at two pixels the row
                                 was a 24dp strip, and a tap that lands a hair above or below it does nothing. -->
                            <Grid behaviors:PressFeedback.IsEnabled="True" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,12" BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCycleCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="{x:Static localization:AppResources.CycleOpenLink}" InputTransparent="True" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" TextColor="{DynamicResource Theme_Coral}" />
                                <Label Grid.Column="1" Text="›" InputTransparent="True" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" TextColor="{DynamicResource Theme_Coral}" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============ SCREEN TAB ============ -->
            <VerticalStackLayout Spacing="20" IsVisible="{Binding IsScreenTab}">

                <!-- Блоки головного екрана (Home screen blocks) -->
                <!-- x:Name on the three settings-guide anchors; ProfilePage.xaml.cs maps a TourStepId
                     onto each one and measures it. -->
                <Border x:Name="BlocksCardAnchor"
                        StrokeShape="RoundRectangle 20" StrokeThickness="1"
                        Stroke="{DynamicResource Theme_Dust_Ocean}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.2" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static localization:AppResources.HomeBlocksTitle}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.BlockMoodLabel}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            <Switch Grid.Column="1" IsToggled="{Binding Profile.IsMoodBlockVisible}" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.BlockSleepLabel}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            <Switch Grid.Column="1" IsToggled="{Binding Profile.IsSleepBlockVisible}" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.BlockHealthLabel}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            <Switch Grid.Column="1" IsToggled="{Binding Profile.IsHealthBlockVisible}" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.BlockFoodLabel}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            <Switch Grid.Column="1" IsToggled="{Binding Profile.IsFoodBlockVisible}" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.BlockHabitsLabel}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            <Switch Grid.Column="1" IsToggled="{Binding Profile.IsHabitsBlockVisible}" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{DynamicResource Theme_Dust_Ocean}" Opacity="0.5" Margin="0,2" />

                        <!-- The guides, replayable. They belong to this card because they are about
                             the layout it configures, and this is the one way back to an explanation
                             that otherwise happens once and never again. -->
                        <Label behaviors:PressFeedback.IsEnabled="True" Text="{x:Static localization:AppResources.TourReplayLabel}"
                               FontSize="13" TextColor="{DynamicResource Theme_Sage}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ReplayTourCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <!-- Промти й рефлексія (Prompts and reflection).
                     Its own card rather than two more checkboxes in the list above: these two blocks
                     are the only ones that ask the user a question instead of recording an answer,
                     and the library and the answer history hang off them. Buried among the toggles
                     they read as switches for something already understood, which they are not. -->
                <Border x:Name="PromptsCardAnchor"
                        StrokeShape="RoundRectangle 20" StrokeThickness="1"
                        Stroke="{DynamicResource Theme_Dust_Ocean}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.2" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static localization:AppResources.SettingsPromptsTitle}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                        <Label Text="{x:Static localization:AppResources.SettingsPromptsHint}" FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.BlockGuidedPromptLabel}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            <Switch Grid.Column="1" IsToggled="{Binding Profile.IsGuidedPromptBlockVisible}" VerticalOptions="Center" />
                        </Grid>

                        <!-- Full rows with a chevron, like the cycle link above. As indented grey
                             captions these two were read as help text and never tapped, which is the
                             whole reason this card exists. -->
                        <Grid behaviors:PressFeedback.IsEnabled="True" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,10" BackgroundColor="Transparent"
                              IsVisible="{Binding Profile.IsGuidedPromptBlockVisible}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenPromptLibraryCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.PromptLibraryManage}" InputTransparent="True" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" TextColor="{DynamicResource Theme_Coral}" />
                            <Label Grid.Column="1" Text="›" InputTransparent="True" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" TextColor="{DynamicResource Theme_Coral}" />
                        </Grid>

                        <Grid behaviors:PressFeedback.IsEnabled="True" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,10" BackgroundColor="Transparent"
                              IsVisible="{Binding Profile.IsGuidedPromptBlockVisible}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenPromptHistoryCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.PromptHistoryOpen}" InputTransparent="True" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" TextColor="{DynamicResource Theme_Coral}" />
                            <Label Grid.Column="1" Text="›" InputTransparent="True" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" TextColor="{DynamicResource Theme_Coral}" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{DynamicResource Theme_Dust_Ocean}" Opacity="0.5" Margin="0,2" />

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.BlockReflectionLabel}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            <Switch Grid.Column="1" IsToggled="{Binding Profile.IsReflectionBlockVisible}" VerticalOptions="Center" />
                        </Grid>

                        <Label Text="{x:Static localization:AppResources.SettingsReflectionHint}" FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Фінанси (Finances). Out of the blocks card: none of these three decide what shows
                     on the home screen, which is what that card is about. -->
                <Border StrokeShape="RoundRectangle 20" StrokeThickness="1"
                        Stroke="{DynamicResource Theme_Dust_Ocean}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.2" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static localization:AppResources.SettingsFinanceTitle}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.SettingsBudgetsToggle}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            <Switch Grid.Column="1" IsToggled="{Binding Profile.IsBudgetsEnabled}" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.SettingsPlannedToggle}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            <Switch Grid.Column="1" IsToggled="{Binding Profile.IsPlannedTransactionsEnabled}" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.SettingsCurrencyLabel}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            <Picker Grid.Column="1"
                                    ItemsSource="{Binding CurrencyList}"
                                    ItemDisplayBinding="{Binding DisplayName}"
                                    SelectedItem="{Binding SelectedCurrency}"
                                    WidthRequest="130"
                                    TextColor="{DynamicResource Theme_Midnight_Snow}"
                                    TitleColor="{DynamicResource Theme_Ocean_Dust}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Налаштування завдань -->
                <Border StrokeShape="RoundRectangle 20" StrokeThickness="1"
                        Stroke="{DynamicResource Theme_Dust_Ocean}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.2" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static localization:AppResources.TaskSettingsTitle}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.AutoMigrateTasksLabel}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            <Switch Grid.Column="1" IsToggled="{Binding Profile.AutoMigrateUncompletedTasksEnabled}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Нагадування (Reminders) -->
                <Border StrokeShape="RoundRectangle 20" StrokeThickness="1"
                        Stroke="{DynamicResource Theme_Dust_Ocean}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.2" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static localization:AppResources.RemindersTitle}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.DailyReminderLabel}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            <Switch Grid.Column="1" IsToggled="{Binding Profile.IsDailyReminderEnabled}" OnColor="{DynamicResource Theme_Ocean_Ocean}" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" IsVisible="{Binding Profile.IsDailyReminderEnabled}">
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.ReminderTimeLabel}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                            <TimePicker Grid.Column="1" Time="{Binding Profile.DailyReminderTime}" TextColor="{DynamicResource Theme_Midnight_Snow}" BackgroundColor="Transparent" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Серії (Streaks) -->
                <Border StrokeShape="RoundRectangle 20" StrokeThickness="1"
                        Stroke="{DynamicResource Theme_Dust_Ocean}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.2" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static localization:AppResources.StreaksTitle}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.StreakForgivingLabel}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            <Switch Grid.Column="1" IsToggled="{Binding Profile.IsForgivingStreaksEnabled}" OnColor="{DynamicResource Theme_Ocean_Ocean}" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" IsVisible="{Binding Profile.IsForgivingStreaksEnabled}">
                            <Label Grid.Column="0" Text="{x:Static localization:AppResources.StreakGraceDaysLabel}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                            <Entry Grid.Column="1" Text="{Binding Profile.StreakGraceDays}" Keyboard="Numeric" WidthRequest="60" HorizontalTextAlignment="End" TextColor="{DynamicResource Theme_Midnight_Snow}" BackgroundColor="Transparent" />
                        </Grid>

                        <Label Text="{x:Static localization:AppResources.StreakForgivingHint}" FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" IsVisible="{Binding Profile.IsForgivingStreaksEnabled}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============ DATA TAB ============ -->
            <VerticalStackLayout Spacing="20" IsVisible="{Binding IsDataTab}">

                <!-- Підписка (spec 15, R4.4). Its BindingContext is SubscriptionSectionViewModel, set in
                     ProfilePage.xaml.cs; hidden on platforms with no store. First in the tab because it
                     is the one card here that can change what the rest of the app lets you do. -->
                <Border x:Name="SubscriptionCard" x:DataType="viewmodels:SubscriptionSectionViewModel"
                        IsVisible="{Binding IsVisible}"
                        StrokeShape="RoundRectangle 20" StrokeThickness="1"
                        Stroke="{DynamicResource Theme_Dust_Ocean}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.2" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static localization:AppResources.SubscriptionSectionTitle}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                        <Label Text="{Binding StatusText}" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />

                        <Button Style="{StaticResource SecondaryButton}" Text="{x:Static localization:AppResources.SubscriptionManageButton}"
                                Command="{Binding ManageCommand}" IsVisible="{Binding CanManage}" />

                        <Button Style="{StaticResource PrimaryButton}" Text="{x:Static localization:AppResources.PaywallSubscribeButton}"
                                Command="{Binding SubscribeCommand}" IsVisible="{Binding CanSubscribe}" />

                        <Button Style="{StaticResource SecondaryButton}" Text="{x:Static localization:AppResources.SubscriptionSupportButton}"
                                Command="{Binding SubscribeCommand}" IsVisible="{Binding CanSupport}" />

                        <!-- Quiet on purpose: a text button under the main action, for the new phone or
                             the reinstall, not a second call to pay. -->
                        <Button Style="{StaticResource GhostButton}" FontSize="13" Text="{x:Static localization:AppResources.PaywallRestoreButton}"
                                Command="{Binding RestoreCommand}" IsVisible="{Binding CanRestore}" HorizontalOptions="Center" />

                        <Label Text="{Binding RestoreMessage}" IsVisible="{Binding HasRestoreMessage}"
                               FontSize="12" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"
                               TextColor="{DynamicResource Theme_Ocean_Dust}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Безпека (Security) -->
                <Border StrokeShape="RoundRectangle 20" StrokeThickness="1"
                        Stroke="{DynamicResource Theme_Dust_Ocean}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.2" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static localization:AppResources.SecurityLabel}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Coral}" />

                        <!-- No PIN set yet: offer to enable the app lock -->
                        <Button Style="{StaticResource SecondaryButton}" Text="{x:Static localization:AppResources.SetPinButton}"
                                Command="{Binding SetPinCommand}"
                                IsVisible="{Binding IsLockDisabled}" />

                        <!-- PIN set: manage the lock -->
                        <VerticalStackLayout Spacing="10" IsVisible="{Binding IsLockEnabled}">
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                <Button Style="{StaticResource SecondaryButton}" Grid.Column="0" Text="{x:Static localization:AppResources.ChangePinButton}"
                                        Command="{Binding SetPinCommand}" />
                                <Button Style="{StaticResource DangerButton}" Grid.Column="1" Text="{x:Static localization:AppResources.RemovePinButton}"
                                        Command="{Binding RemovePinCommand}" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                <Switch Grid.Column="0" IsToggled="{Binding IsBiometricEnabled}" OnColor="{DynamicResource Theme_Ocean_Ocean}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{x:Static localization:AppResources.EnableBiometricsLabel}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Backup & Restore -->
                <Border StrokeShape="RoundRectangle 20" StrokeThickness="1"
                        Stroke="{DynamicResource Theme_Dust_Ocean}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.2" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static localization:AppResources.BackupTitle}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                        <Label Text="{x:Static localization:AppResources.BackupDescription}" FontSize="13" TextColor="{DynamicResource Theme_Ocean_Dust}" Margin="0,0,0,8" />

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <Button Style="{StaticResource SecondaryButton}" Grid.Column="0" Text="{x:Static localization:AppResources.BackupExportButton}"
                                    Command="{Binding ExportBackupCommand}" />

                            <Button Style="{StaticResource SecondaryButton}" Grid.Column="1" Text="{x:Static localization:AppResources.BackupImportButton}"
                                    Command="{Binding ImportBackupCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Automatic copies (roadmap 0.1). Its BindingContext is ScheduledBackupViewModel, set in
                     ProfilePage.xaml.cs. The same passphrase-protected envelope as "Export" above, written
                     to a folder the user picked once — iCloud Drive, Google Drive, a card — whenever the
                     app opens and the interval has passed. Restoring goes through the ordinary "Restore". -->
                <Border x:Name="AutoBackupCard" x:DataType="viewmodels:ScheduledBackupViewModel"
                        Style="{StaticResource Card}">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.2" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static localization:AppResources.AutoBackupTitle}" Style="{StaticResource SectionHeader}" />

                        <Label Text="{x:Static localization:AppResources.AutoBackupDescription}" FontSize="13" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                        <Label Text="{x:Static localization:AppResources.AutoBackupUnsupported}" IsVisible="{Binding IsUnsupported}"
                               FontSize="13" TextColor="{DynamicResource Theme_Amber}" />

                        <VerticalStackLayout Spacing="12" IsVisible="{Binding IsSupported}">
                            <!-- The settings screen's switch row: label left, switch right. -->
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="{x:Static localization:AppResources.AutoBackupEnableLabel}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                <Switch Grid.Column="1" IsToggled="{Binding IsEnabled}" VerticalOptions="Center" />
                            </Grid>

                            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsEnabled}">
                                <Label Text="{Binding FolderText}" FontSize="13" LineBreakMode="MiddleTruncation"
                                       TextColor="{DynamicResource Theme_Midnight_Snow}" />

                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                    <Label Grid.Column="0" Text="{x:Static localization:AppResources.AutoBackupIntervalLabel}" VerticalOptions="Center" FontSize="14" TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                    <Picker Grid.Column="1" ItemsSource="{Binding Intervals}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedInterval}"
                                            BackgroundColor="Transparent" FontSize="14" HeightRequest="36"
                                            TextColor="{DynamicResource Theme_Midnight_Snow}" />
                                </Grid>

                                <Label Text="{Binding StatusText}" FontSize="12" TextColor="{DynamicResource Theme_Ocean_Dust}" />

                                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                    <Button Style="{StaticResource SecondaryButton}" Grid.Column="0" Text="{x:Static localization:AppResources.AutoBackupRunNow}"
                                            Command="{Binding RunNowCommand}"
                                            IsEnabled="{Binding IsNotBusy}" />

                                    <Button Style="{StaticResource SecondaryButton}" Grid.Column="1" Text="{x:Static localization:AppResources.AutoBackupChangeFolder}"
                                            Command="{Binding ChangeFolderCommand}" />
                                </Grid>

                                <!-- The way back to the phone once copies were sent to a picked folder. -->
                                <Button Style="{StaticResource SecondaryButton}" Text="{x:Static localization:AppResources.AutoBackupUseDevice}"
                                        Command="{Binding UseDeviceFolderCommand}"
                                        IsVisible="{Binding CanUseDeviceFolder}" />

                                <Label Text="{x:Static localization:AppResources.AutoBackupKeepHint}" FontSize="11" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Crash report. Hidden entirely until something has actually crashed. -->
                <Border StrokeShape="RoundRectangle 20" StrokeThickness="1"
                        Stroke="{DynamicResource Theme_Coral}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        Padding="16"
                        IsVisible="{Binding HasCrashReport}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static localization:AppResources.CrashReportTitle}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Coral}" />
                        <Label Text="{x:Static localization:AppResources.CrashReportDescription}" FontSize="13" TextColor="{DynamicResource Theme_Ocean_Dust}" Margin="0,0,0,4" />

                        <!-- The report itself, on screen. Whoever is holding the phone can read the
                             exception without a Mac, a cable or a second tool. -->
                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                BackgroundColor="{DynamicResource Theme_Dust_Midnight}"
                                Padding="10">
                            <ScrollView Orientation="Both" MaximumHeightRequest="220">
                                <Label Text="{Binding CrashReportText}"
                                       FontSize="11"
                                       FontFamily="Consolas"
                                       LineBreakMode="NoWrap"
                                       TextColor="{DynamicResource Theme_Midnight_Snow}" />
                            </ScrollView>
                        </Border>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <Button Style="{StaticResource SecondaryButton}" Grid.Column="0" Text="{x:Static localization:AppResources.CrashReportShareButton}"
                                    Command="{Binding ShareCrashReportCommand}" />

                            <Button Style="{StaticResource DangerButton}" Grid.Column="1" Text="{x:Static localization:AppResources.CrashReportClearButton}"
                                    Command="{Binding ClearCrashReportCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Export data (open, portable formats) -->
                <Border StrokeShape="RoundRectangle 20" StrokeThickness="1"
                        Stroke="{DynamicResource Theme_Dust_Ocean}"
                        BackgroundColor="{DynamicResource Theme_Snow_Black}"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Theme_Shadow}" Offset="0,6" Radius="12" Opacity="0.2" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="{x:Static localization:AppResources.ExportDataTitle}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.5" TextColor="{DynamicResource Theme_Ocean_Dust}" />
                        <Label Text="{x:Static localization:AppResources.ExportDataDescription}" FontSize="13" TextColor="{DynamicResource Theme_Ocean_Dust}" Margin="0,0,0,8" />

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <Button Style="{StaticResource SecondaryButton}" Grid.Column="0" Text="{x:Static localization:AppResources.ExportJsonButton}"
                                    Command="{Binding ExportDataCommand}" CommandParameter="json" />
                            <Button Style="{StaticResource SecondaryButton}" Grid.Column="1" Text="{x:Static localization:AppResources.ExportCsvButton}"
                                    Command="{Binding ExportDataCommand}" CommandParameter="csv" />
                            <Button Style="{StaticResource SecondaryButton}" Grid.Column="2" Text="{x:Static localization:AppResources.ExportMarkdownButton}"
                                    Command="{Binding ExportDataCommand}" CommandParameter="markdown" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Delete All Data Button -->
                <Button Style="{StaticResource DangerButton}" Text="{x:Static localization:AppResources.ClearAllDataButton}"
                        Command="{Binding ClearAllDataCommand}"
                        Margin="0,0,0,4" />
            </VerticalStackLayout>

            <!-- Save Button (applies to all tabs) -->
            <Button Style="{StaticResource PrimaryButton}" x:Name="SaveAnchor"
                    Text="{x:Static localization:AppResources.SaveProfileButton}"
                    Command="{Binding SaveProfileCommand}"
                    Margin="0,10,0,10" />
        </VerticalStackLayout>
    </ScrollView>

        <!-- Гід по налаштуваннях (онбординг, етап 3). Last child, so it covers the scroller. -->
        <controls:TourOverlayView x:Name="TourOverlay" />
    </Grid>
</ContentPage>
