<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the tasks widget: priority dot, title, time. Generated shape, one file per row id. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/widget_row_dot_1"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/widget_dot_amber"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/widget_row_title_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="13sp"
        android:textColor="@color/widget_text"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_row_time_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textSize="12sp"
        android:textColor="@color/widget_text_secondary"
        android:singleLine="true" />
</LinearLayout>
