<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- allowBackup=false: keep the local diary off Google cloud / adb backup (privacy-first, no cloud). -->
	<application android:allowBackup="false" android:fullBackupContent="false" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true"></application>
	<!-- INTERNET is declared but nothing uses it today. It came in on 2026-08-02 to download on-device AI
	     models; that AI was removed on 2026-10-21, and the permission stays only because the owner plans a
	     cloud AI in a later version (spec 14). No user data is uploaded, there is no sync, telemetry or
	     account. ACCESS_NETWORK_STATE and the two FOREGROUND_SERVICE names went with the model downloads
	     they existed for.
	     This list is an allowlist enforced by the android-permissions CI job: a dependency can inject
	     permissions through manifest merging without showing up in a diff, so anything beyond these
	     six fails the build. -->
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
	<uses-permission android:name="android.permission.VIBRATE" />
	<uses-permission android:name="android.permission.USE_BIOMETRIC" />
	<uses-permission android:name="android.permission.USE_FINGERPRINT" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!-- No exact-alarm permissions. USE_EXACT_ALARM is restricted by Play to alarm clocks and
	     calendars; SCHEDULE_EXACT_ALARM is no longer auto-granted from Android 14 and would degrade
	     silently. Reminders schedule as InexactAllowWhileIdle instead — see LocalNotificationService. -->
</manifest>
