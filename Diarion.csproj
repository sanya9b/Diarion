<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<NoWarn>$(NoWarn);NU1608</NoWarn>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>Diarion</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsTestProject>false</IsTestProject>
		<SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Diarion</ApplicationTitle>

		<!-- App Identifier. Reverse DNS of diarion.org, the domain the owner holds; `.app` rather
		     than `.diarion` so that org.diarion.* stays free for a widget or a share extension,
		     which have to be siblings of this id and cannot be children of it.

		     Permanent from the first upload onwards: Apple refuses to change it once a build has
		     been submitted, and Play burns the id forever, even for an app that was later deleted.
		     Changing it after release is a different app — no update for existing users, ratings
		     from zero, and any lifetime licences left behind. So this line is not a line to tidy. -->
		<ApplicationId>org.diarion.app</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<!-- Android 8.0. The template's 21.0 sat two lines above this one and was simply overwritten,
		     so nothing built against it ever — but a reader checking what the app supports found the
		     dead value first, and AndroidManifest.xml declares no uses-sdk to correct them with. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<!--
		  Every configuration, not just Release. Both entitlements this file has carried so far were
		  ones a debug device needed as much as a signed build — the increased memory limit and the
		  HealthKit key — and learning that only in Release is the expensive order to learn it in.
		  The file is empty of live keys for v1 and stays wired up regardless: it is where the two
		  removals are written down, and where the next capability lands without touching csproj.
		-->
		<CodesignEntitlements>Platforms\iOS\Entitlements.plist</CodesignEntitlements>

		<!--
		  HealthKit is compiled out of v1. Removing NSHealthShareUsageDescription is not enough on
		  its own: Apple scans the binary for API references, so a build that still links HKHealthStore
		  with no purpose string is rejected at upload with ITMS-90683 rather than at review. So the
		  iOS branches of HealthDataService are gated on this symbol, which nothing defines.

		  Turning Health back on is three things in one commit, and each is useless without the
		  others — uncomment this, restore the entitlement and the usage string (both written out in
		  Entitlements.plist and Info.plist), and enable the HealthKit capability on the App ID in
		  the Developer Portal, or signing fails. The metadata job in ci.yml enforces the first three
		  against each other in both directions; the fourth is outside the repo and nothing can.
		  <DefineConstants>$(DefineConstants);HEALTHKIT</DefineConstants>
		-->
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(Configuration)' == 'Release'">
		<!--
		  Step one of walking back the workaround added in May, which set MtouchLink=None and
		  UseInterpreter=true against a crash nobody wrote down. Both cost real IPA size and startup
		  time, so they should not stay on faith.

		  SdkOnly links the framework and leaves Diarion, Diarion.Core and LiteDB untouched. That
		  keeps the likeliest culprit out of range: LiteDB maps documents by reflecting over model
		  properties, and a trimmed setter fails at runtime, not at build. If this build is stable,
		  the next step is UseInterpreter=false on its own — and if THAT is what breaks, the cause is
		  Expression.Compile under full AOT, which means the interpreter stays for good and gets a
		  comment saying so instead of a question mark.

		  A managed crash now writes a report the settings screen can show and share, so a failure
		  here comes back as a stack trace rather than as "it closed".
		-->
		<MtouchLink>SdkOnly</MtouchLink>
		<UseInterpreter>true</UseInterpreter>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#22282C" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#22282C" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="14.1.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="LiteDB" Version="5.0.21" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.60" />
		<!-- Native ONNX Runtime. Its Android AAR manifest is 196 bytes and declares no permissions;
		     verify that stays true after any bump — the android-permissions CI job is the check. -->
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Plugin.Fingerprint" Version="3.0.0-beta.1" />
		<PackageReference Include="Plugin.LocalNotification" Version="14.1.1" />
		<PackageReference Include="System.Resources.Extensions" Version="10.0.8" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="Diarion.Core\Diarion.Core.csproj" />
	</ItemGroup>

	<!-- Виключаємо файли з вкладених папок підпроєктів, щоб не було дублювання класів -->
	<ItemGroup>
	  <Compile Remove="Diarion.Core\**" />
	  <EmbeddedResource Remove="Diarion.Core\**" />
	  <MauiXaml Remove="Diarion.Core\**" />
	  <None Remove="Diarion.Core\**" />
	  
	  <Compile Remove="Diarion.Tests\**" />
	  <EmbeddedResource Remove="Diarion.Tests\**" />
	  <MauiXaml Remove="Diarion.Tests\**" />
	  <None Remove="Diarion.Tests\**" />
	</ItemGroup>

	<!--
	  Apple rejected the first upload (2026-09-20) with five errors, all about one file:
	  Frameworks/onnxruntime-genai.framework/Info.plist as shipped in OnnxRuntimeGenAI 0.14.1 has
	  CFBundleVersion and CFBundleShortVersionString set to "1.25.0-dev-<date>-<sha>" (must be up to
	  three integers, at most 18 characters — ITMS-90058/90059/90060) and no MinimumOSVersion at all
	  (ITMS-90360/90530). The build itself never complains; only App Store Connect does, after the
	  macOS minutes are spent. The pin on 0.14.1 is deliberate (see Diarion.Core.csproj), so instead
	  of bumping the package this rewrites the three keys in the copy inside the app bundle.
	  _CreateAppBundle is the SDK target that has just copied the framework in; Codesign runs after
	  it, so the signature covers the corrected plist. macOS only: plutil lives there, and so does
	  every iOS build. The versions written are the package's own, not onnxruntime's.
	-->
	<Target Name="FixOnnxGenAiFrameworkPlist"
	        AfterTargets="_CreateAppBundle"
	        Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and $([MSBuild]::IsOSPlatform('osx'))">
		<PropertyGroup>
			<_GenAiFrameworkPlist>$(AppBundleDir)/Frameworks/onnxruntime-genai.framework/Info.plist</_GenAiFrameworkPlist>
		</PropertyGroup>
		<Exec Condition="Exists('$(_GenAiFrameworkPlist)')"
		      Command="plutil -replace CFBundleShortVersionString -string 0.14.1 &quot;$(_GenAiFrameworkPlist)&quot; &amp;&amp; plutil -replace CFBundleVersion -string 0.14.1 &quot;$(_GenAiFrameworkPlist)&quot; &amp;&amp; plutil -replace MinimumOSVersion -string $(SupportedOSPlatformVersion) &quot;$(_GenAiFrameworkPlist)&quot;" />
		<Message Importance="high" Condition="Exists('$(_GenAiFrameworkPlist)')" Text="onnxruntime-genai.framework/Info.plist: versions and MinimumOSVersion rewritten for App Store validation." />
		<Warning Condition="!Exists('$(_GenAiFrameworkPlist)')" Text="onnxruntime-genai.framework not found in the app bundle; the Info.plist fix did nothing. If the package was removed, delete the FixOnnxGenAiFrameworkPlist target." />
	</Target>

</Project>
