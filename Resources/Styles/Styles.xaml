    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{DynamicResource Theme_White_Black}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource Theme_White_Black}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource Theme_Black_White}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource Theme_Black_White}" />
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource Theme_Gray200_Gray950}" />
        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource Theme_Gray200_Gray200}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{DynamicResource Theme_White_Black}" />
        <Setter Property="BarTextColor" Value="{DynamicResource Theme_Gray200_White}" />
        <Setter Property="IconColor" Value="{DynamicResource Theme_Gray200_White}" />
    </Style>

    <!-- Surface tokens. Three radii carry the whole app: 20 for a card, 12 for a field inside one, and a
         full pill for chips. Sixteen different radii had grown up screen by screen, and a card with 16
         next to one with 24 reads as two different products. A Shadow is never set here: one Shadow
         instance shared by every card is a known MAUI pitfall, so cards that want one set it inline. -->
    <Style TargetType="Border" x:Key="Card">
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{DynamicResource Theme_Dust_Ocean}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Snow_Black}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- A text or time field inside a card. Padding and height stay with each field. -->
    <Style TargetType="Border" x:Key="Field">
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{DynamicResource Theme_Dust_Ocean}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- The caption at the top of a card. One voice for every block on the day screen: there were three
         (Coral, ink and grey), which made the order of the blocks look like an order of importance. -->
    <Style TargetType="Label" x:Key="SectionHeader">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.5" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{DynamicResource Theme_Ocean_Dust}" />
    </Style>

    <!-- The statistics card is the card. -->
    <Style TargetType="Border" x:Key="StatCard" BasedOn="{StaticResource Card}" />

    <!-- Circular PIN keypad button, shared by LockPage (unlock) and PinSetupPage (set/change).
         Padding=0 + Center options keep the frame a true 72x72 square so CornerRadius renders as a
         perfect circle (without them the button can stretch wider than tall and look like a pill). -->
    <Style x:Key="PinKey" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Theme_Snow_Black}" />
        <Setter Property="TextColor" Value="{DynamicResource Theme_Midnight_Snow}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="36" />
        <Setter Property="HeightRequest" Value="72" />
        <Setter Property="WidthRequest" Value="72" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="BorderColor" Value="{DynamicResource Theme_Dust_Ocean}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

</ResourceDictionary>
